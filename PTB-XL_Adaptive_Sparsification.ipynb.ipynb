   "source": [
    "import os\n",
    "\n",
    "dense_model = ECGBackbone(\n",
    "    num_classes=cfg.task.num_classes,\n",
    "    in_leads=cfg.task.num_leads,\n",
    "    stem_channels=cfg.model.stem_channels,\n",
    "    block_channels=cfg.model.block_channels,\n",
    "    block_depth=cfg.model.block_depth,\n",
    "    se_reduction=cfg.model.se_reduction,\n",
    "    dropout=cfg.model.dropout,\n",
    ").to(device)\n",
    "\n",
    "layer_specs = get_layer_specs(cfg)\n",
    "real_dense_macs = count_real_conv1d_macs(\n",
    "    dense_model,\n",
    "    input_shape=(1, cfg.task.num_leads, cfg.task.signal_length),\n",
    "    device=device,\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Dense model: {count_params(dense_model)['total_params']:,} params, \"\n",
    "    f\"{real_dense_macs/1e6:.2f}M real Conv1d MACs\"\n",
    ")\n",
    "\n",
    "loss_fn = build_loss(\n",
    "    cfg.loss,\n",
    "    class_counts,\n",
    "    len(train_ds),\n",
    ").to(device)\n",
    "\n",
    "optimizer = torch.optim.AdamW(\n",
    "    dense_model.parameters(),\n",
    "    lr=cfg.optimizer.lr,\n",
    "    weight_decay=cfg.optimizer.weight_decay,\n",
    ")\n",
    "scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "    optimizer,\n",
    "    mode=\"min\",\n",
    "    factor=cfg.scheduler.factor,\n",
    "    patience=cfg.scheduler.patience,\n",
    ")\n",
    "\n",
    "best_ckpt = os.path.join(\n",
    "    cfg.paths.weights_dir,\n",
    "    \"dense_baseline_best.pt\",\n",
    ")\n",
    "\n",
    "if os.path.exists(best_ckpt):\n",
    "    epoch, best_metric = load_checkpoint(\n",
    "        best_ckpt,\n",
    "        dense_model,\n",
    "        optimizer,\n",
    "        scheduler,\n",
    "    )\n",
    "    print(\n",
    "        f\"Reusing existing dense checkpoint: epoch={epoch}, \"\n",
    "        f\"best_metric={best_metric:.4f}\"\n",
    "    )\n",
    "else:\n",
    "    print(\"No dense checkpoint found. Training dense baseline...\")\n",
    "\n",
    "    dense_trainer = Trainer(\n",
    "        dense_model,\n",
    "        optimizer,\n",
    "        scheduler,\n",
    "        loss_fn,\n",
    "        device,\n",
    "        cfg.task.superclasses,\n",
    "        run_name=\"dense_baseline\",\n",
    "        results_dir=cfg.paths.results_dir,\n",
    "        weights_dir=cfg.paths.weights_dir,\n",
    "        mixed_precision=cfg.training.mixed_precision,\n",
    "        energy_aware=False,\n",
    "    )\n",
    "\n",
    "    dense_trainer.fit(\n",
    "        train_loader,\n",
    "        val_loader,\n",
    "        cfg.training.epochs,\n",
    "        cfg.training.early_stopping_patience,\n",
    "        cfg.training.early_stopping_metric,\n",
    "    )\n",
    "\n",
    "    # The trainer restores its best checkpoint before returning.\n"
   ]
