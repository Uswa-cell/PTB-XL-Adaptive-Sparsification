   "source": [
    "# ---- from src/experiments/compare_models.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/experiments/compare_models.py\n",
    "---------------------------------------\n",
    "Produces the core empirical deliverables of the thesis:\n",
    "\n",
    "  - RQ1/RQ2 : three-way comparison table (dense / static-pruned / adaptive)\n",
    "              across accuracy, macro-F1, sensitivity, FLOPs, and estimated\n",
    "              energy, with statistical significance testing across seeds.\n",
    "  - RQ1     : energy-by-difficulty-bucket analysis (Sec. IX-C of the review)\n",
    "              -- splits the test set into easy/medium/hard difficulty\n",
    "              tertiles and reports the adaptive model's estimated energy\n",
    "              and accuracy per bucket, the key evidence that energy scales\n",
    "              with input difficulty rather than being fixed.\n",
    "  - RQ5     : rare-class robustness -- per-class sensitivity for the two\n",
    "              rarest superclasses (CD, HYP) compared across dense /\n",
    "              static-pruned-90% / adaptive, directly extending Hooker et\n",
    "              al. [33]'s finding into the adaptive regime.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import os\n",
    "import csv\n",
    "import numpy as np\n",
    "import torch\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def _collect_predictions(model, loader, device, is_adaptive=False):\n",
    "    model.eval()\n",
    "    all_prob, all_true, all_diff = [], [], []\n",
    "    for signals, labels in loader:\n",
    "        signals = signals.to(device, non_blocking=True)  # INFRASTRUCTURE CHANGE: non_blocking transfer\n",
    "        if is_adaptive:\n",
    "            # Deployment-consistent evaluation: true hard per-sample routing.\n",
    "            out = model(signals, hard=True)\n",
    "            prob = torch.sigmoid(out[\"logits\"]).cpu().numpy()\n",
    "            all_diff.append(out[\"difficulty\"].cpu().numpy())\n",
    "        else:\n",
    "            logits = model(signals)\n",
    "            prob = torch.sigmoid(logits).cpu().numpy()\n",
    "        all_prob.append(prob)\n",
    "        all_true.append(labels.numpy())\n",
    "    y_prob = np.concatenate(all_prob, axis=0)\n",
    "    y_true = np.concatenate(all_true, axis=0)\n",
    "    difficulty = np.concatenate(all_diff, axis=0) if all_diff else None\n",
    "    return y_true, y_prob, difficulty\n",
    "\n",
    "\n",
    "def three_way_comparison(models: dict, test_loader, device, class_names, results_dir) -> pd.DataFrame:\n",
    "    \"\"\"models: {\"Dense\": model, \"Static-60%\": model, \"Adaptive\": model, ...}\n",
    "    Each entry: (model_object, is_adaptive: bool, flops_pct: float, energy_pct: float).\"\"\"\n",
    "    rows = []\n",
    "    for name, (model, is_adaptive, flops_pct, energy_pct) in models.items():\n",
    "        y_true, y_prob, _ = _collect_predictions(model, test_loader, device, is_adaptive)\n",
    "        metrics = compute_full_metric_suite(y_true, y_prob, class_names)[\"summary\"]\n",
    "        rows.append({\n",
    "            \"Model\": name,\n",
    "            \"Accuracy (subset)\": metrics[\"subset_accuracy\"],\n",
    "            \"Macro-F1\": metrics[\"f1_macro\"],\n",
    "            \"Macro-AUROC\": metrics.get(\"auroc_macro\", float(\"nan\")),\n",
    "            \"Macro-Sensitivity\": metrics[\"sensitivity_macro\"],\n",
    "            \"Macro-Specificity\": metrics[\"specificity_macro\"],\n",
    "            \"FLOPs (% of dense)\": flops_pct,\n",
    "            \"Energy (% of dense, estimated)\": energy_pct,\n",
    "        })\n",
    "    df = pd.DataFrame(rows)\n",
    "    df.to_csv(os.path.join(results_dir, \"three_way_comparison.csv\"), index=False)\n",
    "    return df\n",
    "\n",
    "\n",
    "def energy_by_difficulty_bucket(adaptive_model, test_loader, device, energy_per_level, results_dir):\n",
    "    y_true, y_prob, difficulty = _collect_predictions(adaptive_model, test_loader, device, is_adaptive=True)\n",
    "\n",
    "    tertiles = np.quantile(difficulty, [1/3, 2/3])\n",
    "    bucket = np.digitize(difficulty, tertiles)  # 0=easy, 1=medium, 2=hard\n",
    "    bucket_names = [\"Easy\", \"Medium\", \"Hard\"]\n",
    "\n",
    "    # re-run forward pass to get gate_probs per sample for energy estimate\n",
    "    adaptive_model.eval()\n",
    "    all_gate_probs = []\n",
    "    with torch.no_grad():\n",
    "        for signals, _ in test_loader:\n",
    "            out = adaptive_model(signals.to(device), hard=True)\n",
    "            all_gate_probs.append(out[\"gate_probs\"].cpu())\n",
    "    gate_probs = torch.cat(all_gate_probs, dim=0)\n",
    "    expected_energy = (gate_probs @ energy_per_level).numpy()\n",
    "\n",
    "    rows = []\n",
    "    for b, name in enumerate(bucket_names):\n",
    "        mask = bucket == b\n",
    "        if mask.sum() == 0:\n",
    "            continue\n",
    "        pred = (y_prob[mask] > 0.5).astype(int)\n",
    "        acc = (pred == y_true[mask]).mean()\n",
    "        rows.append({\n",
    "            \"Difficulty Bucket\": name,\n",
    "            \"N Samples\": int(mask.sum()),\n",
    "            \"Mean Estimated Energy (nJ)\": float(expected_energy[mask].mean()),\n",
    "            \"Element-wise Accuracy\": float(acc),\n",
    "        })\n",
    "    df = pd.DataFrame(rows)\n",
    "    df.to_csv(os.path.join(results_dir, \"energy_by_difficulty_bucket.csv\"), index=False)\n",
    "    return df\n",
    "\n",
    "\n",
    "def rare_class_robustness(models: dict, test_loader, device, class_names, rare_classes, results_dir):\n",
    "    \"\"\"models: {\"Dense\": (model, is_adaptive), \"Static-90%\": (...), \"Adaptive\": (...)}.\"\"\"\n",
    "    rows = []\n",
    "    for name, (model, is_adaptive) in models.items():\n",
    "        y_true, y_prob, _ = _collect_predictions(model, test_loader, device, is_adaptive)\n",
    "        metrics = compute_full_metric_suite(y_true, y_prob, class_names)[\"per_class\"]\n",
    "        row = {\"Model\": name}\n",
    "        for c in rare_classes:\n",
    "            row[f\"{c} Sensitivity\"] = metrics[c][\"recall_sensitivity\"]\n",
    "            row[f\"{c} AUROC\"] = metrics[c][\"auroc\"]\n",
    "        rows.append(row)\n",
    "    df = pd.DataFrame(rows)\n",
    "    df.to_csv(os.path.join(results_dir, \"rare_class_robustness_RQ5.csv\"), index=False)\n",
    "    return df\n",
    "\n",
    "\n",
    "def multiseed_significance_report(metric_name: str, scores_by_model: dict[str, np.ndarray],\n",
    "                                   reference_model: str, results_dir: str) -> pd.DataFrame:\n",
    "    \"\"\"scores_by_model: {\"Dense\": array_of_per_seed_scores, \"Adaptive\": ...}.\n",
    "    Compares every other model against `reference_model` (e.g. \"Dense\").\"\"\"\n",
    "    rows = []\n",
    "    ref_scores = scores_by_model[reference_model]\n",
    "    for name, scores in scores_by_model.items():\n",
    "        if name == reference_model:\n",
    "            continue\n",
    "        cmp = compare_models(ref_scores, scores, reference_model, name)\n",
    "        rows.append({\n",
    "            \"Comparison\": cmp[\"comparison\"], f\"Mean {metric_name} ({reference_model})\": cmp[\"mean_a\"],\n",
    "            f\"Mean {metric_name} (Other)\": cmp[\"mean_b\"], \"p-value (paired t-test)\": cmp[\"paired_ttest\"][\"p_value\"],\n",
    "            \"p-value (Wilcoxon)\": cmp[\"wilcoxon\"][\"p_value\"], \"Cohen's d\": cmp[\"cohens_d\"],\n",
    "            \"Significant (alpha=0.05)\": cmp[\"significant_at_alpha\"],\n",
    "        })\n",
    "    df = pd.DataFrame(rows)\n",
    "    df.to_csv(os.path.join(results_dir, f\"significance_{metric_name}.csv\"), index=False)\n",
    "    return df\n"
   ]
  },
