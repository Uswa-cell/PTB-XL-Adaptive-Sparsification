   "source": [
    "# ============================================================\n",
    "# FINAL PAIRED FIVE-SEED EXPERIMENT\n",
    "#\n",
    "# For every seed:\n",
    "#   Dense_i -> Static-60_i\n",
    "#           -> Adaptive_i\n",
    "#\n",
    "# Static and adaptive models are therefore paired to the SAME independently\n",
    "# trained dense model for each seed.\n",
    "# ============================================================\n",
    "\n",
    "import gc\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "\n",
    "FINAL_SEEDS = [42, 123, 456, 789, 2026]\n",
    "\n",
    "\n",
    "def build_fresh_dense_model():\n",
    "    return ECGBackbone(\n",
    "        num_classes=cfg.task.num_classes,\n",
    "        in_leads=cfg.task.num_leads,\n",
    "        stem_channels=cfg.model.stem_channels,\n",
    "        block_channels=cfg.model.block_channels,\n",
    "        block_depth=cfg.model.block_depth,\n",
    "        se_reduction=cfg.model.se_reduction,\n",
    "        dropout=cfg.model.dropout,\n",
    "    ).to(device)\n",
    "\n",
    "\n",
    "def train_dense_for_seed(seed):\n",
    "    seed = int(seed)\n",
    "    set_seed(seed)\n",
    "    model = build_fresh_dense_model()\n",
    "\n",
    "    optimizer = torch.optim.AdamW(\n",
    "        model.parameters(),\n",
    "        lr=cfg.optimizer.lr,\n",
    "        weight_decay=cfg.optimizer.weight_decay,\n",
    "    )\n",
    "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "        optimizer,\n",
    "        mode=\"min\",\n",
    "        factor=cfg.scheduler.factor,\n",
    "        patience=cfg.scheduler.patience,\n",
    "    )\n",
    "    loss_fn_seed = build_loss(\n",
    "        cfg.loss,\n",
    "        class_counts,\n",
    "        len(train_loader.dataset),\n",
    "    ).to(device)\n",
    "\n",
    "    run_name = f\"FINAL_dense_seed{seed}\"\n",
    "    trainer = Trainer(\n",
    "        model,\n",
    "        optimizer,\n",
    "        scheduler,\n",
    "        loss_fn_seed,\n",
    "        device,\n",
    "        cfg.task.superclasses,\n",
    "        run_name=run_name,\n",
    "        results_dir=cfg.paths.results_dir,\n",
    "        weights_dir=cfg.paths.weights_dir,\n",
    "        mixed_precision=cfg.training.mixed_precision,\n",
    "        energy_aware=False,\n",
    "    )\n",
    "\n",
    "    # Intentionally no checkpoint reuse in the final paired experiment.\n",
    "    trainer.fit(\n",
    "        train_loader,\n",
    "        val_loader,\n",
    "        cfg.training.epochs,\n",
    "        cfg.training.early_stopping_patience,\n",
    "    )\n",
    "\n",
    "    best_path = os.path.join(cfg.paths.weights_dir, f\"{run_name}_best.pt\")\n",
    "    if os.path.exists(best_path):\n",
    "        load_checkpoint(best_path, model, optimizer, scheduler)\n",
    "\n",
    "    test_metrics = trainer.evaluate(test_loader, split=\"test\")\n",
    "    return model, test_metrics\n",
    "\n",
    "\n",
    "def run_final_seed(seed):\n",
    "    seed = int(seed)\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(f\"FINAL EXPERIMENT SEED {seed}\")\n",
    "    print(\"=\" * 80)\n",
    "    set_seed(seed)\n",
    "\n",
    "    # 1) Independent dense model for this seed.\n",
    "    dense_seed_model, dense_metrics = train_dense_for_seed(seed)\n",
    "    dense_f1 = float(dense_metrics[\"summary\"][\"f1_macro\"])\n",
    "    dense_auroc = float(dense_metrics[\"summary\"].get(\"auroc_macro\", np.nan))\n",
    "\n",
    "    # 2) Static 60% model from the same dense model.\n",
    "    static_seed_results = run_static_pruning(\n",
    "        dense_model=dense_seed_model,\n",
    "        train_loader=train_loader,\n",
    "        val_loader=val_loader,\n",
    "        test_loader=test_loader,\n",
    "        class_counts=class_counts,\n",
    "        cfg=cfg,\n",
    "        seed=seed,\n",
    "        reuse_checkpoint=False,\n",
    "        sparsity_levels=[0.60],\n",
    "    )\n",
    "    static_key = min(static_seed_results, key=lambda x: abs(float(x) - 0.60))\n",
    "    static_result = static_seed_results[static_key]\n",
    "    static_f1 = float(static_result[\"test_metrics\"][\"f1_macro\"])\n",
    "    static_auroc = float(static_result[\"test_metrics\"].get(\"auroc_macro\", np.nan))\n",
    "    static_macs_pct = float(static_result[\"flops_pct_of_dense\"])\n",
    "\n",
    "    # Free the static model before constructing four adaptive experts.\n",
    "    static_model_tmp = static_result.pop(\"model\", None)\n",
    "    del static_model_tmp\n",
    "    gc.collect()\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "\n",
    "    # 3) Adaptive model from the same dense model.\n",
    "    adaptive_seed_result = run_adaptive(\n",
    "        dense_model=dense_seed_model,\n",
    "        train_loader=train_loader,\n",
    "        val_loader=val_loader,\n",
    "        test_loader=test_loader,\n",
    "        class_counts=class_counts,\n",
    "        cfg=cfg,\n",
    "        seed=seed,\n",
    "        use_heuristic_gate=False,\n",
    "        reuse_checkpoint=False,\n",
    "    )\n",
    "    adaptive_f1 = float(\n",
    "        adaptive_seed_result[\"test_metrics\"][\"summary\"][\"f1_macro\"]\n",
    "    )\n",
    "    adaptive_auroc = float(\n",
    "        adaptive_seed_result[\"test_metrics\"][\"summary\"].get(\"auroc_macro\", np.nan)\n",
    "    )\n",
    "\n",
    "    # 4) Actual hard-routing deployment cost on the full test set.\n",
    "    adaptive_seed_model = adaptive_seed_result[\"model\"].to(device)\n",
    "    adaptive_seed_model.eval()\n",
    "    selected = []\n",
    "    with torch.no_grad():\n",
    "        for signals, _ in test_loader:\n",
    "            output = adaptive_seed_model(\n",
    "                signals.to(device, non_blocking=True),\n",
    "                hard=True,\n",
    "            )\n",
    "            selected.append(output[\"selected_expert\"].detach().cpu())\n",
    "\n",
    "    selected = torch.cat(selected).numpy().astype(int)\n",
    "    macs_per_level = np.asarray(adaptive_seed_result[\"expert_macs\"], dtype=np.float64)\n",
    "    energy_per_level = adaptive_seed_result[\"energy_per_level\"].numpy().astype(np.float64)\n",
    "\n",
    "    actual_sample_macs = macs_per_level[selected]\n",
    "    actual_sample_energy = energy_per_level[selected]\n",
    "    adaptive_macs_pct = (\n",
    "        100.0\n",
    "        * actual_sample_macs.mean()\n",
    "        / max(float(adaptive_seed_result[\"dense_macs\"]), 1.0)\n",
    "    )\n",
    "    adaptive_energy_pct = (\n",
    "        100.0\n",
    "        * actual_sample_energy.mean()\n",
    "        / max(float(adaptive_seed_result[\"dense_energy\"]), 1e-12)\n",
    "    )\n",
    "\n",
    "    unique, counts = np.unique(selected, return_counts=True)\n",
    "    route_fraction = np.zeros(len(adaptive_seed_result[\"sparsity_levels\"]), dtype=float)\n",
    "    route_fraction[unique] = counts / max(len(selected), 1)\n",
    "\n",
    "    result = {\n",
    "        \"seed\": seed,\n",
    "        \"Dense Macro-F1\": dense_f1,\n",
    "        \"Dense AUROC\": dense_auroc,\n",
    "        \"Static-60 Macro-F1\": static_f1,\n",
    "        \"Static-60 AUROC\": static_auroc,\n",
    "        \"Static-60 MACs %\": static_macs_pct,\n",
    "        \"Adaptive Macro-F1\": adaptive_f1,\n",
    "        \"Adaptive AUROC\": adaptive_auroc,\n",
    "        \"Adaptive MACs %\": float(adaptive_macs_pct),\n",
    "        \"Adaptive Energy %\": float(adaptive_energy_pct),\n",
    "    }\n",
    "\n",
    "    for idx, fraction in enumerate(route_fraction):\n",
    "        sparsity = adaptive_seed_result[\"sparsity_levels\"][idx]\n",
    "        result[f\"Route {int(round(sparsity * 100))}%\"] = float(fraction * 100.0)\n",
    "\n",
    "    print(f\"Dense F1      : {dense_f1:.4f}\")\n",
    "    print(f\"Static-60 F1  : {static_f1:.4f}\")\n",
    "    print(f\"Adaptive F1   : {adaptive_f1:.4f}\")\n",
    "    print(f\"Adaptive MACs : {adaptive_macs_pct:.2f}% of dense\")\n",
    "\n",
    "    # Return only scalars, then aggressively free per-seed models.\n",
    "    del adaptive_seed_model\n",
    "    del adaptive_seed_result\n",
    "    del static_seed_results\n",
    "    del dense_seed_model\n",
    "    gc.collect()\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "# Free exploratory GPU model copies before the expensive five-seed study.\n",
    "# They remain available on CPU and can be moved back for later latency/ablation cells.\n",
    "for _model in [dense_model, adaptive_result[\"model\"], heuristic_result[\"model\"]]:\n",
    "    _model.to(\"cpu\")\n",
    "for _static_entry in static_results.values():\n",
    "    if \"model\" in _static_entry:\n",
    "        _static_entry[\"model\"].to(\"cpu\")\n",
    "gc.collect()\n",
    "if torch.cuda.is_available():\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "final_seed_results = [run_final_seed(seed) for seed in FINAL_SEEDS]\n",
    "final_multiseed_df = pd.DataFrame(final_seed_results)\n",
    "display(final_multiseed_df)\n",
    "\n",
    "final_multiseed_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"FINAL_paired_multiseed_results.csv\"),\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "headline_metrics = [\n",
    "    \"Dense Macro-F1\",\n",
    "    \"Static-60 Macro-F1\",\n",
    "    \"Adaptive Macro-F1\",\n",
    "    \"Dense AUROC\",\n",
    "    \"Static-60 AUROC\",\n",
    "    \"Adaptive AUROC\",\n",
    "    \"Static-60 MACs %\",\n",
    "    \"Adaptive MACs %\",\n",
    "    \"Adaptive Energy %\",\n",
    "]\n",
    "\n",
    "summary_rows = []\n",
    "for metric in headline_metrics:\n",
    "    values = final_multiseed_df[metric].to_numpy(dtype=float)\n",
    "    ci = bootstrap_ci(\n",
    "        values,\n",
    "        n_boot=cfg.statistics.bootstrap_n,\n",
    "        alpha=cfg.statistics.alpha,\n",
    "        seed=42,\n",
    "    )\n",
    "    summary_rows.append({\n",
    "        \"Metric\": metric,\n",
    "        \"Mean\": float(values.mean()),\n",
    "        \"SD\": float(values.std(ddof=1)),\n",
    "        \"95% CI lower\": float(ci[\"ci_lower\"]),\n",
    "        \"95% CI upper\": float(ci[\"ci_upper\"]),\n",
    "        \"Min\": float(values.min()),\n",
    "        \"Max\": float(values.max()),\n",
    "    })\n",
    "\n",
    "final_summary_df = pd.DataFrame(summary_rows)\n",
    "display(final_summary_df)\n",
    "final_summary_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"FINAL_multiseed_summary.csv\"),\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "dense_scores = final_multiseed_df[\"Dense Macro-F1\"].to_numpy(dtype=float)\n",
    "static_scores = final_multiseed_df[\"Static-60 Macro-F1\"].to_numpy(dtype=float)\n",
    "adaptive_scores = final_multiseed_df[\"Adaptive Macro-F1\"].to_numpy(dtype=float)\n",
    "\n",
    "comparison_dense_adaptive = compare_models(\n",
    "    dense_scores,\n",
    "    adaptive_scores,\n",
    "    \"Dense\",\n",
    "    \"Adaptive\",\n",
    "    alpha=cfg.statistics.alpha,\n",
    ")\n",
    "comparison_static_adaptive = compare_models(\n",
    "    static_scores,\n",
    "    adaptive_scores,\n",
    "    \"Static-60\",\n",
    "    \"Adaptive\",\n",
    "    alpha=cfg.statistics.alpha,\n",
    ")\n",
    "\n",
    "\n",
    "def _comparison_row(result):\n",
    "    return {\n",
    "        \"Comparison\": result[\"comparison\"],\n",
    "        \"N paired runs\": result[\"n_runs\"],\n",
    "        \"Mean A\": result[\"mean_a\"],\n",
    "        \"Mean B\": result[\"mean_b\"],\n",
    "        \"Paired t-test p\": result[\"paired_ttest\"][\"p_value\"],\n",
    "        \"Wilcoxon p\": result[\"wilcoxon\"].get(\"p_value\"),\n",
    "        \"Cohen's d\": result[\"cohens_d\"],\n",
    "        \"A 95% CI lower\": result[\"ci_a\"][\"ci_lower\"],\n",
    "        \"A 95% CI upper\": result[\"ci_a\"][\"ci_upper\"],\n",
    "        \"B 95% CI lower\": result[\"ci_b\"][\"ci_lower\"],\n",
    "        \"B 95% CI upper\": result[\"ci_b\"][\"ci_upper\"],\n",
    "    }\n",
    "\n",
    "\n",
    "statistics_df = pd.DataFrame([\n",
    "    _comparison_row(comparison_dense_adaptive),\n",
    "    _comparison_row(comparison_static_adaptive),\n",
    "])\n",
    "display(statistics_df)\n",
    "statistics_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"FINAL_statistical_comparisons.csv\"),\n",
    "    index=False,\n",
    ")\n"
   ]
  },
