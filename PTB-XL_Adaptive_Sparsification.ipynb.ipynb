   "source": [
    "import os, yaml\n",
    "\n",
    "# INFRASTRUCTURE CHANGE: RTX 5080 / local-machine DataLoader tuning.\n",
    "# os.cpu_count() gives every logical core available to feed the GPU.\n",
    "LOCAL_NUM_WORKERS = globals().get(\"LOCAL_NUM_WORKERS\", min(4, os.cpu_count() or 0))\n",
    "\n",
    "CONFIG_YAML = \"\"\"\n",
    "# =============================================================================\n",
    "# config.yaml\n",
    "# Central configuration for the PTB-XL Adaptive Sparsification pipeline.\n",
    "#\n",
    "# Design note: this file separates PATHS / DATA / TASK definition from\n",
    "# MODEL / TRAINING / SPARSIFICATION hyperparameters so that every experiment\n",
    "# script (src/experiments/*.py) reads from the same source of truth and no\n",
    "# hyperparameter is duplicated across files (avoids the \"duplicated code\"\n",
    "# problem called out in the requirements).\n",
    "# =============================================================================\n",
    "\n",
    "paths:\n",
    "  dataset_root: \"PLACEHOLDER\"   # overridden below with the auto-detected local dataset_root\n",
    "  database_csv: \"ptbxl_database.csv\"\n",
    "  scp_csv: \"scp_statements.csv\"\n",
    "  results_dir: \"results\"\n",
    "  figures_dir: \"figures\"\n",
    "  weights_dir: \"weights\"\n",
    "  logs_dir: \"logs\"\n",
    "\n",
    "task:\n",
    "  # Standard PTB-XL benchmark task (Wagner et al. 2020; Strodthoff et al. 2021,\n",
    "  # \"Deep Learning for ECG Analysis: Benchmarks and Insights from PTB-XL\"):\n",
    "  # MULTILABEL classification over the 5 diagnostic superclasses. An ECG can\n",
    "  # carry more than one superclass label simultaneously (e.g. MI + STTC).\n",
    "  # This is NOT specified in the sparsification literature review (Ch. 2) --\n",
    "  # it is adopted from the standard PTB-XL benchmark literature so results\n",
    "  # are comparable to published PTB-XL baselines.\n",
    "  superclasses: [\"NORM\", \"MI\", \"STTC\", \"CD\", \"HYP\"]\n",
    "  num_classes: 5\n",
    "  sampling_rate_hz: 500          # use records500 (high-resolution) per PTB-XL docs\n",
    "  signal_length: 5000            # 10s @ 500Hz\n",
    "  num_leads: 12\n",
    "  min_diagnostic_likelihood: 0   # scp_codes likelihood threshold (0 = keep all diagnostic-labelled)\n",
    "\n",
    "split:\n",
    "  test_fold: 10        # PTB-XL's official recommended fold for test (per Wagner et al. 2020)\n",
    "  val_fold: 9           # official recommended fold for validation\n",
    "  # PTB-XL ships a pre-computed \"strat_fold\" column (1-10) that is patient-\n",
    "  # stratified out of the box; we use it directly instead of re-deriving a\n",
    "  # patient split, which is the standard/reproducible practice for this dataset.\n",
    "\n",
    "preprocessing:\n",
    "  bandpass_low_hz: 0.5\n",
    "  bandpass_high_hz: 40.0\n",
    "  filter_order: 3\n",
    "  remove_baseline_wander: true\n",
    "  baseline_wander_cutoff_hz: 0.5\n",
    "  normalize: \"zscore\"            # options: zscore | minmax | none\n",
    "\n",
    "augmentation:\n",
    "  enabled: true\n",
    "  gaussian_noise_std: 0.01\n",
    "  amplitude_scale_range: [0.9, 1.1]\n",
    "  time_shift_max_fraction: 0.05\n",
    "  random_mask_fraction: 0.05\n",
    "  time_warp_sigma: 0.1\n",
    "  mixup_alpha: 0.2\n",
    "  mixup_prob: 0.3\n",
    "\n",
    "dataloader:\n",
    "  batch_size: 32\n",
    "  num_workers: 2       # overridden below via os.cpu_count() for the local RTX 5080 machine\n",
    "  pin_memory: true\n",
    "  persistent_workers: true   # INFRASTRUCTURE CHANGE: new key, workers stay alive across epochs\n",
    "\n",
    "model:\n",
    "  backbone: \"se_resnet1d\"        # squeeze-excitation residual 1D CNN (see src/models/backbone.py)\n",
    "  stem_channels: 32\n",
    "  block_channels: [32, 64, 128, 256]\n",
    "  block_depth: 2                 # residual blocks per stage\n",
    "  se_reduction: 8\n",
    "  dropout: 0.5\n",
    "\n",
    "loss:\n",
    "  type: \"focal\"                  # options: bce | weighted_bce | focal | label_smoothing_bce\n",
    "  focal_gamma: 2.0\n",
    "  focal_alpha: 0.25\n",
    "  label_smoothing: 0.05\n",
    "\n",
    "optimizer:\n",
    "  type: \"adamw\"                  # options: adam | adamw | radam | sgd\n",
    "  lr: 0.001\n",
    "  weight_decay: 0.0001\n",
    "  momentum: 0.9                  # used only for sgd\n",
    "\n",
    "scheduler:\n",
    "  type: \"reduce_on_plateau\"      # options: reduce_on_plateau | cosine | none\n",
    "  factor: 0.5\n",
    "  patience: 3\n",
    "  min_lr: 0.000001\n",
    "\n",
    "training:\n",
    "  epochs: 60\n",
    "  early_stopping_patience: 8\n",
    "  early_stopping_metric: \"val_macro_auroc\"\n",
    "  grad_clip_norm: 5.0\n",
    "  mixed_precision: true\n",
    "  resume_from_checkpoint: null\n",
    "  checkpoint_every_n_epochs: 1\n",
    "  seed: 42\n",
    "  n_seeds_for_final_report: 5    # multi-seed robustness reporting\n",
    "\n",
    "class_imbalance:\n",
    "  strategy: \"weighted_loss_plus_balanced_sampler\"  # combine class weights AND a balanced sampler\n",
    "  # rationale documented in src/training/losses.py and src/data/dataset.py\n",
    "\n",
    "sparsification:\n",
    "  # Directly implements the \"Proposed Adaptive Sparsification Framework\"\n",
    "  # described in Literature Review Chapter 2, Section VIII.\n",
    "  static_sparsity_levels: [0.30, 0.60, 0.90]\n",
    "  gate_temperature: 1.0\n",
    "  energy_lambda: 0.05\n",
    "  energy_budget_fraction_of_dense: 0.5   # E_budget = fraction * E(dense)\n",
    "  consistency_lambda: 0.30   # ANTI-COLLAPSE FIX (round 2): doubled from 0.15 on 2026-08-21 --\n",
    "                              # Phase D.1's own diagnostic (see markdown note after that cell)\n",
    "                              # found the model STILL COLLAPSED at 0.15 (largest expert share\n",
    "                              # 99.8%, only 2/4 experts used) and explicitly recommended\n",
    "                              # \"roughly doubling both\" consistency_lambda and balance_lambda\n",
    "                              # before retraining. This has NOT been re-validated by execution\n",
    "                              # in this environment -- re-run Phase D.1 first after any full\n",
    "                              # retrain to confirm before trusting Phases E-K.\n",
    "  balance_lambda: 0.10       # ANTI-COLLAPSE FIX (round 2): doubled from 0.05, same reasoning as above.\n",
    "  difficulty_feature_set: [\"std\", \"mean_abs_sample_difference\", \"peak_to_peak\"]\n",
    "\n",
    "energy_model:\n",
    "  # Literature-calibrated proxy constants (NOT hardware-measured), adapted\n",
    "  # from Horowitz, \"Computing's Energy Problem\", ISSCC 2014 -- the standard\n",
    "  # reference used for such proxies in Chen et al. (Eyeriss) and related work\n",
    "  # cited in the literature review (refs [30], [31]).\n",
    "  pj_per_mac_fp32: 3.7\n",
    "  pj_per_byte_dram: 160.0\n",
    "  pj_per_byte_sram: 1.25\n",
    "\n",
    "explainability:\n",
    "  methods: [\"grad_cam\", \"integrated_gradients\"]\n",
    "  n_examples_per_class: 4\n",
    "\n",
    "statistics:\n",
    "  alpha: 0.05\n",
    "  bootstrap_n: 1000\n",
    "\n",
    "\"\"\"\n",
    "\n",
    "class ConfigDict(dict):\n",
    "    def __getattr__(self, name):\n",
    "        try:\n",
    "            value = self[name]\n",
    "        except KeyError as e:\n",
