   "source": [
    "from __future__ import annotations\n",
    "\n",
    "import logging\n",
    "import numpy as np\n",
    "import torch\n",
    "from torch.utils.data import Dataset\n",
    "\n",
    "logger = logging.getLogger(__name__)\n",
    "\n",
    "\n",
    "def _default_wfdb_loader(path):\n",
    "    import wfdb\n",
    "    return wfdb.rdsamp(path)\n",
    "\n",
    "class PTBXLDataset(Dataset):\n",
    "    def __init__(\n",
    "        self,\n",
    "        dataframe,\n",
    "        root_path: str,\n",
    "        superclasses: list[str],\n",
    "        sampling_rate_hz: int = 500,\n",
    "        preprocessing_cfg=None,\n",
    "        augmentation_cfg=None,\n",
    "        train: bool = False,\n",
    "        signal_loader=None,\n",
    "        seed: int = 42,\n",
    "    ):\n",
    "        self.df = dataframe.reset_index(drop=True)\n",
    "        self.root_path = root_path\n",
    "        self.superclasses = superclasses\n",
    "        self.fs = sampling_rate_hz\n",
    "        self.preprocessing_cfg = preprocessing_cfg\n",
    "        self.augmentation_cfg = augmentation_cfg\n",
    "        self.train = train\n",
    "        self.rng = np.random.default_rng(seed)\n",
    "\n",
    "        if signal_loader is None:\n",
    "            signal_loader = _default_wfdb_loader\n",
    "\n",
    "        self.signal_loader = signal_loader\n",
    "        self._filename_col = (\n",
    "            \"filename_hr\" if sampling_rate_hz == 500 else \"filename_lr\"\n",
    "        )\n",
    "        self._corrupted_indices = set()\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def _load_raw_signal(self, idx: int):\n",
    "        row = self.df.iloc[idx]\n",
    "        file_path = self.root_path + row[self._filename_col]\n",
    "\n",
    "        try:\n",
    "            signal, _ = self.signal_loader(file_path)\n",
    "        except (FileNotFoundError, OSError, ValueError) as e:\n",
    "            logger.warning(\n",
    "                \"Failed to read ECG at index %d (%s): %s\",\n",
    "                idx,\n",
    "                file_path,\n",
    "                e,\n",
    "            )\n",
    "            return None\n",
    "\n",
    "        # (time, leads) -> (leads, time)\n",
    "        signal = np.asarray(signal, dtype=np.float32).T\n",
    "        return signal\n",
    "\n",
    "    def __getitem__(self, idx: int):\n",
    "\n",
    "        signal = self._load_raw_signal(idx)\n",
    "\n",
    "        if signal is None or detect_corrupted_signal(signal):\n",
    "            self._corrupted_indices.add(idx)\n",
    "\n",
    "            fallback_idx = (idx + 1) % len(self.df)\n",
    "\n",
    "            if fallback_idx != idx:\n",
    "                return self.__getitem__(fallback_idx)\n",
    "            else:\n",
    "                return self._zero_sample()\n",
    "\n",
    "        # -----------------------------\n",
    "        # Preprocessing\n",
    "        # -----------------------------\n",
    "        if self.preprocessing_cfg is not None:\n",
    "            signal = preprocess_ecg(\n",
    "                signal,\n",
    "                self.fs,\n",
    "                self.preprocessing_cfg,\n",
    "            )\n",
    "\n",
    "        # -----------------------------\n",
    "        # Data augmentation\n",
    "        # -----------------------------\n",
    "        if self.train and self.augmentation_cfg is not None:\n",
    "            signal = apply_augmentation_pipeline(\n",
    "                signal,\n",
    "                self.augmentation_cfg,\n",
    "                self.rng,\n",
    "            )\n",
    "\n",
    "        # ***** IMPORTANT FIX *****\n",
    "        signal = np.asarray(signal, dtype=np.float32)\n",
    "\n",
    "        label = np.asarray(\n",
    "            self.df.iloc[idx][\"label_vector\"],\n",
    "            dtype=np.float32,\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            torch.from_numpy(signal.copy()),\n",
    "            torch.from_numpy(label),\n",
    "        )\n",
    "\n",
    "    def _zero_sample(self):\n",
    "        n_leads = 12\n",
    "        seq_len = 5000 if self.fs == 500 else 1000\n",
    "\n",
    "        return (\n",
    "            torch.zeros(n_leads, seq_len, dtype=torch.float32),\n",
    "            torch.zeros(len(self.superclasses), dtype=torch.float32),\n",
    "        )\n",
    "\n",
    "    def corruption_report(self):\n",
    "        return {\n",
    "            \"n_corrupted\": len(self._corrupted_indices),\n",
    "            \"corrupted_indices\": sorted(self._corrupted_indices),\n",
    "            \"pct_corrupted\": (\n",
    "                100\n",
    "                * len(self._corrupted_indices)\n",
    "                / max(1, len(self.df))\n",
    "            ),\n",
    "        }\n",
    "\n",
    "    def class_counts(self):\n",
    "        labels = np.stack(self.df[\"label_vector\"].values)\n",
    "        return labels.sum(axis=0)"
   ]
