   "source": [
    "# ---- from src/utils/flops_energy.py ----\n",
    "\n",
    "\"\"\"\n",
    "Efficiency-accounting utilities.\n",
    "\n",
    "Important distinction used in the corrected notebook:\n",
    "- `backbone_flops` is kept for the original analytical stage-level model.\n",
    "- `count_real_conv1d_macs` measures the Conv1d MACs of the network that is\n",
    "  actually instantiated and executed. The final static/adaptive comparisons\n",
    "  use this real-architecture counter rather than assuming zero masks remove\n",
    "  convolution work.\n",
    "- `EnergyProxyModel` remains an analytical proxy, not measured hardware energy.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "from dataclasses import dataclass\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "\n",
    "def count_params(model: nn.Module) -> dict:\n",
    "    total = sum(p.numel() for p in model.parameters())\n",
    "    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "    return {\"total_params\": total, \"trainable_params\": trainable}\n",
    "\n",
    "\n",
    "def count_conv1d_flops(c_in: int, c_out: int, kernel_size: int, seq_len_out: int) -> int:\n",
    "    \"\"\"MACs (not FLOPs=2*MACs).\"\"\"\n",
    "    return c_in * c_out * kernel_size * seq_len_out\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class LayerSpec:\n",
    "    c_in: int\n",
    "    c_out: int\n",
    "    kernel_size: int\n",
    "    seq_len_out: int\n",
    "    bytes_per_weight: int = 4\n",
    "\n",
    "\n",
    "def backbone_flops(layer_specs: list[LayerSpec], active_channels: list[int] | None = None) -> int:\n",
    "    \"\"\"Legacy analytical stage-level MAC counter, kept for compatibility.\"\"\"\n",
    "    total = 0\n",
    "    c_in = layer_specs[0].c_in\n",
    "    for i, spec in enumerate(layer_specs):\n",
    "        c_out = active_channels[i] if active_channels is not None else spec.c_out\n",
    "        total += count_conv1d_flops(c_in, c_out, spec.kernel_size, spec.seq_len_out)\n",
    "        c_in = c_out\n",
    "    return total\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def count_real_conv1d_macs(\n",
    "    model: nn.Module,\n",
    "    input_shape=(1, 12, 1000),\n",
    "    device=None,\n",
    ") -> int:\n",
    "    \"\"\"\n",
    "    Count Conv1d MACs from the REAL instantiated network by registering\n",
    "    forward hooks. This includes stem, residual convolutions and shortcut\n",
    "    convolutions, so it is appropriate for comparing physically smaller\n",
    "    experts against the dense model.\n",
    "\n",
    "    The returned value is per sample when input_shape[0] == 1.\n",
    "    \"\"\"\n",
    "    if device is None:\n",
    "        try:\n",
    "            device = next(model.parameters()).device\n",
    "        except StopIteration:\n",
    "            device = torch.device(\"cpu\")\n",
    "\n",
    "    total_macs = 0\n",
    "    hooks = []\n",
    "\n",
    "    def _hook(module, inputs, output):\n",
    "        nonlocal total_macs\n",
    "        if not isinstance(output, torch.Tensor) or output.dim() != 3:\n",
    "            return\n",
    "        batch_size, c_out, length_out = output.shape\n",
    "        c_in = module.in_channels\n",
    "        kernel = module.kernel_size[0]\n",
    "        groups = module.groups\n",
    "        total_macs += int(\n",
    "            batch_size\n",
    "            * length_out\n",
    "            * c_out\n",
    "            * (c_in // groups)\n",
    "            * kernel\n",
    "        )\n",
    "\n",
    "    for module in model.modules():\n",
    "        if isinstance(module, nn.Conv1d):\n",
    "            hooks.append(module.register_forward_hook(_hook))\n",
    "\n",
    "    was_training = model.training\n",
    "    model.eval()\n",
    "\n",
    "    dummy = torch.zeros(input_shape, device=device, dtype=torch.float32)\n",
    "    model(dummy)\n",
    "\n",
    "    for hook in hooks:\n",
    "        hook.remove()\n",
    "\n",
    "    model.train(was_training)\n",
    "    return total_macs\n",
    "\n",
    "\n",
    "class EnergyProxyModel:\n",
    "    \"\"\"\n",
    "    Analytical energy proxy. Values are estimates, not hardware measurements.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, pj_per_mac_fp32=3.7, pj_per_byte_dram=160.0, pj_per_byte_sram=1.25):\n",
    "        self.pj_per_mac = pj_per_mac_fp32\n",
    "        self.pj_per_byte_dram = pj_per_byte_dram\n",
    "        self.pj_per_byte_sram = pj_per_byte_sram\n",
    "\n",
    "    def estimate_nj(self, layer_specs: list[LayerSpec], active_channels: list[int] | None = None) -> float:\n",
    "        total_pj = 0.0\n",
    "        c_in = layer_specs[0].c_in\n",
    "        for i, spec in enumerate(layer_specs):\n",
    "            c_out = active_channels[i] if active_channels is not None else spec.c_out\n",
    "            macs = count_conv1d_flops(c_in, c_out, spec.kernel_size, spec.seq_len_out)\n",
    "            total_pj += macs * self.pj_per_mac\n",
    "            n_weights = c_out * c_in * spec.kernel_size\n",
    "            total_pj += n_weights * spec.bytes_per_weight * self.pj_per_byte_dram\n",
    "            c_in = c_out\n",
    "        return total_pj / 1000.0\n",
    "\n",
    "    def estimate_batch_nj_torch(\n",
    "        self,\n",
    "        layer_specs: list[LayerSpec],\n",
    "        active_channels_per_layer: list[torch.Tensor],\n",
    "    ) -> torch.Tensor:\n",
    "        total_pj = torch.zeros_like(active_channels_per_layer[0])\n",
    "        c_in = layer_specs[0].c_in\n",
    "        for spec, active_c in zip(layer_specs, active_channels_per_layer):\n",
    "            macs = c_in * active_c * spec.kernel_size * spec.seq_len_out\n",
    "            total_pj = total_pj + macs * self.pj_per_mac\n",
    "            n_weights = active_c * c_in * spec.kernel_size\n",
    "            total_pj = total_pj + n_weights * spec.bytes_per_weight * self.pj_per_byte_dram\n",
    "            c_in = active_c\n",
    "        return total_pj / 1000.0\n"
   ]
  },
