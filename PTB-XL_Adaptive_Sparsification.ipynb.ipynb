   "source": [
    "# ============================================================\n",
    "# LOSS-COMPONENT ABLATION: A (task only) -> D (full fix)\n",
    "#\n",
    "# SPEEDUP: these are mechanism-isolation runs, not final publishable\n",
    "# numbers (Phase H's 5-seed run is what the thesis should cite for that).\n",
    "# They use a shorter training budget on purpose -- enough epochs to see\n",
    "# which loss configuration collapses and which doesn't, without paying\n",
    "# the full cfg.training.epochs cost eight times over. Set\n",
    "# EXPLORATORY_MAX_EPOCHS / EXPLORATORY_PATIENCE below if you want more\n",
    "# or less confidence before committing to the full run.\n",
    "# ============================================================\n",
    "\n",
    "EXPLORATORY_MAX_EPOCHS = min(int(cfg.training.epochs), 15)\n",
    "EXPLORATORY_PATIENCE = min(int(cfg.training.early_stopping_patience), 5)\n",
    "\n",
    "ablation_configs = [\n",
    "    (\"A: task only\",                         0.0,  0.0,   0.0),\n",
    "    (\"B: task + energy\",                     cfg.sparsification.energy_lambda, 0.0, 0.0),\n",
    "    (\"C: task + energy + anti-collapse\",     cfg.sparsification.energy_lambda, 0.0, cfg.sparsification.balance_lambda),\n",
    "    (\"D: task + energy + anti-collapse + consistency (proposed)\",\n",
    "                                              cfg.sparsification.energy_lambda,\n",
    "                                              cfg.sparsification.consistency_lambda,\n",
    "                                              cfg.sparsification.balance_lambda),\n",
    "]\n",
    "\n",
    "ablation_rows = []\n",
    "ablation_seed = int(cfg.training.seed)\n",
    "full_fix_result = None   # reused below to avoid retraining an identical config\n",
    "full_fix_diag = None\n",
    "\n",
    "for label, e_lambda, c_lambda, b_lambda in ablation_configs:\n",
    "    result = run_adaptive(\n",
    "        dense_model=dense_model,\n",
    "        train_loader=train_loader,\n",
    "        val_loader=val_loader,\n",
    "        test_loader=test_loader,\n",
    "        class_counts=class_counts,\n",
    "        cfg=cfg,\n",
    "        seed=ablation_seed,\n",
    "        use_heuristic_gate=False,\n",
    "        reuse_checkpoint=False,\n",
    "        energy_lambda=e_lambda,\n",
    "        consistency_lambda=c_lambda,\n",
    "        balance_lambda=b_lambda,\n",
    "        max_epochs=EXPLORATORY_MAX_EPOCHS,\n",
    "        early_stopping_patience=EXPLORATORY_PATIENCE,\n",
    "    )\n",
    "    diag = diagnose_adaptive_routing(result[\"model\"].to(device), test_loader, device)\n",
    "\n",
    "    if label.startswith(\"D:\"):\n",
    "        # Config D is, by construction, identical to cfg.sparsification's\n",
    "        # default lambdas -- exactly the point the lambda sweep below would\n",
    "        # otherwise retrain from scratch. Cache it instead of duplicating\n",
    "        # the run.\n",
    "        full_fix_result = result\n",
    "        full_fix_diag = diag\n",
    "\n",
    "    ablation_rows.append({\n",
    "        \"Config\": label,\n",
    "        \"energy_lambda\": e_lambda,\n",
    "        \"consistency_lambda\": c_lambda,\n",
    "        \"balance_lambda\": b_lambda,\n",
    "        \"Macro-F1\": result[\"test_metrics\"][\"summary\"][\"f1_macro\"],\n",
    "        \"Macro-AUROC\": result[\"test_metrics\"][\"summary\"].get(\"auroc_macro\", np.nan),\n",
    "        \"Spearman(difficulty, loss)\": diag[\"spearman_rho\"],\n",
    "        \"Routing entropy (% of max)\": 100 * diag[\"routing_entropy\"] / diag[\"max_routing_entropy\"],\n",
    "        \"Largest expert share (%)\": diag[\"max_expert_share_pct\"],\n",
    "    })\n",
    "\n",
    "ablation_df = pd.DataFrame(ablation_rows)\n",
    "ablation_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"loss_ablation_ABCD.csv\"), index=False\n",
    ")\n",
    "display(ablation_df)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# ENERGY-LAMBDA SWEEP (Pareto frontier), full fix held constant\n",
    "#\n",
    "# energy_lambda == cfg.sparsification.energy_lambda is IDENTICAL to\n",
    "# ablation config \"D\" above (same lambdas, same seed) -- reused rather\n",
    "# than retrained.\n",
    "# ============================================================\n",
    "\n",
    "energy_lambda_sweep = [0.02, 0.05, 0.10, 0.20]\n",
    "pareto_rows = []\n",
    "\n",
    "for e_lambda in energy_lambda_sweep:\n",
    "    if abs(e_lambda - float(cfg.sparsification.energy_lambda)) < 1e-9 and full_fix_result is not None:\n",
    "        result, diag = full_fix_result, full_fix_diag\n",
    "    else:\n",
    "        result = run_adaptive(\n",
    "            dense_model=dense_model,\n",
    "            train_loader=train_loader,\n",
    "            val_loader=val_loader,\n",
    "            test_loader=test_loader,\n",
    "            class_counts=class_counts,\n",
    "            cfg=cfg,\n",
    "            seed=ablation_seed,\n",
    "            use_heuristic_gate=False,\n",
    "            reuse_checkpoint=False,\n",
    "            energy_lambda=e_lambda,\n",
    "            consistency_lambda=cfg.sparsification.consistency_lambda,\n",
    "            balance_lambda=cfg.sparsification.balance_lambda,\n",
    "            max_epochs=EXPLORATORY_MAX_EPOCHS,\n",
    "            early_stopping_patience=EXPLORATORY_PATIENCE,\n",
    "        )\n",
    "        diag = diagnose_adaptive_routing(result[\"model\"].to(device), test_loader, device)\n",
    "\n",
    "    mean_energy = float(\n",
    "        result[\"energy_per_level\"][diag[\"selected_expert\"]].mean()\n",
    "    )\n",
    "\n",
    "    pareto_rows.append({\n",
    "        \"energy_lambda\": e_lambda,\n",
    "        \"Macro-F1\": result[\"test_metrics\"][\"summary\"][\"f1_macro\"],\n",
    "        \"Macro-AUROC\": result[\"test_metrics\"][\"summary\"].get(\"auroc_macro\", np.nan),\n",
    "        \"Mean energy (nJ)\": mean_energy,\n",
    "        \"Mean energy (% of dense)\": 100 * mean_energy / result[\"dense_energy\"],\n",
    "    })\n",
    "\n",
    "pareto_df = pd.DataFrame(pareto_rows)\n",
    "pareto_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"energy_lambda_pareto.csv\"), index=False\n",
    ")\n",
    "display(pareto_df)\n"
   ]
  },
