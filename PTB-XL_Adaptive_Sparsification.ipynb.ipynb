    "# ============================================================\n",
    "# ENERGY-OBJECTIVE ABLATION\n",
    "# ============================================================\n",
    "\n",
    "import gc\n",
    "\n",
    "# Release exploratory GPU copies before training the additional ablation model.\n",
    "adaptive_result[\"model\"].to(\"cpu\")\n",
    "heuristic_result[\"model\"].to(\"cpu\")\n",
    "for _static_entry in static_results.values():\n",
    "    if \"model\" in _static_entry:\n",
    "        _static_entry[\"model\"].to(\"cpu\")\n",
    "gc.collect()\n",
    "if torch.cuda.is_available():\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "no_energy_result = run_adaptive(\n",
    "    dense_model=dense_model,\n",
    "    train_loader=train_loader,\n",
    "    val_loader=val_loader,\n",
    "    test_loader=test_loader,\n",
    "    class_counts=class_counts,\n",
    "    cfg=cfg,\n",
    "    seed=int(cfg.training.seed),\n",
    "    use_heuristic_gate=False,\n",
    "    reuse_checkpoint=False,\n",
    "    energy_lambda=0.0,\n",
    ")\n",
    "\n",
    "\n",
    "def adaptive_average_compute(result, loader):\n",
    "    model = result[\"model\"].to(device)\n",
    "    model.eval()\n",
    "    selections = []\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for signals, _ in loader:\n",
    "            output = model(\n",
    "                signals.to(device, non_blocking=True),\n",
    "                hard=True,\n",
    "            )\n",
    "            selections.append(output[\"selected_expert\"].detach().cpu())\n",
    "\n",
    "    selections = torch.cat(selections).numpy().astype(int)\n",
    "    macs = np.asarray(result[\"expert_macs\"], dtype=np.float64)\n",
    "    energies = result[\"energy_per_level\"].numpy().astype(np.float64)\n",
    "    avg_macs = float(macs[selections].mean())\n",
    "    avg_energy = float(energies[selections].mean())\n",
    "\n",
    "    metrics = {\n",
    "        \"MACs % dense\": 100.0 * avg_macs / max(float(result[\"dense_macs\"]), 1.0),\n",
    "        \"Energy % dense\": 100.0 * avg_energy / max(float(result[\"dense_energy\"]), 1e-12),\n",
    "    }\n",
    "\n",
    "    model.to(\"cpu\")\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "    return metrics\n",
    "\n",
    "\n",
    "no_energy_efficiency = adaptive_average_compute(no_energy_result, test_loader)\n",
    "energy_aware_efficiency = adaptive_average_compute(adaptive_result, test_loader)\n",
    "\n",
    "energy_ablation_df = pd.DataFrame([\n",
    "    {\n",
    "        \"Objective\": \"Task loss only (lambda=0)\",\n",
    "        \"Macro-F1\": no_energy_result[\"test_metrics\"][\"summary\"][\"f1_macro\"],\n",
    "        \"Macro-AUROC\": no_energy_result[\"test_metrics\"][\"summary\"].get(\"auroc_macro\", np.nan),\n",
    "        **no_energy_efficiency,\n",
    "    },\n",
    "    {\n",
    "        \"Objective\": f\"Energy-aware (lambda={cfg.sparsification.energy_lambda})\",\n",
    "        \"Macro-F1\": adaptive_result[\"test_metrics\"][\"summary\"][\"f1_macro\"],\n",
    "        \"Macro-AUROC\": adaptive_result[\"test_metrics\"][\"summary\"].get(\"auroc_macro\", np.nan),\n",
    "        **energy_aware_efficiency,\n",
    "    },\n",
    "])\n",
    "\n",
    "display(energy_ablation_df)\n",
    "energy_ablation_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"energy_objective_ablation.csv\"),\n",
    "    index=False,\n",
    ")\n"
   ]
  },
