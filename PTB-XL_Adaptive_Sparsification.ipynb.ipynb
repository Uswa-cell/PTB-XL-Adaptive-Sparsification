    "from __future__ import annotations\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "\n",
    "\n",
    "class AdaptiveGate(nn.Module):\n",
    "    \"\"\"\n",
    "    Maps difficulty to routing probabilities.\n",
    "\n",
    "    Sparsity levels are ordered from MOST sparse/easiest to dense/hardest,\n",
    "    e.g. [0.90, 0.60, 0.30, 0.00].\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        n_levels: int,\n",
    "        temperature: float = 1.0,\n",
    "        min_temperature: float = 0.10,\n",
    "    ):\n",
    "        super().__init__()\n",
    "        self.n_levels = n_levels\n",
    "        self.temperature = float(temperature)\n",
    "        self.min_temperature = float(min_temperature)\n",
    "        self.register_buffer(\"centers\", torch.linspace(0.0, 1.0, steps=n_levels))\n",
    "\n",
    "    def set_temperature(self, temperature: float):\n",
    "        self.temperature = max(float(temperature), self.min_temperature)\n",
    "\n",
    "    def forward(self, difficulty: torch.Tensor, hard: bool = False) -> torch.Tensor:\n",
    "        difficulty = difficulty.clamp(0.0, 1.0)\n",
    "        temperature = max(self.temperature, self.min_temperature)\n",
    "\n",
    "        dist = -(difficulty.unsqueeze(1) - self.centers.unsqueeze(0)).pow(2)\n",
    "        soft_probs = F.softmax(dist / temperature, dim=1)\n",
    "\n",
    "        if not hard:\n",
    "            return soft_probs\n",
    "\n",
    "        idx = soft_probs.argmax(dim=1)\n",
    "        hard_probs = F.one_hot(idx, num_classes=self.n_levels).to(soft_probs.dtype)\n",
    "\n",
    "        # Straight-through representation. During no-grad inference this is\n",
    "        # simply one-hot; during gradient-based use it retains soft gradients.\n",
    "        return hard_probs + soft_probs - soft_probs.detach()\n"
   ]
  },
