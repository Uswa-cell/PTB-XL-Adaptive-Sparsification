    "# ============================================================\n",
    "# ADAPTIVE PHYSICAL-EXPERT EXPERIMENT\n",
    "# Seed-safe independent checkpoints\n",
    "# ============================================================\n",
    "\n",
    "from __future__ import annotations\n",
    "import os\n",
    "import csv\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "\n",
    "def run_adaptive(\n",
    "    dense_model,\n",
    "    train_loader,\n",
    "    val_loader,\n",
    "    test_loader,\n",
    "    class_counts,\n",
    "    cfg,\n",
    "    seed=None,\n",
    "    use_heuristic_gate=False,\n",
    "    reuse_checkpoint=False,\n",
    "    energy_lambda=None,\n",
    "    consistency_lambda=None,\n",
    "    balance_lambda=None,\n",
    "    max_epochs=None,\n",
    "    early_stopping_patience=None,\n",
    "    config_path=None,\n",
    "):\n",
    "    if cfg is None:\n",
    "        cfg = load_config(config_path)\n",
    "\n",
    "    if seed is None:\n",
    "        seed = int(cfg.training.seed)\n",
    "    seed = int(seed)\n",
    "    set_seed(seed)\n",
    "\n",
    "    if energy_lambda is None:\n",
    "        energy_lambda = float(cfg.sparsification.energy_lambda)\n",
    "    energy_lambda = float(energy_lambda)\n",
    "\n",
    "    if consistency_lambda is None:\n",
    "        consistency_lambda = float(cfg.sparsification.consistency_lambda)\n",
    "    consistency_lambda = float(consistency_lambda)\n",
    "\n",
    "    if balance_lambda is None:\n",
    "        balance_lambda = float(cfg.sparsification.balance_lambda)\n",
    "    balance_lambda = float(balance_lambda)\n",
    "\n",
    "    tag = \"heuristic_gate\" if use_heuristic_gate else \"adaptive\"\n",
    "    lambda_tag = str(energy_lambda).replace(\".\", \"p\")\n",
    "    run_name = f\"{tag}_physical_experts_seed{seed}_lambda{lambda_tag}\"\n",
    "    logger = get_logger(run_name, cfg.paths.logs_dir)\n",
    "\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    class_names = list(cfg.task.superclasses)\n",
    "    num_classes = len(class_names)\n",
    "\n",
    "    # Most sparse/easiest -> dense/hardest.\n",
    "    configured = sorted(\n",
    "        [float(s) for s in cfg.sparsification.static_sparsity_levels],\n",
    "        reverse=True,\n",
    "    )\n",
    "    sparsity_levels = configured.copy()\n",
    "    if 0.0 not in sparsity_levels:\n",
    "        sparsity_levels.append(0.0)\n",
    "\n",
    "    dense_model = dense_model.to(device)\n",
    "\n",
    "    # Build all experts from THIS seed's converged dense model.\n",
    "    experts = []\n",
    "    for sparsity in sparsity_levels:\n",
    "        expert = build_pruned_expert_from_dense(\n",
    "            dense_model,\n",
    "            sparsity=sparsity,\n",
    "            se_reduction=cfg.model.se_reduction,\n",
    "        ).to(device)\n",
    "        experts.append(expert)\n",
    "\n",
    "    model = AdaptiveECGClassifier(\n",
    "        experts=experts,\n",
    "        sparsity_levels=sparsity_levels,\n",
    "        num_classes=num_classes,\n",
    "        in_leads=cfg.task.num_leads,\n",
    "        gate_temperature=cfg.sparsification.gate_temperature,\n",
    "        use_heuristic_gate=use_heuristic_gate,\n",
    "    ).to(device)\n",
    "\n",
    "    expert_macs = []\n",
    "    expert_parameters = []\n",
    "    for sparsity, expert in zip(sparsity_levels, model.experts):\n",
    "        macs = int(count_real_conv1d_macs(\n",
    "            expert,\n",
    "            input_shape=(1, cfg.task.num_leads, cfg.task.signal_length),\n",
    "            device=device,\n",
    "        ))\n",
    "        params = int(count_params(expert)[\"total_params\"])\n",
    "        expert_macs.append(macs)\n",
    "        expert_parameters.append(params)\n",
    "        logger.info(\n",
    "            \"Sparsity %.0f%% | channels=%s | params=%d | MACs=%.3fM\",\n",
    "            sparsity * 100,\n",
    "            [stage.c_out for stage in expert.stages],\n",
    "            params,\n",
    "            macs / 1e6,\n",
    "        )\n",
    "\n",
    "    dense_idx = sparsity_levels.index(0.0)\n",
    "    dense_macs = float(expert_macs[dense_idx])\n",
    "\n",
    "    layer_specs = get_layer_specs(cfg)\n",
    "    energy_model = EnergyProxyModel(**cfg.energy_model)\n",
    "    dense_energy = float(energy_model.estimate_nj(layer_specs))\n",
    "    energy_values = [\n",
    "        dense_energy * macs / max(dense_macs, 1.0)\n",
    "        for macs in expert_macs\n",
    "    ]\n",
    "\n",
    "    # -----------------------------------------------------------------\n",
    "    # ROUTING-OVERHEAD FIX (energy-efficiency methodology):\n",
    "    #\n",
    "    # The DifficultyEstimator runs on EVERY sample, for EVERY expert\n",
    "    # choice, before any backbone expert is even selected. Previously its\n",
    "    # cost was never added anywhere in the energy accounting, so the\n",
    "    # reported \"energy % of dense\" silently understated the adaptive\n",
    "    # model's true per-sample cost — a direct violation of \"include all\n",
    "    # routing overhead in efficiency calculations\". HeuristicDifficultyGate\n",
    "    # has zero learnable parameters (pure feature arithmetic) and\n",
    "    # correctly contributes ~0 here; the learned DifficultyEstimator does\n",
    "    # not. Feature extraction itself (std/mad/ptp over the raw waveform)\n",
    "    # is an O(leads*T) reduction, not a MAC-bearing matmul, and its\n",
    "    # wall-clock cost is reported separately in the Phase I hardware\n",
    "    # benchmark rather than folded into this analytical MAC-based proxy.\n",
    "    # -----------------------------------------------------------------\n",
    "\n",
    "    def _count_linear_macs(module: nn.Module) -> int:\n",
    "        return sum(\n",
    "            layer.in_features * layer.out_features\n",
    "            for layer in module.modules()\n",
    "            if isinstance(layer, nn.Linear)\n",
    "        )\n",
    "\n",
    "    router_macs = _count_linear_macs(model.difficulty)\n",
    "    router_energy_nj = dense_energy * router_macs / max(dense_macs, 1.0)\n",
    "\n",
    "    energy_values = [value + router_energy_nj for value in energy_values]\n",
    "\n",
    "    energy_per_level = torch.tensor(\n",
    "        energy_values,\n",
    "        dtype=torch.float32,\n",
    "        device=device,\n",
    "    )\n",
    "    energy_budget = (\n",
    "        float(cfg.sparsification.energy_budget_fraction_of_dense)\n",
    "        * dense_energy\n",
    "    )\n",
    "\n",
    "    logger.info(\n",
    "        \"Routing overhead: difficulty-estimator MACs=%d (%.4f%% of dense \"\n",
    "        \"backbone MACs) | energy=%.4f nJ/sample added to EVERY expert level\",\n",
    "        router_macs,\n",
    "        100.0 * router_macs / max(dense_macs, 1.0),\n",
    "        router_energy_nj,\n",
    "    )\n",
    "\n",
    "    loss_fn_local = build_loss(\n",
    "        cfg.loss,\n",
    "        class_counts,\n",
    "        len(train_loader.dataset),\n",
    "    ).to(device)\n",
    "\n",
    "    expert_params = list(model.experts.parameters())\n",
    "    router_params = list(model.difficulty.parameters())\n",
    "    parameter_groups = [\n",
    "        {\"params\": expert_params, \"lr\": cfg.optimizer.lr * 0.1}\n",
    "    ]\n",
    "    if router_params:\n",
    "        parameter_groups.append({\n",
    "            \"params\": router_params,\n",
    "            \"lr\": cfg.optimizer.lr,\n",
    "        })\n",
    "\n",
    "    optimizer = torch.optim.AdamW(\n",
    "        parameter_groups,\n",
    "        weight_decay=cfg.optimizer.weight_decay,\n",
    "    )\n",
    "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "        optimizer,\n",
    "        mode=\"min\",\n",
    "        factor=0.5,\n",
    "        patience=3,\n",
    "    )\n",
    "\n",
    "    trainer = Trainer(\n",
    "        model,\n",
    "        optimizer,\n",
    "        scheduler,\n",
    "        loss_fn_local,\n",
    "        device,\n",
    "        class_names,\n",
    "        run_name=run_name,\n",
    "        results_dir=cfg.paths.results_dir,\n",
    "        weights_dir=cfg.paths.weights_dir,\n",
    "        mixed_precision=cfg.training.mixed_precision,\n",
    "        energy_aware=True,\n",
    "        energy_per_level=energy_per_level,\n",
    "        energy_budget=energy_budget,\n",
    "        energy_lambda=energy_lambda,\n",
    "        consistency_lambda=consistency_lambda,\n",
    "        balance_lambda=balance_lambda,\n",
    "    )\n",
    "\n",
    "    best_path = os.path.join(cfg.paths.weights_dir, f\"{run_name}_best.pt\")\n",
    "\n",
    "    # Final thesis experiments use reuse_checkpoint=False to guarantee\n",
    "    # independent runs. The option remains available for exploratory reruns.\n",
    "    if reuse_checkpoint and os.path.exists(best_path):\n",
    "        load_checkpoint(best_path, model, optimizer, scheduler)\n",
    "        logger.info(\"Loaded adaptive checkpoint: %s\", best_path)\n",
    "    else:\n",
    "        # EXPLORATORY-RUN SPEEDUP: ablation/sweep cells pass shorter\n",
    "        # max_epochs / early_stopping_patience explicitly, since they only\n",
    "        # need to establish a mechanism-level ranking between configs, not\n",
    "        # final publishable numbers. Final Phase D and the Phase H 5-seed\n",
    "        # run never pass these, so they always get the full cfg.training\n",
    "        # budget.\n",
    "        trainer.fit(\n",
    "            train_loader,\n",
    "            val_loader,\n",
    "            int(max_epochs) if max_epochs is not None else cfg.training.epochs,\n",
    "            int(early_stopping_patience) if early_stopping_patience is not None else cfg.training.early_stopping_patience,\n",
    "        )\n",
    "        if os.path.exists(best_path):\n",
    "            load_checkpoint(best_path, model, optimizer, scheduler)\n",
    "\n",
    "    test_metrics = trainer.evaluate(test_loader, split=\"test\")\n",
    "\n",
    "    metrics_path = os.path.join(\n",
    "        cfg.paths.results_dir,\n",
    "        f\"{run_name}_test_metrics.csv\",\n",
    "    )\n",
    "    with open(metrics_path, \"w\", newline=\"\") as f:\n",
    "        writer = csv.writer(f)\n",
    "        writer.writerow([\"metric\", \"value\"])\n",
    "        for key, value in test_metrics[\"summary\"].items():\n",
    "            writer.writerow([key, value])\n",
    "\n",
    "    expert_info_path = os.path.join(\n",
    "        cfg.paths.results_dir,\n",
    "        f\"{run_name}_expert_info.csv\",\n",
    "    )\n",
    "    with open(expert_info_path, \"w\", newline=\"\") as f:\n",
    "        writer = csv.writer(f)\n",
    "        writer.writerow([\n",
    "            \"seed\",\n",
    "            \"target_sparsity\",\n",
    "            \"actual_channel_sparsity\",\n",
    "            \"parameters\",\n",
    "            \"macs\",\n",
    "            \"estimated_energy_nj_incl_routing_overhead\",\n",
    "            \"routing_overhead_nj\",\n",
    "        ])\n",
    "        for sparsity, expert, params, macs, energy in zip(\n",
    "            sparsity_levels,\n",
    "            model.experts,\n",
    "            expert_parameters,\n",
    "            expert_macs,\n",
    "            energy_values,\n",
    "        ):\n",
    "            writer.writerow([\n",
    "                seed,\n",
    "                sparsity,\n",
    "                actual_channel_sparsity(expert, dense_model),\n",
    "                params,\n",
    "                macs,\n",
    "                energy,\n",
    "                router_energy_nj,\n",
    "            ])\n",
    "\n",
    "    return {\n",
    "        \"seed\": seed,\n",
    "        \"model\": model,\n",
    "        \"test_metrics\": test_metrics,\n",
    "        \"energy_per_level\": energy_per_level.detach().cpu(),\n",
    "        \"energy_budget\": float(energy_budget),\n",
