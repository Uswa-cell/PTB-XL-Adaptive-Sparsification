    "# ---- from src/evaluation/statistics.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/evaluation/statistics.py\n",
    "--------------------------------\n",
    "Statistical validation for comparing models (dense vs static-pruned vs\n",
    "adaptive), as required by RQ2/RQ5. Implements:\n",
    "  - Paired t-test           : per-seed metric comparison (parametric).\n",
    "  - Wilcoxon signed-rank    : non-parametric alternative, robust to the\n",
    "                               small sample sizes typical of a 3-5 seed\n",
    "                               multi-run comparison.\n",
    "  - McNemar's test          : per-SAMPLE prediction agreement/disagreement\n",
    "                               between two models on the same test set --\n",
    "                               the standard test for \"does model A get\n",
    "                               different examples right than model B\" at\n",
    "                               fixed sparsity, most relevant to RQ5.\n",
    "  - Bootstrap confidence intervals : for any single scalar metric (e.g.\n",
    "                               macro-F1), reported alongside point estimates\n",
    "                               throughout the results notebook.\n",
    "  - Cohen's d effect size    : practical-significance companion to the\n",
    "                               p-value, since with enough seeds/samples\n",
    "                               small differences become \"significant\" without\n",
    "                               being practically meaningful.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "\n",
    "\n",
    "def paired_ttest(scores_a: np.ndarray, scores_b: np.ndarray) -> dict:\n",
    "    t_stat, p_value = stats.ttest_rel(scores_a, scores_b)\n",
    "    return {\"test\": \"paired_t_test\", \"t_stat\": float(t_stat), \"p_value\": float(p_value)}\n",
    "\n",
    "\n",
    "def wilcoxon_test(scores_a: np.ndarray, scores_b: np.ndarray) -> dict:\n",
    "    try:\n",
    "        stat, p_value = stats.wilcoxon(scores_a, scores_b)\n",
    "    except ValueError as e:\n",
    "        return {\"test\": \"wilcoxon\", \"stat\": None, \"p_value\": None, \"note\": str(e)}\n",
    "    return {\"test\": \"wilcoxon\", \"stat\": float(stat), \"p_value\": float(p_value)}\n",
    "\n",
    "\n",
    "def mcnemar_test(y_true: np.ndarray, pred_a: np.ndarray, pred_b: np.ndarray) -> dict:\n",
    "    \"\"\"y_true/pred_a/pred_b: (N,) binary correctness OR raw predictions for\n",
    "    a single class -- caller decides; here we compare CORRECTNESS (pred==true)\n",
    "    of model A vs model B, which is the standard McNemar setup for comparing\n",
    "    two classifiers on the same test set.\"\"\"\n",
    "    correct_a = (pred_a == y_true)\n",
    "    correct_b = (pred_b == y_true)\n",
    "    n01 = int(np.sum(correct_a & ~correct_b))  # A right, B wrong\n",
    "    n10 = int(np.sum(~correct_a & correct_b))  # A wrong, B right\n",
    "    if n01 + n10 == 0:\n",
    "        return {\"test\": \"mcnemar\", \"statistic\": 0.0, \"p_value\": 1.0, \"n01\": n01, \"n10\": n10}\n",
    "    statistic = (abs(n01 - n10) - 1) ** 2 / (n01 + n10)  # continuity-corrected\n",
    "    p_value = float(1 - stats.chi2.cdf(statistic, df=1))\n",
    "    return {\"test\": \"mcnemar\", \"statistic\": float(statistic), \"p_value\": p_value, \"n01\": n01, \"n10\": n10}\n",
    "\n",
    "\n",
    "def bootstrap_ci(values: np.ndarray, n_boot: int = 1000, alpha: float = 0.05, seed: int = 42) -> dict:\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n = len(values)\n",
    "    boot_means = np.array([rng.choice(values, size=n, replace=True).mean() for _ in range(n_boot)])\n",
    "    lower = np.percentile(boot_means, 100 * alpha / 2)\n",
    "    upper = np.percentile(boot_means, 100 * (1 - alpha / 2))\n",
    "    return {\"mean\": float(values.mean()), \"ci_lower\": float(lower), \"ci_upper\": float(upper)}\n",
    "\n",
    "\n",
    "def cohens_d(scores_a: np.ndarray, scores_b: np.ndarray) -> float:\n",
    "    diff = scores_a - scores_b\n",
    "    return float(diff.mean() / (diff.std(ddof=1) + 1e-8))\n",
    "\n",
    "\n",
    "def compare_models(scores_a: np.ndarray, scores_b: np.ndarray, name_a: str, name_b: str,\n",
    "                    alpha: float = 0.05) -> dict:\n",
    "    \"\"\"Convenience wrapper bundling every applicable test for a multi-seed\n",
    "    metric comparison (e.g. macro-F1 across 5 seeds for two models).\"\"\"\n",
    "    result = {\n",
    "        \"comparison\": f\"{name_a} vs {name_b}\",\n",
    "        \"n_runs\": len(scores_a),\n",
    "        \"mean_a\": float(scores_a.mean()), \"mean_b\": float(scores_b.mean()),\n",
    "        \"paired_ttest\": paired_ttest(scores_a, scores_b),\n",
    "        \"wilcoxon\": wilcoxon_test(scores_a, scores_b),\n",
    "        \"cohens_d\": cohens_d(scores_a, scores_b),\n",
    "        \"ci_a\": bootstrap_ci(scores_a, alpha=alpha),\n",
    "        \"ci_b\": bootstrap_ci(scores_b, alpha=alpha),\n",
    "    }\n",
    "    result[\"significant_at_alpha\"] = result[\"paired_ttest\"][\"p_value\"] < alpha\n",
    "    return result\n"
   ]
  },
