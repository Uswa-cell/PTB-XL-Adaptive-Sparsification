    "# ---- from src/training/samplers.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/training/samplers.py\n",
    "----------------------------\n",
    "Balanced sampling for multilabel imbalance, combined with the weighted loss\n",
    "(config: class_imbalance.strategy = \"weighted_loss_plus_balanced_sampler\").\n",
    "Using both together is deliberate: pos_weight in the loss corrects the\n",
    "per-class gradient magnitude, while the sampler corrects how OFTEN rare\n",
    "*combinations* of labels are seen per epoch -- for multilabel data a\n",
    "per-class-only fix under-samples rare co-occurring pairs (e.g. MI+STTC).\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import numpy as np\n",
    "import torch\n",
    "from torch.utils.data import WeightedRandomSampler\n",
    "\n",
    "\n",
    "def compute_sample_weights(label_matrix: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"label_matrix: (N, C) binary. Each sample's weight is the inverse\n",
    "    frequency of its RAREST active label (so multi-label samples get\n",
    "    up-weighted by whichever of their labels is scarcest, rather than\n",
    "    diluted by an average).\"\"\"\n",
    "    class_counts = label_matrix.sum(axis=0)\n",
    "    class_counts = np.clip(class_counts, 1, None)\n",
    "    inv_freq = 1.0 / class_counts\n",
    "\n",
    "    weights = np.zeros(len(label_matrix))\n",
    "    for i, row in enumerate(label_matrix):\n",
    "        active = np.where(row > 0)[0]\n",
    "        weights[i] = inv_freq[active].max() if len(active) > 0 else inv_freq.min()\n",
    "    return weights\n",
    "\n",
    "\n",
    "def build_balanced_sampler(label_matrix: np.ndarray) -> WeightedRandomSampler:\n",
    "    weights = compute_sample_weights(label_matrix)\n",
    "    return WeightedRandomSampler(\n",
    "        weights=torch.as_tensor(weights, dtype=torch.double),\n",
    "        num_samples=len(weights),\n",
    "        replacement=True,\n",
    "    )\n"
   ]
  },
