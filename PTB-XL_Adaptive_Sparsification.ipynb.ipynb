    "# ---- from src/evaluation/explainability.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/evaluation/explainability.py\n",
    "------------------------------------\n",
    "Explainability method selection and justification\n",
    "------------------------------------------------------\n",
    "Grad-CAM (Selvaraju et al., 2017) and Integrated Gradients (Sundararajan et\n",
    "al., 2017) are chosen over SHAP/LIME for this model because:\n",
    "  (a) both are gradient-based and require only a single (or few) forward/\n",
    "      backward pass(es) -- SHAP's KernelSHAP and LIME's local perturbation\n",
    "      sampling are orders of magnitude slower on a 5000-sample-length 1D\n",
    "      signal and are designed for tabular/image data, not raw time series;\n",
    "  (b) Grad-CAM directly answers \"which part of the ECG waveform drove this\n",
    "      prediction\", the clinically relevant question for RQ5's rare-class\n",
    "      robustness analysis; SHAP/LIME's feature-attribution framing is a\n",
    "      poorer fit for a convolutional time-series backbone;\n",
    "  (c) Integrated Gradients gives a complementary, axiomatically-grounded\n",
    "      (completeness, sensitivity) per-timestep attribution, cross-checking\n",
    "      Grad-CAM's coarser stage-level localisation.\n",
    "Both are implemented directly (no captum dependency) so they work\n",
    "identically on the maskable ECGBackbone, including inside the adaptive\n",
    "model where the active mask itself varies per input -- an important caveat\n",
    "noted in the literature review's gap analysis (Table IV: \"Interpretability\n",
    "of adaptive networks... existing tools assume fixed computation graphs\").\n",
    "This module's Grad-CAM explicitly recomputes the mask/gate for the specific\n",
    "input being explained, so it remains valid under adaptive routing.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "\n",
    "\n",
    "class GradCAM1D:\n",
    "    \"\"\"Grad-CAM adapted for a 1D-CNN backbone. Hooks the LAST stage's output\n",
    "    feature map (pre-pool) as the target layer, matching the standard\n",
    "    Grad-CAM recipe of using the final convolutional feature map.\"\"\"\n",
    "\n",
    "    def __init__(self, backbone, target_stage_index: int = -1):\n",
    "        self.backbone = backbone\n",
    "        self.target_stage_index = target_stage_index\n",
    "        self._activations = None\n",
    "        self._gradients = None\n",
    "        self._hook_handles = []\n",
    "\n",
    "    def _forward_hook(self, module, inp, out):\n",
    "        self._activations = out.detach()\n",
    "\n",
    "    def _backward_hook(self, module, grad_in, grad_out):\n",
    "        self._gradients = grad_out[0].detach()\n",
    "\n",
    "    def _register(self):\n",
    "        target_stage = self.backbone.stages[self.target_stage_index]\n",
    "        # hook the last block's activation (post-SE, pre-pool)\n",
    "        h1 = target_stage.register_forward_hook(self._forward_hook)\n",
    "        h2 = target_stage.register_full_backward_hook(self._backward_hook)\n",
    "        self._hook_handles = [h1, h2]\n",
    "\n",
    "    def _remove(self):\n",
    "        for h in self._hook_handles:\n",
    "            h.remove()\n",
    "        self._hook_handles = []\n",
    "\n",
    "    def compute(self, x: torch.Tensor, class_idx: int, masks=None) -> np.ndarray:\n",
    "        \"\"\"x: (1, leads, T). Returns a (T,) saliency curve, upsampled from\n",
    "        the target stage's temporal resolution back to the input length.\"\"\"\n",
    "        self.backbone.eval()\n",
    "        self._register()\n",
    "        try:\n",
    "            x = x.clone().requires_grad_(False)\n",
    "            logits = self.backbone(x, masks=masks)\n",
    "            score = logits[0, class_idx]\n",
    "            self.backbone.zero_grad(set_to_none=True)\n",
    "            score.backward()\n",
    "\n",
    "            weights = self._gradients.mean(dim=2, keepdim=True)   # (1, C, 1) global-average-pooled grad\n",
    "            cam = F.relu((weights * self._activations).sum(dim=1))  # (1, T')\n",
    "            cam = cam / (cam.max() + 1e-8)\n",
    "            cam_upsampled = F.interpolate(cam.unsqueeze(1), size=x.shape[-1],\n",
    "                                           mode=\"linear\", align_corners=False)\n",
    "            return cam_upsampled.squeeze().cpu().numpy()\n",
    "        finally:\n",
    "            self._remove()\n",
    "\n",
    "\n",
    "def integrated_gradients(model_forward_fn, x: torch.Tensor, class_idx: int,\n",
    "                          baseline: torch.Tensor | None = None, steps: int = 32) -> np.ndarray:\n",
    "    \"\"\"model_forward_fn: callable(x)->logits (already bound to the specific\n",
    "    mask/gate configuration to explain). x: (1, leads, T).\"\"\"\n",
    "    if baseline is None:\n",
    "        baseline = torch.zeros_like(x)\n",
    "    scaled_inputs = [baseline + (float(i) / steps) * (x - baseline) for i in range(steps + 1)]\n",
    "    grads = []\n",
    "    for scaled_x in scaled_inputs:\n",
    "        scaled_x = scaled_x.clone().requires_grad_(True)\n",
    "        logits = model_forward_fn(scaled_x)\n",
    "        score = logits[0, class_idx]\n",
    "        grad = torch.autograd.grad(score, scaled_x)[0]\n",
    "        grads.append(grad.detach())\n",
    "    avg_grad = torch.stack(grads[:-1]).mean(dim=0)  # trapezoidal-ish approx (left Riemann on interior points)\n",
    "    attributions = (x - baseline) * avg_grad\n",
    "    return attributions.squeeze(0).sum(dim=0).cpu().numpy()  # sum across leads -> (T,)\n"
   ]
  },
