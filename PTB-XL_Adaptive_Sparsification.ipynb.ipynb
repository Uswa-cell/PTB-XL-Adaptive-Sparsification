    "# ============================================================\n",
    "# SETUP: dependencies, environment, and safe multiprocessing\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import platform\n",
    "import subprocess\n",
    "import importlib.util\n",
    "import multiprocessing as mp\n",
    "from pathlib import Path\n",
    "\n",
    "# Install only non-PyTorch dependencies if they are missing.\n",
    "# PyTorch is intentionally NOT installed here so an existing CUDA/RTX build\n",
    "# is never overwritten by a CPU-only or incompatible wheel.\n",
    "_REQUIRED_PACKAGES = {\n",
    "    \"yaml\": \"pyyaml\",\n",
    "    \"wfdb\": \"wfdb\",\n",
    "    \"sklearn\": \"scikit-learn\",\n",
    "    \"scipy\": \"scipy\",\n",
    "    \"pandas\": \"pandas\",\n",
    "    \"matplotlib\": \"matplotlib\",\n",
    "    \"seaborn\": \"seaborn\",\n",
    "}\n",
    "\n",
    "_missing = [\n",
    "    pip_name\n",
    "    for import_name, pip_name in _REQUIRED_PACKAGES.items()\n",
    "    if importlib.util.find_spec(import_name) is None\n",
    "]\n",
    "\n",
    "if _missing:\n",
    "    print(\"Installing missing packages:\", \", \".join(_missing))\n",
    "    subprocess.check_call([\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"--quiet\",\n",
    "        *_missing,\n",
    "    ])\n",
    "else:\n",
    "    print(\"All non-PyTorch dependencies are already installed.\")\n",
    "\n",
    "import numpy as np\n",
    "import torch\n",
    "\n",
    "# Jupyter on Windows is most reliable with num_workers=0. On Linux/macOS,\n",
    "# a small worker pool avoids oversubscribing CPU/RAM while keeping GPU fed.\n",
    "if platform.system() == \"Windows\":\n",
    "    MP_START_METHOD = \"spawn\"\n",
    "    LOCAL_NUM_WORKERS = 0\n",
    "else:\n",
    "    MP_START_METHOD = \"fork\"\n",
    "    LOCAL_NUM_WORKERS = min(4, os.cpu_count() or 0)\n",
    "\n",
    "try:\n",
    "    mp.set_start_method(MP_START_METHOD, force=True)\n",
    "except RuntimeError:\n",
    "    pass\n",
    "\n",
    "print(\"=\" * 72)\n",
    "print(\"EXPERIMENT ENVIRONMENT\")\n",
    "print(\"=\" * 72)\n",
    "print(\"Python:\", sys.version.split()[0])\n",
    "print(\"OS:\", platform.platform())\n",
    "print(\"PyTorch:\", torch.__version__)\n",
    "print(\"CUDA build:\", torch.version.cuda)\n",
    "print(\"CUDA available:\", torch.cuda.is_available())\n",
    "if torch.cuda.is_available():\n",
    "    print(\"GPU:\", torch.cuda.get_device_name(0))\n",
    "    print(\n",
    "        \"VRAM (GB):\",\n",
    "        round(torch.cuda.get_device_properties(0).total_memory / 1024**3, 2),\n",
    "    )\n",
    "print(\"NumPy:\", np.__version__)\n",
    "print(\"Multiprocessing start method:\", MP_START_METHOD)\n",
    "print(\"DataLoader workers:\", LOCAL_NUM_WORKERS)\n",
    "print(\"=\" * 72)\n"
   ]
