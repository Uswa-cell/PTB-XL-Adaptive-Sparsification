    "# ---- from src/preprocessing/labels.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/preprocessing/labels.py\n",
    "------------------------------\n",
    "Converts PTB-XL's raw `scp_codes` (a dict of SCP-ECG statement -> likelihood,\n",
    "stored as a string in the metadata CSV) into a 5-dimensional multi-hot label\n",
    "vector over the diagnostic superclasses [NORM, MI, STTC, CD, HYP].\n",
    "\n",
    "This follows the official PTB-XL aggregation procedure described in\n",
    "Wagner et al. (2020) and used by the Strodthoff et al. (2021) benchmark:\n",
    "1. Keep only SCP statements flagged `diagnostic == 1` in scp_statements.csv.\n",
    "2. Map each statement to its `diagnostic_class` (one of the 5 superclasses).\n",
    "3. An ECG's label set is the UNION of superclasses reached by any of its\n",
    "   scp_codes (multilabel, not single-label) -- this is the key difference\n",
    "   from the original notebook, which kept only single-label records.\n",
    "4. Records that map to zero superclasses (non-diagnostic-only statements)\n",
    "   are dropped, since they carry no usable diagnostic supervision.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import ast\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def parse_scp_codes(x):\n",
    "    if isinstance(x, str):\n",
    "        return ast.literal_eval(x)\n",
    "    return x\n",
    "\n",
    "\n",
    "def build_diagnostic_mapping(scp_df: pd.DataFrame) -> dict:\n",
    "    \"\"\"scp_df: the scp_statements.csv loaded with index_col=0.\"\"\"\n",
    "    diagnostic = scp_df[scp_df[\"diagnostic\"] == 1]\n",
    "    return diagnostic[\"diagnostic_class\"].to_dict()\n",
    "\n",
    "\n",
    "def aggregate_superclasses(scp_dict: dict, diagnostic_mapping: dict, min_likelihood: float = 0) -> list[str]:\n",
    "    classes = []\n",
    "    for code, likelihood in scp_dict.items():\n",
    "        if code not in diagnostic_mapping:\n",
    "            continue\n",
    "        if likelihood is not None and likelihood < min_likelihood:\n",
    "            continue\n",
    "        cls = diagnostic_mapping[code]\n",
    "        if isinstance(cls, str):\n",
    "            classes.append(cls)\n",
    "    return sorted(set(classes))\n",
    "\n",
    "\n",
    "def add_multilabel_columns(df: pd.DataFrame, diagnostic_mapping: dict, superclasses: list[str],\n",
    "                            min_likelihood: float = 0) -> pd.DataFrame:\n",
    "    \"\"\"Adds a `diagnostic_superclass` column (list of strings) and one binary\n",
    "    column per superclass (e.g. `label_NORM`), plus a stacked `label_vector`\n",
    "    numpy column for direct use by the Dataset.\"\"\"\n",
    "    df = df.copy()\n",
    "    df[\"scp_codes\"] = df[\"scp_codes\"].apply(parse_scp_codes)\n",
    "    df[\"diagnostic_superclass\"] = df[\"scp_codes\"].apply(\n",
    "        lambda d: aggregate_superclasses(d, diagnostic_mapping, min_likelihood)\n",
    "    )\n",
    "    df = df[df[\"diagnostic_superclass\"].apply(len) > 0].copy()\n",
    "\n",
    "    for cls in superclasses:\n",
    "        df[f\"label_{cls}\"] = df[\"diagnostic_superclass\"].apply(lambda lst: int(cls in lst))\n",
    "\n",
    "    df[\"label_vector\"] = df[[f\"label_{c}\" for c in superclasses]].values.tolist()\n",
    "    return df\n"
   ]
  },
