     "text": [
      "Superclasses: ['NORM', 'MI', 'STTC', 'CD', 'HYP']\n",
      "Dataset root: /home/uswa/Downloads/PTBXL/ptb-xl-a-large-publicly-available-electrocardiography-dataset-1.0.3\n",
