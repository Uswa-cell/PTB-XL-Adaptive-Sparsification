   "source": [
    "# ============================================================\n",
    "# ROUTING BASELINES: random and confidence-based\n",
    "# Reuses the physical experts already trained inside adaptive_result[\"model\"],\n",
    "# only the assignment policy changes.\n",
    "# ============================================================\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate_with_custom_routing(\n",
    "    experts,\n",
    "    assign_fn,\n",
    "    loader,\n",
    "    device,\n",
    "    class_names,\n",
    "    energy_per_level,\n",
    "    num_classes,\n",
    "):\n",
    "    \"\"\"\n",
    "    assign_fn(signals, dense_out) -> LongTensor of shape (B,) with the\n",
    "    expert index to run for each sample in the batch. Executes true\n",
    "    conditional computation (only the assigned expert runs per sample),\n",
    "    exactly like AdaptiveECGClassifier.forward(hard=True).\n",
    "    \"\"\"\n",
    "    all_probs, all_labels, all_selected = [], [], []\n",
    "\n",
    "    for signals, labels in loader:\n",
    "        signals = signals.to(device, non_blocking=True)\n",
    "        labels = labels.to(device, non_blocking=True)\n",
    "\n",
    "        selected = assign_fn(signals).to(device)\n",
    "\n",
    "        logits = signals.new_empty((signals.size(0), num_classes))\n",
    "        for expert_idx, expert in enumerate(experts):\n",
    "            idx = (selected == expert_idx).nonzero(as_tuple=True)[0]\n",
    "            if idx.numel() == 0:\n",
    "                continue\n",
    "            logits.index_copy_(0, idx, expert(signals.index_select(0, idx)))\n",
    "\n",
    "        all_probs.append(torch.sigmoid(logits).cpu().numpy())\n",
    "        all_labels.append(labels.cpu().numpy())\n",
    "        all_selected.append(selected.cpu())\n",
    "\n",
    "    y_prob = np.concatenate(all_probs, axis=0)\n",
    "    y_true = np.concatenate(all_labels, axis=0)\n",
    "    selected_all = torch.cat(all_selected).numpy()\n",
    "\n",
    "    metrics = compute_full_metric_suite(y_true, y_prob, class_names)\n",
    "\n",
    "    energy_per_level_cpu = energy_per_level.detach().cpu().numpy()\n",
    "    mean_energy = float(energy_per_level_cpu[selected_all].mean())\n",
    "\n",
    "    return metrics, selected_all, mean_energy\n",
    "\n",
    "\n",
    "n_experts = len(adaptive_result[\"sparsity_levels\"])\n",
    "energy_per_level_baseline = adaptive_result[\"energy_per_level\"]\n",
    "\n",
    "# --- Random routing: uniform, input-independent ---\n",
    "_random_generator = torch.Generator().manual_seed(int(cfg.training.seed))\n",
    "\n",
    "def _random_assign(signals):\n",
    "    return torch.randint(\n",
    "        0, n_experts, (signals.size(0),), generator=_random_generator\n",
    "    )\n",
    "\n",
    "random_metrics, random_selected, random_energy = evaluate_with_custom_routing(\n",
    "    adaptive_result[\"model\"].experts,\n",
    "    _random_assign,\n",
    "    test_loader,\n",
    "    device,\n",
    "    cfg.task.superclasses,\n",
    "    energy_per_level_baseline,\n",
    "    num_classes=len(cfg.task.superclasses),\n",
    ")\n",
    "\n",
    "# --- Confidence-based routing: uses the DENSE model's own prediction\n",
    "# confidence as a cheap, non-learned difficulty proxy. Low confidence\n",
    "# (near 0.5) -> treated as \"hard\" -> routed to a higher-capacity expert.\n",
    "# Thresholds are quantiles of confidence computed on the VALIDATION set\n",
    "# only, so no test-set information leaks into the routing rule.\n",
    "dense_model.eval()\n",
    "\n",
    "@torch.no_grad()\n",
    "def _confidence_scores(loader):\n",
    "    scores = []\n",
    "    for signals, _ in loader:\n",
    "        signals = signals.to(device, non_blocking=True)\n",
    "        probs = torch.sigmoid(dense_model(signals))\n",
    "        confidence = (probs - 0.5).abs().mean(dim=1)  # high = confident/easy\n",
    "        scores.append(confidence.cpu())\n",
    "    return torch.cat(scores)\n",
    "\n",
    "val_confidence = _confidence_scores(val_loader)\n",
    "# n_experts - 1 cut points, easiest (most confident) -> cheapest expert\n",
    "conf_quantiles = torch.quantile(\n",
    "    val_confidence, torch.linspace(0, 1, n_experts + 1)[1:-1]\n",
    ")\n",
    "\n",
    "def _confidence_assign(signals):\n",
    "    probs = torch.sigmoid(dense_model(signals))\n",
    "    confidence = (probs - 0.5).abs().mean(dim=1).cpu()\n",
    "    # most confident (easy) samples get expert index 0 (cheapest)\n",
    "    selected = torch.zeros_like(confidence, dtype=torch.long)\n",
    "    for cut in conf_quantiles:\n",
    "        selected += (confidence < cut).long()\n",
    "    # invert: high confidence -> low expert index (cheap), so flip order\n",
    "    return (n_experts - 1) - selected\n",
    "\n",
    "confidence_metrics, confidence_selected, confidence_energy = evaluate_with_custom_routing(\n",
    "    adaptive_result[\"model\"].experts,\n",
    "    _confidence_assign,\n",
    "    test_loader,\n",
    "    device,\n",
    "    cfg.task.superclasses,\n",
    "    energy_per_level_baseline,\n",
    "    num_classes=len(cfg.task.superclasses),\n",
    ")\n",
    "\n",
    "routing_baselines_df = pd.DataFrame([\n",
    "    {\n",
    "        \"Routing policy\": \"Random\",\n",
    "        \"Macro-F1\": random_metrics[\"summary\"][\"f1_macro\"],\n",
    "        \"Macro-AUROC\": random_metrics[\"summary\"].get(\"auroc_macro\", np.nan),\n",
    "        \"Mean energy (nJ)\": random_energy,\n",
    "    },\n",
    "    {\n",
    "        \"Routing policy\": \"Confidence-based (dense model)\",\n",
    "        \"Macro-F1\": confidence_metrics[\"summary\"][\"f1_macro\"],\n",
    "        \"Macro-AUROC\": confidence_metrics[\"summary\"].get(\"auroc_macro\", np.nan),\n",
    "        \"Mean energy (nJ)\": confidence_energy,\n",
    "    },\n",
    "    {\n",
    "        \"Routing policy\": \"Learned adaptive gate (proposed)\",\n",
    "        \"Macro-F1\": adaptive_final_metrics[\"summary\"][\"f1_macro\"],\n",
    "        \"Macro-AUROC\": adaptive_final_metrics[\"summary\"].get(\"auroc_macro\", np.nan),\n",
    "        \"Mean energy (nJ)\": float(\n",
    "            adaptive_result[\"energy_per_level\"][routing_diagnostic[\"selected_expert\"]].mean()\n",
    "        ),\n",
    "    },\n",
    "])\n",
    "routing_baselines_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"routing_baselines_comparison.csv\"),\n",
    "    index=False,\n",
    ")\n",
    "display(routing_baselines_df)\n",
    "print(\n",
    "    \"If the learned gate does not dominate BOTH baselines on the \"\n",
    "    \"accuracy/energy trade-off, that is a genuine negative result worth \"\n",
    "    \"reporting honestly, not something to paper over.\"\n",
    ")\n"
   ]
