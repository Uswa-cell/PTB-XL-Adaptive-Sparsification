    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)\n",
    "    if deterministic:\n",
    "        torch.backends.cudnn.deterministic = True\n",
    "        torch.backends.cudnn.benchmark = False\n",
    "    else:\n",
    "        # benchmark=True is faster but not bit-exact reproducible; use for\n",
    "        # speed once the pipeline is validated, keep deterministic for the\n",
    "        # final reported numbers.\n",
    "        torch.backends.cudnn.benchmark = True\n",
    "    return seed\n"
