   "source": [
    "matched_sparsity = min(static_results.keys(), key=lambda s: abs(s - 0.6))\n",
    "static_model_for_compare = static_results[matched_sparsity][\"model\"]\n",
    "\n",
    "models_for_3way = {\n",
    "    \"Dense\": (dense_model, False, 100.0, 100.0),\n",
    "    f\"Static-{int(matched_sparsity*100)}%\": (\n",
    "        static_model_for_compare,\n",
    "        False,\n",
    "        static_results[matched_sparsity][\"flops_pct_of_dense\"],\n",
    "        static_results[matched_sparsity][\"energy_pct_of_dense\"],\n",
    "    ),\n",
    "    \"Adaptive\": (adaptive_result[\"model\"], True, None, None),\n",
    "}\n",
    "\n",
    "df_3way = three_way_comparison(\n",
    "    models_for_3way,\n",
    "    test_loader,\n",
    "    device,\n",
    "    cfg.task.superclasses,\n",
    "    cfg.paths.results_dir,\n",
    ")\n",
    "\n",
    "# Adaptive deployment-time MAC/energy values from REAL expert architectures.\n",
    "adaptive_model_eval = adaptive_result[\"model\"]\n",
    "adaptive_model_eval.eval()\n",
    "\n",
    "dense_macs = float(adaptive_result[\"dense_macs\"])\n",
    "dense_energy = float(adaptive_result[\"dense_energy\"])\n",
    "energy_per_level = adaptive_result[\"energy_per_level\"].float()\n",
    "macs_per_level = torch.tensor(\n",
    "    adaptive_result[\"expert_macs\"],\n",
    "    dtype=torch.float32,\n",
    ")\n",
    "\n",
    "all_prob, all_true, all_gate = [], [], []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for signals, labels in test_loader:\n",
    "        signals = signals.to(device, non_blocking=True)\n",
    "        out = adaptive_model_eval(signals, hard=True)\n",
    "\n",
    "        all_prob.append(\n",
    "            torch.sigmoid(out[\"logits\"]).cpu().numpy()\n",
    "        )\n",
    "        all_true.append(labels.numpy())\n",
    "        all_gate.append(out[\"gate_probs\"].cpu())\n",
    "\n",
    "y_prob = np.concatenate(all_prob, axis=0)\n",
    "y_true = np.concatenate(all_true, axis=0)\n",
    "gate_probs = torch.cat(all_gate, dim=0)\n",
    "\n",
    "adaptive_metrics = compute_full_metric_suite(\n",
    "    y_true,\n",
    "    y_prob,\n",
    "    cfg.task.superclasses,\n",
    ")[\"summary\"]\n",
    "\n",
    "# Hard routing -> one-hot gate_probs, therefore these are the average\n",
    "# computation/energy costs of the expert actually selected per ECG.\n",
    "expected_energy_nj = (\n",
    "    gate_probs @ energy_per_level\n",
    ").mean().item()\n",
    "\n",
    "expected_macs = (\n",
    "    gate_probs @ macs_per_level\n",
    ").mean().item()\n",
    "\n",
    "mask = df_3way[\"Model\"] == \"Adaptive\"\n",
    "\n",
    "df_3way.loc[mask, \"Accuracy (subset)\"] = adaptive_metrics[\"subset_accuracy\"]\n",
    "df_3way.loc[mask, \"Macro-F1\"] = adaptive_metrics[\"f1_macro\"]\n",
    "df_3way.loc[mask, \"Macro-AUROC\"] = adaptive_metrics[\"auroc_macro\"]\n",
    "df_3way.loc[mask, \"Macro-Sensitivity\"] = adaptive_metrics[\"sensitivity_macro\"]\n",
    "df_3way.loc[mask, \"Macro-Specificity\"] = adaptive_metrics[\"specificity_macro\"]\n",
    "df_3way.loc[mask, \"FLOPs (% of dense)\"] = 100.0 * expected_macs / max(dense_macs, 1.0)\n",
    "df_3way.loc[mask, \"Energy (% of dense, estimated)\"] = (\n",
    "    100.0 * expected_energy_nj / max(dense_energy, 1e-12)\n",
    ")\n",
    "\n",
    "# Re-save after filling adaptive deployment values.\n",
    "df_3way.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"three_way_comparison.csv\"),\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "df_3way\n"
   ]
  },
