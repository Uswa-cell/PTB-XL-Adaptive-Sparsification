    "# ============================================================\n",
    "# ADAPTIVE ROUTING DISTRIBUTION\n",
    "# ============================================================\n",
    "\n",
    "def analyze_expert_usage(\n",
    "    adaptive_model,\n",
    "    loader,\n",
    "    device,\n",
    "    sparsity_levels,\n",
    "    results_dir=None,\n",
    "):\n",
    "    adaptive_model.eval()\n",
    "    selections = []\n",
    "    difficulties = []\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for signals, _ in loader:\n",
    "            signals = signals.to(device, non_blocking=True)\n",
    "            output = adaptive_model(signals, hard=True)\n",
    "            selections.append(output[\"selected_expert\"].detach().cpu())\n",
    "            difficulties.append(output[\"difficulty\"].detach().cpu())\n",
    "\n",
    "    selections = torch.cat(selections).numpy()\n",
    "    difficulties = torch.cat(difficulties).numpy()\n",
    "\n",
    "    rows = []\n",
    "    n_samples = len(selections)\n",
    "    for expert_idx, sparsity in enumerate(sparsity_levels):\n",
    "        mask = selections == expert_idx\n",
    "        count = int(mask.sum())\n",
    "        rows.append({\n",
    "            \"Expert\": expert_idx,\n",
    "            \"Target sparsity\": float(sparsity),\n",
    "            \"Samples\": count,\n",
    "            \"Routing (%)\": 100.0 * count / max(n_samples, 1),\n",
    "            \"Mean difficulty\": (\n",
    "                float(difficulties[mask].mean()) if count > 0 else np.nan\n",
    "            ),\n",
    "        })\n",
    "\n",
    "    df = pd.DataFrame(rows)\n",
    "    if results_dir is not None:\n",
    "        df.to_csv(\n",
    "            os.path.join(results_dir, \"adaptive_routing_distribution.csv\"),\n",
    "            index=False,\n",
    "        )\n",
    "    return df, selections, difficulties\n",
    "\n",
    "\n",
    "routing_df, expert_usage, test_difficulties = analyze_expert_usage(\n",
    "    adaptive_model=adaptive_model,\n",
    "    loader=test_loader,\n",
    "    device=device,\n",
    "    sparsity_levels=adaptive_result[\"sparsity_levels\"],\n",
    "    results_dir=cfg.paths.results_dir,\n",
    ")\n",
    "\n",
    "display(routing_df)\n",
    "\n",
    "max_routing_fraction = routing_df[\"Routing (%)\"].max()\n",
    "if max_routing_fraction > 90.0:\n",
    "    print(\"WARNING: hard routing is heavily concentrated in one expert.\")\n",
    "else:\n",
    "    print(\"Routing uses multiple experts without severe (>90%) collapse.\")\n"
   ]
  },
