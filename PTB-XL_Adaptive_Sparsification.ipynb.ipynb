   "source": [
    "# ---- corrected structured pruning utilities ----\n",
    "from __future__ import annotations\n",
    "import copy\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def l1_channel_importance(stage) -> torch.Tensor:\n",
    "    \"\"\"L1 importance of each stage output channel.\"\"\"\n",
    "    last_block = stage.blocks[-1]\n",
    "    w = last_block.conv2.weight.data\n",
    "    return w.abs().sum(dim=(1, 2))\n",
    "\n",
    "\n",
    "def _rounded_keep_count(c_out: int, sparsity: float, multiple_of: int = 8) -> int:\n",
    "    \"\"\"Hardware-friendly number of channels to retain.\"\"\"\n",
    "    raw = max(1, int(round(c_out * (1.0 - sparsity))))\n",
    "    if c_out >= multiple_of:\n",
    "        raw = max(multiple_of, int(round(raw / multiple_of)) * multiple_of)\n",
    "    return min(c_out, raw)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def select_stage_channels(\n",
    "    dense_model: nn.Module,\n",
    "    sparsity: float,\n",
    "    multiple_of: int = 8,\n",
    ") -> list[torch.Tensor]:\n",
    "    \"\"\"Return original dense-channel indices retained in every stage.\"\"\"\n",
    "    keep_indices = []\n",
    "    for stage in dense_model.stages:\n",
    "        importance = l1_channel_importance(stage)\n",
    "        n_keep = _rounded_keep_count(stage.c_out, sparsity, multiple_of)\n",
    "        idx = torch.topk(importance, n_keep).indices.sort().values\n",
    "        keep_indices.append(idx)\n",
    "    return keep_indices\n",
    "\n",
    "\n",
    "def channels_for_sparsity(\n",
    "    base_channels,\n",
    "    sparsity: float,\n",
    "    minimum_channels: int = 8,\n",
    "    multiple_of: int = 8,\n",
    "):\n",
    "    \"\"\"Channel-width helper used for reporting / standalone expert creation.\"\"\"\n",
    "    channels = []\n",
    "    for c in base_channels:\n",
    "        keep = max(minimum_channels, int(round(c * (1.0 - sparsity))))\n",
    "        keep = max(minimum_channels, int(round(keep / multiple_of)) * multiple_of)\n",
    "        channels.append(min(c, keep))\n",
    "    return tuple(channels)\n",
    "\n",
    "\n",
    "def build_sparse_expert(\n",
    "    num_classes: int,\n",
    "    sparsity: float,\n",
    "    in_leads: int = 12,\n",
    "    stem_channels: int = 32,\n",
    "    base_channels=(32, 64, 128, 256),\n",
    "    block_depth: int = 2,\n",
    "    se_reduction: int = 8,\n",
    "    dropout: float = 0.5,\n",
    "):\n",
    "    \"\"\"Build a physically smaller expert. Prefer build_pruned_expert_from_dense\n",
    "    when a trained dense model is available, because it warm-starts the expert.\"\"\"\n",
    "    block_channels = channels_for_sparsity(base_channels, sparsity)\n",
    "    return ECGBackbone(\n",
    "        num_classes=num_classes,\n",
    "        in_leads=in_leads,\n",
    "        stem_channels=stem_channels,\n",
    "        block_channels=block_channels,\n",
    "        block_depth=block_depth,\n",
    "        se_reduction=se_reduction,\n",
    "        dropout=dropout,\n",
    "        multilabel=True,\n",
    "    )\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def _copy_bn_subset(dst_bn, src_bn, idx):\n",
    "    idx = idx.to(src_bn.weight.device)\n",
    "    dst_bn.weight.copy_(src_bn.weight[idx])\n",
    "    dst_bn.bias.copy_(src_bn.bias[idx])\n",
    "    dst_bn.running_mean.copy_(src_bn.running_mean[idx])\n",
    "    dst_bn.running_var.copy_(src_bn.running_var[idx])\n",
    "    dst_bn.num_batches_tracked.copy_(src_bn.num_batches_tracked)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def _set_selector_shortcut(shortcut, input_indices, output_source_indices):\n",
    "    \"\"\"\n",
    "    Initialize a new 1x1 shortcut as a channel selector. Used when the dense\n",
    "    source stage had an identity shortcut but the physically slim stage needs\n",
    "    a projection because its width changed.\n",
    "    \"\"\"\n",
    "    conv, bn = shortcut[0], shortcut[1]\n",
    "    conv.weight.zero_()\n",
    "    input_lookup = {int(src_idx): pos for pos, src_idx in enumerate(input_indices.tolist())}\n",
    "    for out_pos, src_idx in enumerate(output_source_indices.tolist()):\n",
    "        if int(src_idx) in input_lookup:\n",
    "            conv.weight[out_pos, input_lookup[int(src_idx)], 0] = 1.0\n",
    "    bn.weight.fill_(1.0)\n",
    "    bn.bias.zero_()\n",
    "    bn.running_mean.zero_()\n",
    "    bn.running_var.fill_(1.0)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def build_pruned_expert_from_dense(\n",
    "    dense_model: nn.Module,\n",
    "    sparsity: float,\n",
    "    se_reduction: int = 8,\n",
    "    multiple_of: int = 8,\n",
    ") -> nn.Module:\n",
    "    \"\"\"\n",
    "    Create a PHYSICALLY SMALLER ECGBackbone and warm-start it by slicing the\n",
    "    trained dense model's most important channels.\n",
    "\n",
    "    This is structured channel pruning rather than post-convolution masking:\n",
    "    the smaller Conv1d tensors are genuinely instantiated and therefore the\n",
    "    corresponding convolution work is not executed.\n",
    "    \"\"\"\n",
    "    if sparsity <= 0:\n",
    "        return copy.deepcopy(dense_model)\n",
    "\n",
    "    keep = select_stage_channels(dense_model, sparsity, multiple_of=multiple_of)\n",
    "    new_channels = tuple(int(idx.numel()) for idx in keep)\n",
    "\n",
    "    in_leads = dense_model.stem[0].in_channels\n",
    "    stem_channels = dense_model.stem[0].out_channels\n",
    "    num_classes = dense_model.classifier[-1].out_features\n",
    "    block_depth = len(dense_model.stages[0].blocks)\n",
    "    dropout = next(\n",
    "        (m.p for m in dense_model.classifier.modules() if isinstance(m, nn.Dropout)),\n",
    "        0.5,\n",
    "    )\n",
    "\n",
    "    slim = ECGBackbone(\n",
    "        num_classes=num_classes,\n",
    "        in_leads=in_leads,\n",
    "        stem_channels=stem_channels,\n",
    "        block_channels=new_channels,\n",
    "        block_depth=block_depth,\n",
    "        se_reduction=se_reduction,\n",
    "        dropout=dropout,\n",
    "        multilabel=True,\n",
    "    ).to(next(dense_model.parameters()).device)\n",
    "\n",
    "    # Stem width is unchanged.\n",
    "    slim.stem.load_state_dict(copy.deepcopy(dense_model.stem.state_dict()))\n",
    "\n",
    "    prev_src_idx = torch.arange(stem_channels, device=next(dense_model.parameters()).device)\n",
    "\n",
    "    for stage_i, (src_stage, dst_stage) in enumerate(zip(dense_model.stages, slim.stages)):\n",
    "        out_src_idx = keep[stage_i].to(prev_src_idx.device)\n",
    "\n",
    "        for block_i, (src_blk, dst_blk) in enumerate(zip(src_stage.blocks, dst_stage.blocks)):\n",
    "            in_src_idx = prev_src_idx if block_i == 0 else out_src_idx\n",
    "\n",
    "            # Main path.\n",
    "            dst_blk.conv1.weight.copy_(\n",
    "                src_blk.conv1.weight[out_src_idx][:, in_src_idx, :]\n",
    "            )\n",
    "            _copy_bn_subset(dst_blk.bn1, src_blk.bn1, out_src_idx)\n",
    "\n",
    "            dst_blk.conv2.weight.copy_(\n",
    "                src_blk.conv2.weight[out_src_idx][:, out_src_idx, :]\n",
    "            )\n",
    "            _copy_bn_subset(dst_blk.bn2, src_blk.bn2, out_src_idx)\n",
    "\n",
    "            # SE block. Hidden dimension may shrink, so preserve the leading\n",
    "            # hidden units while slicing the retained channel dimensions.\n",
    "            src_fc1, src_fc2 = src_blk.se.fc[0], src_blk.se.fc[2]\n",
    "            dst_fc1, dst_fc2 = dst_blk.se.fc[0], dst_blk.se.fc[2]\n",
    "            h = min(dst_fc1.out_features, src_fc1.out_features)\n",
    "\n",
    "            dst_fc1.weight.zero_()\n",
    "            dst_fc1.bias.zero_()\n",
    "            dst_fc1.weight[:h].copy_(src_fc1.weight[:h, out_src_idx])\n",
    "            dst_fc1.bias[:h].copy_(src_fc1.bias[:h])\n",
    "\n",
    "            dst_fc2.weight.zero_()\n",
    "            dst_fc2.bias.copy_(src_fc2.bias[out_src_idx])\n",
    "            dst_fc2.weight[:, :h].copy_(src_fc2.weight[out_src_idx, :h])\n",
    "\n",
    "            # Residual shortcut.\n",
    "            if dst_blk.shortcut is not None:\n",
    "                if src_blk.shortcut is not None:\n",
    "                    src_sc_conv, src_sc_bn = src_blk.shortcut[0], src_blk.shortcut[1]\n",
    "                    dst_sc_conv, dst_sc_bn = dst_blk.shortcut[0], dst_blk.shortcut[1]\n",
    "                    dst_sc_conv.weight.copy_(\n",
    "                        src_sc_conv.weight[out_src_idx][:, in_src_idx, :]\n",
    "                    )\n",
    "                    _copy_bn_subset(dst_sc_bn, src_sc_bn, out_src_idx)\n",
    "                else:\n",
    "                    _set_selector_shortcut(dst_blk.shortcut, in_src_idx, out_src_idx)\n",
    "\n",
    "        prev_src_idx = out_src_idx\n",
    "\n",
    "    # Classifier: retained final channels feed the same hidden/output layers.\n",
    "    final_idx = keep[-1].to(next(dense_model.parameters()).device)\n",
    "    slim.classifier[1].weight.copy_(dense_model.classifier[1].weight[:, final_idx])\n",
    "    slim.classifier[1].bias.copy_(dense_model.classifier[1].bias)\n",
    "    slim.classifier[4].load_state_dict(copy.deepcopy(dense_model.classifier[4].state_dict()))\n",
    "\n",
    "    return slim\n",
    "\n",
    "\n",
    "def actual_channel_sparsity(model: nn.Module, dense_model: nn.Module) -> float:\n",
    "    dense = sum(stage.c_out for stage in dense_model.stages)\n",
    "    active = sum(stage.c_out for stage in model.stages)\n",
    "    return 1.0 - active / max(dense, 1)\n"
   ]
  },
