   "source": [
    "## Preprocessing — signal filtering, augmentation, SCP-to-multilabel mapping"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "9d93b351",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "# ---- from src/preprocessing/signal_processing.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/preprocessing/signal_processing.py\n",
    "----------------------------------------\n",
    "Standard, scientifically-accepted ECG preprocessing. As noted in config.yaml,\n",
    "none of this is specified by the sparsification literature review (it is out\n",
    "of that review's scope); the methods below follow well-established ECG\n",
    "signal-processing practice used throughout the PTB-XL benchmark literature\n",
    "(Wagner et al. 2020) and standard biomedical DSP practice:\n",
    "\n",
    "  - Baseline wander removal: high-pass / detrending to remove the slow\n",
    "    (<0.5 Hz) drift caused by respiration and electrode motion.\n",
    "  - Bandpass filtering (0.5-40 Hz): removes baseline wander AND high-frequency\n",
    "    noise (muscle artifact, powerline interference) while preserving the\n",
    "    diagnostically relevant QRS/ST-T morphology, which is the standard band\n",
    "    used in clinical ECG digital filtering guidelines (AHA/ACC/HRS\n",
    "    recommendations for diagnostic ECG bandwidth).\n",
    "  - Z-score normalization: per-lead standardization, standard practice for\n",
    "    deep-learning ECG models (Hannun et al. 2019; Strodthoff et al. 2021) to\n",
    "    remove amplitude-scale differences across recordings/devices.\n",
    "\n",
    "All filters use zero-phase (`filtfilt`) Butterworth IIR filters, which avoid\n",
    "the phase distortion that would corrupt QRS-complex timing under a causal\n",
    "filter -- important because this pipeline's difficulty estimator explicitly\n",
    "uses signal timing statistics.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import numpy as np\n",
    "from scipy.signal import butter, filtfilt\n",
    "\n",
    "\n",
    "def _butter_filter(data: np.ndarray, cutoff, fs: float, btype: str, order: int = 3) -> np.ndarray:\n",
    "    nyq = 0.5 * fs\n",
    "    if isinstance(cutoff, (list, tuple)):\n",
    "        norm_cutoff = [c / nyq for c in cutoff]\n",
    "    else:\n",
    "        norm_cutoff = cutoff / nyq\n",
    "    b, a = butter(order, norm_cutoff, btype=btype)\n",
    "    # filtfilt along the time axis (last axis); data shape (leads, time)\n",
    "    return filtfilt(b, a, data, axis=-1)\n",
    "\n",
    "\n",
    "def remove_baseline_wander(signal: np.ndarray, fs: float, cutoff_hz: float = 0.5, order: int = 3) -> np.ndarray:\n",
    "    \"\"\"High-pass filter to remove baseline wander. signal: (leads, time).\"\"\"\n",
    "    return _butter_filter(signal, cutoff_hz, fs, btype=\"highpass\", order=order)\n",
    "\n",
    "\n",
    "def bandpass_filter(signal: np.ndarray, fs: float, low_hz: float = 0.5, high_hz: float = 40.0,\n",
    "                     order: int = 3) -> np.ndarray:\n",
    "    return _butter_filter(signal, [low_hz, high_hz], fs, btype=\"bandpass\", order=order)\n",
    "\n",
    "\n",
    "def zscore_normalize(signal: np.ndarray, eps: float = 1e-8) -> np.ndarray:\n",
    "    \"\"\"Per-lead z-score normalization. signal: (leads, time).\"\"\"\n",
    "    mean = signal.mean(axis=-1, keepdims=True)\n",
    "    std = signal.std(axis=-1, keepdims=True)\n",
    "    return (signal - mean) / (std + eps)\n",
    "\n",
    "\n",
    "def minmax_normalize(signal: np.ndarray, eps: float = 1e-8) -> np.ndarray:\n",
    "    mn = signal.min(axis=-1, keepdims=True)\n",
    "    mx = signal.max(axis=-1, keepdims=True)\n",
    "    return (signal - mn) / (mx - mn + eps)\n",
    "\n",
    "\n",
    "def preprocess_ecg(signal: np.ndarray, fs: float, cfg) -> np.ndarray:\n",
    "    \"\"\"Full preprocessing chain driven by config.yaml's `preprocessing` block.\n",
    "    signal: (leads, time) raw waveform as loaded by wfdb.\"\"\"\n",
    "    out = signal.astype(np.float32)\n",
    "\n",
    "    if cfg.remove_baseline_wander:\n",
    "        out = bandpass_filter(out, fs, cfg.bandpass_low_hz, cfg.bandpass_high_hz, cfg.filter_order)\n",
    "    # (bandpass filtering subsumes standalone baseline-wander removal since\n",
    "    # its low cutoff already removes sub-0.5Hz drift; kept as one filter\n",
    "    # call to avoid the numerical artefacts of cascading two IIR filters.)\n",
    "\n",
    "    if cfg.normalize == \"zscore\":\n",
    "        out = zscore_normalize(out)\n",
    "    elif cfg.normalize == \"minmax\":\n",
    "        out = minmax_normalize(out)\n",
    "    # \"none\" -> leave as-is\n",
    "\n",
    "    return out\n",
    "\n",
    "\n",
    "def detect_corrupted_signal(signal: np.ndarray, flatline_std_threshold: float = 1e-6,\n",
    "                             max_abs_amplitude_mv: float = 15.0) -> bool:\n",
    "    \"\"\"Heuristic corrupted/invalid-record detector, used by the Dataset class\n",
    "    to skip unreadable or physiologically implausible recordings (flatlined\n",
    "    leads, saturated/clipped amplitude far outside plausible ECG range).\"\"\"\n",
    "    if np.isnan(signal).any() or np.isinf(signal).any():\n",
    "        return True\n",
    "    per_lead_std = signal.std(axis=-1)\n",
    "    if (per_lead_std < flatline_std_threshold).all():\n",
    "        return True  # every lead is flat -> dead recording\n",
    "    if np.abs(signal).max() > max_abs_amplitude_mv:\n",
    "        return True  # implausible amplitude -> likely corrupted/saturated\n",
    "    return False\n"
   ]
  },
