   "source": [
    "# ---- from src/experiments/run_multiseed.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/experiments/run_multiseed.py\n",
    "--------------------------------------\n",
    "Runs a given experiment function across N seeds and aggregates results as\n",
    "mean +/- std, per config.training.n_seeds_for_final_report. Used to produce\n",
    "the seed-robust numbers required before any statistical comparison is\n",
    "meaningful (Section 3.3 / advancement plan: \"run 3-5 seeds and report mean\n",
    "+/- std for every headline number\").\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def run_multiseed(experiment_fn, n_seeds: int, metric_key: str = \"f1_macro\", **experiment_kwargs):\n",
    "    \"\"\"experiment_fn(seed, **experiment_kwargs) -> dict with a \"test_metrics\"\n",
    "    entry containing {\"summary\": {...}}. Returns the raw per-seed metric\n",
    "    array plus mean/std, ready for src.evaluation.statistics.compare_models.\"\"\"\n",
    "    scores = []\n",
    "    all_results = []\n",
    "    for seed in range(n_seeds):\n",
    "        set_seed(seed)\n",
    "        result = experiment_fn(seed=seed, **experiment_kwargs)\n",
    "        score = result[\"test_metrics\"][\"summary\"][metric_key]\n",
    "        scores.append(score)\n",
    "        all_results.append(result)\n",
    "    scores = np.array(scores)\n",
    "    return {\n",
    "        \"scores\": scores,\n",
    "        \"mean\": float(scores.mean()),\n",
    "        \"std\": float(scores.std(ddof=1)) if len(scores) > 1 else 0.0,\n",
    "        \"all_results\": all_results,\n",
    "    }\n"
   ]
  },
