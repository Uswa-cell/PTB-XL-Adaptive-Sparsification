    "# ---- corrected trainer.py ----\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# EARLY STOPPING\n",
    "# ============================================================\n",
    "\n",
    "class EarlyStopper:\n",
    "    def __init__(\n",
    "        self,\n",
    "        patience: int,\n",
    "        mode: str = \"max\"\n",
    "    ):\n",
    "        self.patience = patience\n",
    "        self.mode = mode\n",
    "\n",
    "        self.best = (\n",
    "            -np.inf\n",
    "            if mode == \"max\"\n",
    "            else np.inf\n",
    "        )\n",
    "\n",
    "        self.counter = 0\n",
    "        self.should_stop = False\n",
    "\n",
    "    def step(\n",
    "        self,\n",
    "        value: float\n",
    "    ) -> bool:\n",
    "\n",
    "        improved = (\n",
    "            value > self.best\n",
    "            if self.mode == \"max\"\n",
    "            else value < self.best\n",
    "        )\n",
    "\n",
    "        if improved:\n",
    "            self.best = value\n",
    "            self.counter = 0\n",
    "\n",
    "        else:\n",
    "            self.counter += 1\n",
    "\n",
    "            if self.counter >= self.patience:\n",
    "                self.should_stop = True\n",
    "\n",
    "        return improved\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# SAVE CHECKPOINT\n",
    "# ============================================================\n",
    "\n",
    "def save_checkpoint(\n",
    "    path,\n",
    "    model,\n",
    "    optimizer,\n",
    "    scheduler,\n",
    "    epoch,\n",
    "    best_metric\n",
    "):\n",
    "    Path(path).parent.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "    torch.save(\n",
    "        {\n",
    "            \"epoch\": epoch,\n",
    "\n",
    "            \"model_state\":\n",
    "                model.state_dict(),\n",
    "\n",
    "            \"optimizer_state\":\n",
    "                (\n",
    "                    optimizer.state_dict()\n",
    "                    if optimizer is not None\n",
    "                    else None\n",
    "                ),\n",
    "\n",
    "            \"scheduler_state\":\n",
    "                (\n",
    "                    scheduler.state_dict()\n",
    "                    if scheduler is not None\n",
    "                    else None\n",
    "                ),\n",
    "\n",
    "            \"best_metric\":\n",
    "                best_metric,\n",
    "        },\n",
    "        path\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# LOAD CHECKPOINT\n",
    "# ============================================================\n",
    "\n",
    "def load_checkpoint(\n",
    "    path,\n",
    "    model,\n",
    "    optimizer=None,\n",
    "    scheduler=None,\n",
    "    map_location=\"cpu\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Load an existing checkpoint.\n",
    "\n",
    "    strict=False is intentional because older adaptive checkpoints\n",
    "    were saved before calibrated routing_thresholds were added to\n",
    "    AdaptiveECGClassifier.\n",
    "\n",
    "    Missing routing_thresholds are safe because they will be calibrated\n",
    "    later using the validation set.\n",
    "    \"\"\"\n",
    "\n",
    "    ckpt = torch.load(\n",
    "        path,\n",
    "        map_location=map_location\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Backward-compatible model loading\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    incompatible = model.load_state_dict(\n",
    "        ckpt[\"model_state\"],\n",
    "        strict=False\n",
    "    )\n",
    "\n",
    "    missing_keys = list(\n",
    "        incompatible.missing_keys\n",
    "    )\n",
    "\n",
    "    unexpected_keys = list(\n",
    "        incompatible.unexpected_keys\n",
    "    )\n",
    "\n",
    "    if missing_keys:\n",
    "        print(\n",
    "            \"Checkpoint missing model keys:\",\n",
    "            missing_keys\n",
    "        )\n",
    "\n",
    "    if unexpected_keys:\n",
    "        print(\n",
    "            \"Checkpoint unexpected model keys:\",\n",
    "            unexpected_keys\n",
    "        )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Optimizer\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if (\n",
    "        optimizer is not None\n",
    "        and ckpt.get(\"optimizer_state\") is not None\n",
    "    ):\n",
    "        try:\n",
    "            optimizer.load_state_dict(\n",
    "                ckpt[\"optimizer_state\"]\n",
    "            )\n",
    "\n",
    "        except (ValueError, RuntimeError) as exc:\n",
    "            print(\n",
    "                \"Warning: optimizer state could not be restored.\"\n",
    "            )\n",
    "            print(\n",
    "                \"Model weights were loaded successfully.\"\n",
    "            )\n",
    "            print(\n",
    "                \"Optimizer warning:\",\n",
    "                exc\n",
    "            )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Scheduler\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if (\n",
    "        scheduler is not None\n",
    "        and ckpt.get(\"scheduler_state\") is not None\n",
    "    ):\n",
    "        try:\n",
    "            scheduler.load_state_dict(\n",
    "                ckpt[\"scheduler_state\"]\n",
    "            )\n",
    "\n",
    "        except (ValueError, RuntimeError) as exc:\n",
    "            print(\n",
    "                \"Warning: scheduler state could not be restored.\"\n",
    "            )\n",
    "            print(\n",
    "                \"Scheduler warning:\",\n",
    "                exc\n",
    "            )\n",
    "\n",
    "    epoch = ckpt.get(\n",
    "        \"epoch\",\n",
    "        0\n",
    "    )\n",
    "\n",
    "    best_metric = ckpt.get(\n",
    "        \"best_metric\",\n",
    "        -np.inf\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        epoch,\n",
    "        best_metric\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# ANTI-COLLAPSE REGULARIZERS (fix for 100%->single-expert collapse)\n",
    "#\n",
    "# Root cause (see Phase-1 audit): the energy term below was a ONE-SIDED\n",
    "# hinge, clamp(expected_energy - energy_budget, min=0.0). Once the gate\n",
    "# settles on any expert whose expected energy is already <= energy_budget,\n",
    "# d(loss)/d(gate_probs) from the energy term is EXACTLY ZERO — nothing in\n",
    "# the objective any longer distinguishes routing an easy sample to the\n",
    "# 90%-sparse expert from routing it to the 30%-sparse expert, as long as\n",
    "# both stay under budget. Task loss alone then pulls every sample toward\n",
    "# whichever single expert has the best accuracy/capacity trade-off (empirically\n",
    "# the 30%-sparse expert, whose ~0.49x dense MACs sits just under the 0.5x\n",
    "# budget). The two regularizers below restore a gradient signal that (a)\n",
    "# actually depends on per-sample difficulty and (b) discourages the gate\n",
    "# from collapsing onto one expert for every sample, WITHOUT hand-fixing the\n",
    "# routing distribution to a fixed quota.\n",
    "# ============================================================\n",
    "\n",
    "def pairwise_difficulty_consistency_loss(\n",
    "    difficulty: torch.Tensor,\n",
    "    proxy_loss: torch.Tensor,\n",
    "    margin: float = 0.05,\n",
    ") -> torch.Tensor:\n",
    "    \"\"\"\n",
    "    Monotonicity / difficulty-consistency loss.\n",
    "\n",
    "    `proxy_loss` is a per-sample, unreduced task-loss proxy (detached) that\n",
    "    is a standard cheap difficulty signal: samples the model currently finds\n",
    "    harder to classify have higher per-sample loss. This is NOT the ground\n",
    "    truth label of \"difficulty\" (none exists for PTB-XL) — it is used only\n",
    "    as a relative ranking target within each batch.\n",
    "\n",
    "    For every pair (i, j) in the batch we ask: whichever sample has the\n",
    "    higher proxy_loss should also receive the higher predicted `difficulty`.\n",
    "    This is a standard pairwise/RankNet-style ranking loss and gives the\n",
    "    DifficultyEstimator a direct, always-on gradient that depends on the\n",
    "    actual sample, instead of relying entirely on the indirect and\n",
    "    frequently-zero energy-hinge gradient.\n",
    "    \"\"\"\n",
    "    proxy_loss = proxy_loss.detach()\n",
    "\n",
    "    proxy_diff = proxy_loss.unsqueeze(1) - proxy_loss.unsqueeze(0)   # (B, B)\n",
    "    difficulty_diff = difficulty.unsqueeze(1) - difficulty.unsqueeze(0)  # (B, B)\n",
    "\n",
    "    target_sign = torch.sign(proxy_diff)\n",
    "\n",
    "    # Only rank pairs whose proxy losses are meaningfully different; pairs\n",
    "    # that are ~tied carry no reliable ordering information.\n",
    "    valid = proxy_diff.abs() > 1e-4\n",
    "\n",
    "    if valid.sum() == 0:\n",
    "        return difficulty.new_zeros(())\n",
    "\n",
    "    pair_loss = torch.relu(margin - target_sign * difficulty_diff)\n",
    "    return pair_loss[valid].mean()\n",
    "\n",
    "\n",
    "def load_balance_loss(gate_probs: torch.Tensor) -> torch.Tensor:\n",
    "    \"\"\"\n",
    "    Shazeer et al. (2017), \"Outrageously Large Neural Networks: The\n",
    "    Sparsely-Gated Mixture-of-Experts Layer\" — importance/load-balancing\n",
    "    loss, squared coefficient of variation of summed soft gate probability\n",
    "    per expert across the batch.\n",
    "\n",
    "    This is deliberately NOT a fixed 25/25/25/25 target: it is zero whenever\n",
    "    batch usage happens to already be balanced (uniform OR any other\n",
    "    distribution the data justify would only be penalized if it becomes\n",
    "    extremely skewed), and it only discourages the degenerate case where a\n",
    "    single expert absorbs (near) 100% of probability mass for every batch,\n",
    "    which is what enables full collapse.\n",
    "    \"\"\"\n",
    "    importance = gate_probs.sum(dim=0)  # (n_experts,)\n",
    "    cv = importance.std(unbiased=False) / (importance.mean() + 1e-8)\n",
    "    return cv.pow(2)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# TRAINER\n",
    "# ============================================================\n",
    "\n",
    "class Trainer:\n",
    "    def __init__(\n",
    "        self,\n",
    "        model: nn.Module,\n",
    "        optimizer,\n",
    "        scheduler,\n",
    "        loss_fn,\n",
    "        device,\n",
    "        class_names: list[str],\n",
    "        run_name: str,\n",
    "        results_dir: str = \"results\",\n",
    "        weights_dir: str = \"weights\",\n",
    "        grad_clip_norm: float = 5.0,\n",
    "        mixed_precision: bool = True,\n",
    "        energy_aware: bool = False,\n",
    "        energy_per_level: torch.Tensor | None = None,\n",
    "        energy_budget: float | None = None,\n",
    "        energy_lambda: float = 0.05,\n",
    "        consistency_lambda: float = 0.15,\n",
    "        balance_lambda: float = 0.05,\n",
    "    ):\n",
    "\n",
    "        self.model = model.to(\n",
    "            device\n",
    "        )\n",
    "\n",
    "        self.optimizer = optimizer\n",
    "        self.scheduler = scheduler\n",
    "        self.loss_fn = loss_fn\n",
    "        self.device = device\n",
    "        self.class_names = class_names\n",
    "        self.run_name = run_name\n",
    "        self.weights_dir = weights_dir\n",
    "        self.grad_clip_norm = grad_clip_norm\n",
    "\n",
    "        self.mixed_precision = (\n",
    "            mixed_precision\n",
    "            and device.type == \"cuda\"\n",
    "        )\n",
    "\n",
    "        self.scaler = torch.amp.GradScaler(\n",
    "            enabled=self.mixed_precision\n",
    "        )\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Energy-aware adaptive training\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        self.energy_aware = energy_aware\n",
    "\n",
    "        self.energy_per_level = (\n",
    "            energy_per_level.to(device)\n",
    "            if energy_per_level is not None\n",
    "            else None\n",
    "        )\n",
    "\n",
    "        self.energy_budget = energy_budget\n",
    "        self.energy_lambda = energy_lambda\n",
    "        self.consistency_lambda = consistency_lambda\n",
    "        self.balance_lambda = balance_lambda\n",
    "\n",
    "        self.logger = get_logger(\n",
    "            run_name\n",
    "        )\n",
    "\n",
    "        self.metric_logger = MetricLogger(\n",
    "            run_name,\n",
    "            results_dir\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # FORWARD BATCH\n",
    "    # ========================================================\n",
    "\n",
    "    def _forward_batch(\n",
    "        self,\n",
    "        signals,\n",
    "        labels,\n",
    "        hard_routing: bool = False\n",
    "    ):\n",
    "\n",
    "        if self.energy_aware:\n",
    "\n",
    "            out = self.model(\n",
    "                signals,\n",
    "                hard=hard_routing\n",
    "            )\n",
    "\n",
    "            logits = out[\n",
    "                \"logits\"\n",
    "            ]\n",
    "\n",
    "            task_loss = self.loss_fn(\n",
    "                logits,\n",
    "                labels\n",
    "            )\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Training:\n",
    "            # use differentiable expected energy.\n",
    "            #\n",
    "            # Evaluation:\n",
    "            # loss calculation can still use expected energy;\n",
    "            # final reported deployment energy should use\n",
    "            # selected_expert separately.\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            with torch.amp.autocast(\n",
    "                device_type=self.device.type,\n",
    "                enabled=False\n",
    "            ):\n",
    "\n",
    "                expected_energy = (\n",
    "                    self.model\n",
    "                    .expected_energy_per_sample(\n",
    "                        out[\"gate_probs\"].float(),\n",
    "                        self.energy_per_level.float()\n",
    "                    )\n",
    "                    .mean()\n",
    "                )\n",
    "\n",
    "                energy_penalty = torch.clamp(\n",
    "                    expected_energy\n",
    "                    - self.energy_budget,\n",
    "                    min=0.0\n",
    "                )\n",
    "\n",
    "                # ---------------------------------------------------\n",
    "                # ANTI-COLLAPSE FIX (see helper functions above the\n",
    "                # Trainer class for the full rationale):\n",
    "                #\n",
    "                # 1) proxy_loss: cheap, always-available per-sample\n",
    "                #    difficulty proxy (raw unreduced BCE), independent\n",
    "                #    of whichever cfg.loss.type is configured.\n",
    "                # 2) consistency_loss: pairwise ranking loss tying the\n",
    "                #    learned `difficulty` to proxy_loss, so difficulty\n",
    "                #    actually reflects per-sample hardness instead of\n",
    "                #    collapsing to a constant.\n",
    "                # 3) balance_loss: batch-level Shazeer CV^2 term that\n",
    "                #    discourages the gate from routing (near) 100% of\n",
    "                #    probability mass to a single expert.\n",
    "                # ---------------------------------------------------\n",
    "\n",
    "                proxy_loss = F.binary_cross_entropy_with_logits(\n",
    "                    logits.float(),\n",
    "                    labels.float(),\n",
    "                    reduction=\"none\",\n",
    "                ).mean(dim=1)\n",
    "\n",
    "                consistency_loss = pairwise_difficulty_consistency_loss(\n",
    "                    out[\"difficulty\"].float(),\n",
    "                    proxy_loss,\n",
    "                )\n",
    "\n",
    "                balance_loss = load_balance_loss(\n",
    "                    out[\"gate_probs\"].float()\n",
    "                )\n",
    "\n",
    "            loss = (\n",
    "                task_loss\n",
    "                + self.energy_lambda\n",
    "                * energy_penalty\n",
    "                / max(\n",
    "                    float(self.energy_budget),\n",
    "                    1.0\n",
    "                )\n",
    "                + self.consistency_lambda\n",
    "                * consistency_loss\n",
    "                + self.balance_lambda\n",
    "                * balance_loss\n",
    "            )\n",
    "\n",
    "            extras = {\n",
    "                \"task_loss\":\n",
    "                    task_loss.item(),\n",
    "\n",
    "                \"expected_energy_nj\":\n",
    "                    expected_energy.item(),\n",
    "\n",
    "                \"consistency_loss\":\n",
    "                    consistency_loss.item(),\n",
    "\n",
    "                \"balance_loss\":\n",
    "                    balance_loss.item(),\n",
    "\n",
    "                \"difficulty_mean\":\n",
    "                    out[\"difficulty\"].detach().mean().item(),\n",
    "\n",
    "                \"difficulty_std\":\n",
    "                    out[\"difficulty\"].detach().std().item(),\n",
    "            }\n",
    "\n",
    "        else:\n",
    "\n",
    "            logits = self.model(\n",
    "                signals\n",
    "            )\n",
    "\n",
    "            loss = self.loss_fn(\n",
    "                logits,\n",
    "                labels\n",
    "            )\n",
    "\n",
    "            extras = {}\n",
    "\n",
    "        return (\n",
    "            logits,\n",
    "            loss,\n",
    "            extras\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # TRAIN ONE EPOCH\n",
    "    # ========================================================\n",
    "\n",
    "    def train_one_epoch(\n",
    "        self,\n",
    "        loader\n",
    "    ) -> dict:\n",
    "\n",
    "        self.model.train()\n",
    "\n",
    "        running_loss = 0.0\n",
    "        n_batches = 0\n",
    "\n",
    "        for signals, labels in loader:\n",
    "\n",
    "            signals = signals.to(\n",
    "                self.device,\n",
    "                non_blocking=True\n",
    "            )\n",
    "\n",
    "            labels = labels.to(\n",
    "                self.device,\n",
    "                non_blocking=True\n",
    "            )\n",
    "\n",
    "            if self.optimizer is None:\n",
    "                raise RuntimeError(\n",
    "                    \"Trainer.train_one_epoch() requires an optimizer.\"\n",
    "                )\n",
    "\n",
    "            self.optimizer.zero_grad(\n",
    "                set_to_none=True\n",
    "            )\n",
    "\n",
    "            with torch.amp.autocast(\n",
    "                device_type=self.device.type,\n",
    "                enabled=self.mixed_precision\n",
    "            ):\n",
    "\n",
    "                _, loss, _ = self._forward_batch(\n",
    "                    signals,\n",
    "                    labels,\n",
    "                    hard_routing=False\n",
    "                )\n",
    "\n",
    "            self.scaler.scale(\n",
    "                loss\n",
    "            ).backward()\n",
    "\n",
    "            self.scaler.unscale_(\n",
    "                self.optimizer\n",
    "            )\n",
    "\n",
    "            torch.nn.utils.clip_grad_norm_(\n",
    "                self.model.parameters(),\n",
    "                self.grad_clip_norm\n",
    "            )\n",
    "\n",
    "            self.scaler.step(\n",
    "                self.optimizer\n",
    "            )\n",
    "\n",
    "            self.scaler.update()\n",
    "\n",
    "            running_loss += loss.item()\n",
    "            n_batches += 1\n",
    "\n",
    "        return {\n",
    "            \"train_loss\":\n",
    "                running_loss\n",
    "                / max(n_batches, 1)\n",
    "        }\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # EVALUATION\n",
    "    # ========================================================\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def evaluate(\n",
    "        self,\n",
    "        loader,\n",
    "        split: str = \"val\"\n",
    "    ) -> dict:\n",
    "\n",
    "        self.model.eval()\n",
    "\n",
    "        all_logits = []\n",
    "        all_labels = []\n",
    "\n",
    "        running_loss = 0.0\n",
    "        n_batches = 0\n",
    "\n",
    "        for signals, labels in loader:\n",
    "\n",
    "            signals = signals.to(\n",
    "                self.device,\n",
    "                non_blocking=True\n",
    "            )\n",
    "\n",
    "            labels = labels.to(\n",
    "                self.device,\n",
    "                non_blocking=True\n",
    "            )\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Adaptive model:\n",
    "            # evaluate using TRUE hard routing.\n",
    "            #\n",
    "            # Dense/static:\n",
    "            # energy_aware=False, so normal forward is used.\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            logits, loss, _ = self._forward_batch(\n",
    "                signals,\n",
    "                labels,\n",
    "                hard_routing=self.energy_aware\n",
    "            )\n",
    "\n",
    "            running_loss += loss.item()\n",
    "            n_batches += 1\n",
    "\n",
    "            all_logits.append(\n",
    "                torch.sigmoid(\n",
    "                    logits\n",
    "                )\n",
    "                .cpu()\n",
    "                .numpy()\n",
    "            )\n",
    "\n",
    "            all_labels.append(\n",
    "                labels\n",
    "                .cpu()\n",
    "                .numpy()\n",
    "            )\n",
    "\n",
    "        y_prob = np.concatenate(\n",
    "            all_logits,\n",
    "            axis=0\n",
    "        )\n",
    "\n",
    "        y_true = np.concatenate(\n",
    "            all_labels,\n",
    "            axis=0\n",
    "        )\n",
    "\n",
    "        metrics = compute_full_metric_suite(\n",
    "            y_true,\n",
    "            y_prob,\n",
    "            self.class_names\n",
    "        )\n",
    "\n",
    "        metrics[\"summary\"][\n",
    "            f\"{split}_loss\"\n",
    "        ] = (\n",
    "            running_loss\n",
    "            / max(n_batches, 1)\n",
    "        )\n",
    "\n",
    "        return metrics\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # FIT\n",
    "    # ========================================================\n",
    "\n",
    "    def fit(\n",
    "        self,\n",
    "        train_loader,\n",
    "        val_loader,\n",
    "        epochs: int,\n",
    "        early_stopping_patience: int,\n",
    "        early_stopping_metric: str = \"val_macro_auroc\",\n",
    "        resume_from: str | None = None,\n",
    "    ):\n",
    "\n",
    "        if self.optimizer is None:\n",
    "            raise RuntimeError(\n",
    "                \"Trainer.fit() requires an optimizer.\"\n",
    "            )\n",
    "\n",
    "        start_epoch = 0\n",
    "\n",
    "        stopper = EarlyStopper(\n",
    "            early_stopping_patience,\n",
    "            mode=\"max\"\n",
    "        )\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Optional resume\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        if (\n",
    "            resume_from\n",
    "            and os.path.exists(\n",
    "                resume_from\n",
    "            )\n",
    "        ):\n",
    "\n",
    "            start_epoch, best_metric = load_checkpoint(\n",
    "                resume_from,\n",
    "                self.model,\n",
    "                self.optimizer,\n",
    "                self.scheduler\n",
    "            )\n",
    "\n",
    "            stopper.best = best_metric\n",
    "\n",
    "            self.logger.info(\n",
    "                \"Resumed from %s at epoch %d (best=%.4f)\",\n",
    "                resume_from,\n",
    "                start_epoch,\n",
    "                best_metric\n",
    "            )\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Training loop\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        for epoch in range(\n",
    "            start_epoch,\n",
    "            epochs\n",
    "        ):\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Routing temperature annealing\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            if (\n",
    "                self.energy_aware\n",
    "                and hasattr(\n",
    "                    self.model,\n",
    "                    \"gate\"\n",
    "                )\n",
    "            ):\n",
    "\n",
    "                if not hasattr(\n",
    "                    self,\n",
    "                    \"_anneal_start_temp\"\n",
    "                ):\n",
    "                    self._anneal_start_temp = max(\n",
    "                        float(\n",
    "                            self.model.gate.temperature\n",
    "                        ),\n",
    "                        0.10\n",
    "                    )\n",
    "\n",
    "                progress = (\n",
    "                    epoch\n",
    "                    / max(\n",
    "                        epochs - 1,\n",
    "                        1\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                temperature = (\n",
    "                    self._anneal_start_temp\n",
    "                    * (\n",
    "                        0.10\n",
    "                        / self._anneal_start_temp\n",
    "                    ) ** progress\n",
    "                )\n",
    "\n",
    "                self.model.gate.set_temperature(\n",
    "                    temperature\n",
    "                )\n",
    "\n",
    "                self.logger.info(\n",
    "                    \"Gate temperature: %.4f\",\n",
    "                    temperature\n",
    "                )\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Train\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            train_stats = self.train_one_epoch(\n",
    "                train_loader\n",
    "            )\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Validate\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            val_metrics = self.evaluate(\n",
    "                val_loader,\n",
    "                split=\"val\"\n",
    "            )\n",
    "\n",
    "            val_summary = val_metrics[\n",
    "                \"summary\"\n",
    "            ]\n",
    "\n",
    "            monitored = val_summary.get(\n",
    "                \"auroc_macro\",\n",
    "                val_summary.get(\n",
    "                    early_stopping_metric,\n",
    "                    0.0\n",
    "                )\n",
    "            )\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Scheduler\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            if self.scheduler is not None:\n",
    "\n",
    "                if (\n",
    "                    \"ReduceLROnPlateau\"\n",
    "                    in type(\n",
    "                        self.scheduler\n",
    "                    ).__name__\n",
    "                ):\n",
    "\n",
    "                    self.scheduler.step(\n",
    "                        val_summary[\n",
    "                            \"val_loss\"\n",
    "                        ]\n",
    "                    )\n",
    "\n",
    "                else:\n",
    "\n",
    "                    self.scheduler.step()\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Logging\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            self.logger.info(\n",
    "                \"Epoch %d | \"\n",
    "                \"train_loss=%.4f | \"\n",
    "                \"val_loss=%.4f | \"\n",
    "                \"val_macroAUROC=%.4f | \"\n",
    "                \"val_macroF1=%.4f\",\n",
    "\n",
    "                epoch + 1,\n",
    "\n",
    "                train_stats[\n",
    "                    \"train_loss\"\n",
    "                ],\n",
    "\n",
    "                val_summary[\n",
    "                    \"val_loss\"\n",
    "                ],\n",
    "\n",
    "                val_summary.get(\n",
    "                    \"auroc_macro\",\n",
    "                    float(\"nan\")\n",
    "                ),\n",
    "\n",
    "                val_summary[\n",
    "                    \"f1_macro\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            self.metric_logger.log(\n",
    "                epoch + 1,\n",
    "                **train_stats,\n",
    "                **val_summary\n",
    "            )\n",
    "\n",
    "            # ------------------------------------------------\n",
    "            # Early stopping\n",
    "            # ------------------------------------------------\n",
    "\n",
    "            improved = stopper.step(\n",
    "                monitored\n",
    "            )\n",
    "\n",
    "            if improved:\n",
    "\n",
    "                save_checkpoint(\n",
    "                    os.path.join(\n",
    "                        self.weights_dir,\n",
    "                        f\"{self.run_name}_best.pt\"\n",
    "                    ),\n",
    "                    self.model,\n",
    "                    self.optimizer,\n",
    "                    self.scheduler,\n",
    "                    epoch + 1,\n",
    "                    stopper.best\n",
    "                )\n",
    "\n",
    "            save_checkpoint(\n",
    "                os.path.join(\n",
    "                    self.weights_dir,\n",
    "                    f\"{self.run_name}_last.pt\"\n",
    "                ),\n",
    "                self.model,\n",
    "                self.optimizer,\n",
    "                self.scheduler,\n",
    "                epoch + 1,\n",
    "                stopper.best\n",
    "            )\n",
    "\n",
    "            if stopper.should_stop:\n",
    "\n",
    "                self.logger.info(\n",
    "                    \"Early stopping triggered at epoch %d \"\n",
    "                    \"(best %s=%.4f)\",\n",
    "                    epoch + 1,\n",
    "                    early_stopping_metric,\n",
    "                    stopper.best\n",
    "                )\n",
    "\n",
    "                break\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Restore BEST checkpoint\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        best_ckpt_path = os.path.join(\n",
    "            self.weights_dir,\n",
    "            f\"{self.run_name}_best.pt\"\n",
    "        )\n",
    "\n",
    "        if os.path.exists(\n",
    "            best_ckpt_path\n",
    "        ):\n",
    "\n",
    "            load_checkpoint(\n",
    "                best_ckpt_path,\n",
    "                self.model,\n",
    "                self.optimizer,\n",
    "                self.scheduler\n",
    "            )\n",
    "\n",
    "            self.logger.info(\n",
    "                \"Restored best checkpoint \"\n",
    "                \"(best %s=%.4f) before returning\",\n",
    "                early_stopping_metric,\n",
    "                stopper.best\n",
    "            )\n",
    "\n",
    "        self.metric_logger.close()\n",
    "\n",
    "        return stopper.best"
   ]
