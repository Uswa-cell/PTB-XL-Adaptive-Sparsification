    "# ---- from src/data/eda.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/data/eda.py\n",
    "------------------\n",
    "Publication-quality EDA visualizations for PTB-XL metadata + labels:\n",
    "class distribution, age/gender distribution, recording-length distribution,\n",
    "diagnosis co-occurrence (multilabel correlation), class imbalance ratio,\n",
    "and raw signal examples.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import os\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "\n",
    "def _save(fig, figures_dir, name):\n",
    "    Path(figures_dir).mkdir(parents=True, exist_ok=True)\n",
    "    fig.savefig(os.path.join(figures_dir, f\"{name}.png\"), dpi=300, bbox_inches=\"tight\")\n",
    "\n",
    "\n",
    "def plot_class_distribution(df: pd.DataFrame, superclasses: list[str], figures_dir: str):\n",
    "    counts = [df[f\"label_{c}\"].sum() for c in superclasses]\n",
    "    fig, ax = plt.subplots(figsize=(7, 5))\n",
    "    bars = ax.bar(superclasses, counts, color=sns.color_palette(\"viridis\", len(superclasses)))\n",
    "    ax.set_title(\"PTB-XL Diagnostic Superclass Distribution (multilabel)\")\n",
    "    ax.set_ylabel(\"Number of ECGs\")\n",
    "    for b, c in zip(bars, counts):\n",
    "        ax.text(b.get_x() + b.get_width() / 2, c, str(int(c)), ha=\"center\", va=\"bottom\")\n",
    "    ax.grid(axis=\"y\", alpha=0.3)\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, \"class_distribution\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_age_gender_distribution(df: pd.DataFrame, figures_dir: str):\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 4.5))\n",
    "    df[\"age\"].dropna().plot(kind=\"hist\", bins=30, ax=axes[0], color=\"steelblue\", edgecolor=\"black\")\n",
    "    axes[0].set_title(\"Age Distribution\"); axes[0].set_xlabel(\"Age (years)\")\n",
    "    axes[0].grid(alpha=0.3)\n",
    "\n",
    "    if \"sex\" in df.columns:\n",
    "        gender_counts = df[\"sex\"].value_counts()\n",
    "        axes[1].bar(gender_counts.index.astype(str), gender_counts.values, color=[\"#4C72B0\", \"#DD8452\"])\n",
    "        axes[1].set_title(\"Gender Distribution (0=male, 1=female per PTB-XL docs)\")\n",
    "        axes[1].grid(axis=\"y\", alpha=0.3)\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, \"age_gender_distribution\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_recording_length_distribution(lengths_seconds: np.ndarray, figures_dir: str):\n",
    "    fig, ax = plt.subplots(figsize=(7, 4.5))\n",
    "    ax.hist(lengths_seconds, bins=20, color=\"darkgreen\", edgecolor=\"black\")\n",
    "    ax.set_title(\"ECG Recording Length Distribution\")\n",
    "    ax.set_xlabel(\"Length (seconds)\"); ax.set_ylabel(\"Count\")\n",
    "    ax.grid(alpha=0.3)\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, \"recording_length_distribution\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_label_cooccurrence(df: pd.DataFrame, superclasses: list[str], figures_dir: str):\n",
    "    \"\"\"Correlation / co-occurrence matrix across superclasses -- meaningful\n",
    "    only under multilabel, since single-label data has zero co-occurrence\n",
    "    by construction. Directly visualises how often e.g. MI and STTC\n",
    "    co-occur, motivating the multilabel task choice.\"\"\"\n",
    "    label_matrix = df[[f\"label_{c}\" for c in superclasses]].values\n",
    "    cooc = label_matrix.T @ label_matrix\n",
    "    fig, ax = plt.subplots(figsize=(6, 5))\n",
    "    sns.heatmap(cooc, annot=True, fmt=\"d\", xticklabels=superclasses, yticklabels=superclasses,\n",
    "                cmap=\"Blues\", ax=ax)\n",
    "    ax.set_title(\"Diagnostic Superclass Co-occurrence Matrix\")\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, \"label_cooccurrence\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_class_imbalance_ratio(df: pd.DataFrame, superclasses: list[str], figures_dir: str):\n",
    "    counts = np.array([df[f\"label_{c}\"].sum() for c in superclasses])\n",
    "    ratio = counts.max() / counts\n",
    "    fig, ax = plt.subplots(figsize=(7, 4.5))\n",
    "    ax.bar(superclasses, ratio, color=\"indianred\")\n",
    "    ax.set_title(\"Class Imbalance Ratio (relative to most frequent class)\")\n",
    "    ax.set_ylabel(\"Imbalance Ratio\")\n",
    "    ax.axhline(1.0, color=\"black\", linestyle=\"--\", alpha=0.5)\n",
    "    ax.grid(axis=\"y\", alpha=0.3)\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, \"class_imbalance_ratio\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_signal_examples(signals: dict[str, np.ndarray], figures_dir: str, lead_index: int = 0):\n",
    "    \"\"\"signals: {class_name: (leads, T) example waveform}.\"\"\"\n",
    "    fig, axes = plt.subplots(len(signals), 1, figsize=(12, 2.2 * len(signals)), squeeze=False)\n",
    "    for row, (name, sig) in enumerate(signals.items()):\n",
    "        axes[row, 0].plot(sig[lead_index])\n",
    "        axes[row, 0].set_title(f\"Example ECG (Lead I) — {name}\")\n",
    "        axes[row, 0].grid(alpha=0.3)\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, \"signal_examples_by_class\")\n",
    "    return fig\n"
   ]
