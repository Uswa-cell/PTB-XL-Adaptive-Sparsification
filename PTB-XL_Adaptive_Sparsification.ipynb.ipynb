   "source": [
    "# ============================================================\n",
    "# REAL HARDWARE LATENCY BENCHMARK\n",
    "# ============================================================\n",
    "\n",
    "import time\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def benchmark_latency(\n",
    "    model,\n",
    "    sample,\n",
    "    adaptive=False,\n",
    "    warmup=20,       # SPEEDUP: 100->20; still enough to clear kernel/cache warmup\n",
    "    repetitions=100, # SPEEDUP: 300->100; SD/CI stay stable at this count for a proxy benchmark\n",
    "):\n",
    "    model.eval()\n",
    "    sample = sample.to(device)\n",
    "    batch_size = int(sample.shape[0])\n",
    "\n",
    "    # Warm-up avoids one-time kernel compilation / cache effects.\n",
    "    for _ in range(warmup):\n",
    "        if adaptive:\n",
    "            model(sample, hard=True)\n",
    "        else:\n",
    "            model(sample)\n",
    "\n",
    "    if device.type == \"cuda\":\n",
    "        torch.cuda.synchronize()\n",
    "        starter = torch.cuda.Event(enable_timing=True)\n",
    "        ender = torch.cuda.Event(enable_timing=True)\n",
    "        times_ms = []\n",
    "\n",
    "        for _ in range(repetitions):\n",
    "            starter.record()\n",
    "            if adaptive:\n",
    "                model(sample, hard=True)\n",
    "            else:\n",
    "                model(sample)\n",
    "            ender.record()\n",
    "            torch.cuda.synchronize()\n",
    "            times_ms.append(starter.elapsed_time(ender))\n",
    "    else:\n",
    "        times_ms = []\n",
    "        for _ in range(repetitions):\n",
    "            start = time.perf_counter()\n",
    "            if adaptive:\n",
    "                model(sample, hard=True)\n",
    "            else:\n",
    "                model(sample)\n",
    "            times_ms.append((time.perf_counter() - start) * 1000.0)\n",
    "\n",
    "    times_ms = np.asarray(times_ms, dtype=np.float64)\n",
    "    mean_ms = float(times_ms.mean())\n",
    "    return {\n",
    "        \"Batch size\": batch_size,\n",
    "        \"Mean latency (ms)\": mean_ms,\n",
    "        \"Median latency (ms)\": float(np.median(times_ms)),\n",
    "        \"SD latency (ms)\": float(times_ms.std(ddof=1)),\n",
    "        \"P95 latency (ms)\": float(np.percentile(times_ms, 95)),\n",
    "        \"Throughput (samples/s)\": float(batch_size * 1000.0 / max(mean_ms, 1e-12)),\n",
    "    }\n",
    "\n",
    "\n",
    "sample_batch, _ = next(iter(test_loader))\n",
    "latency_models = {\n",
    "    \"Dense\": (dense_model, False),\n",
    "    f\"Static-{int(matched_sparsity * 100)}%\": (static_model_for_compare, False),\n",
    "    \"Adaptive\": (adaptive_model_eval, True),\n",
    "}\n",
    "\n",
    "candidate_batch_sizes = [1, 16, min(int(sample_batch.shape[0]), 32)]\n",
    "candidate_batch_sizes = sorted(set(b for b in candidate_batch_sizes if b >= 1))\n",
    "\n",
    "latency_rows = []\n",
    "for name, (model, is_adaptive) in latency_models.items():\n",
    "    model = model.to(device)\n",
    "    for batch_size in candidate_batch_sizes:\n",
    "        sample = sample_batch[:batch_size].to(device)\n",
    "        result = benchmark_latency(\n",
    "            model=model,\n",
    "            sample=sample,\n",
    "            adaptive=is_adaptive,\n",
    "            warmup=100,\n",
    "            repetitions=300,\n",
    "        )\n",
    "        result[\"Model\"] = name\n",
    "        latency_rows.append(result)\n",
    "\n",
    "    # Keep the adaptive model resident for the immediately following\n",
    "    # difficulty analysis; release dense/static GPU memory.\n",
    "    if not is_adaptive:\n",
    "        model.to(\"cpu\")\n",
    "        if torch.cuda.is_available():\n",
    "            torch.cuda.empty_cache()\n",
    "\n",
    "latency_df = pd.DataFrame(latency_rows)[[\n",
    "    \"Model\",\n",
    "    \"Batch size\",\n",
    "    \"Mean latency (ms)\",\n",
    "    \"Median latency (ms)\",\n",
    "    \"SD latency (ms)\",\n",
    "    \"P95 latency (ms)\",\n",
    "    \"Throughput (samples/s)\",\n",
    "]]\n",
    "\n",
    "display(latency_df)\n",
    "latency_df.to_csv(\n",
    "    os.path.join(cfg.paths.results_dir, \"REAL_hardware_latency.csv\"),\n",
    "    index=False,\n",
    ")\n"
   ]
  },
