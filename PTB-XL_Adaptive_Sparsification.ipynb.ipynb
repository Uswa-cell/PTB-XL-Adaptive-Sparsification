    "# ---- from src/utils/logger.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/utils/logger.py\n",
    "--------------------\n",
    "Two things:\n",
    "1. `get_logger` -- standard Python logging to console + a per-run file.\n",
    "2. `MetricLogger` -- a lightweight structured logger that writes per-epoch\n",
    "   metrics to CSV (for the \"CSV metrics\" / \"Excel summaries\" requirement)\n",
    "   and, if tensorboard is available, also to TensorBoard.\n",
    "\"\"\"\n",
    "import csv\n",
    "import logging\n",
    "import os\n",
    "from datetime import datetime\n",
    "from pathlib import Path\n",
    "\n",
    "try:\n",
    "    from torch.utils.tensorboard import SummaryWriter\n",
    "    _HAS_TB = True\n",
    "except Exception:\n",
    "    _HAS_TB = False\n",
    "\n",
    "\n",
    "def get_logger(name: str, log_dir: str = \"logs\") -> logging.Logger:\n",
    "    Path(log_dir).mkdir(parents=True, exist_ok=True)\n",
    "    logger = logging.getLogger(name)\n",
    "    if logger.handlers:  # avoid duplicate handlers on repeated calls (e.g. notebooks)\n",
    "        return logger\n",
    "    logger.setLevel(logging.INFO)\n",
    "\n",
    "    fmt = logging.Formatter(\"%(asctime)s | %(name)s | %(levelname)s | %(message)s\")\n",
    "\n",
    "    ch = logging.StreamHandler()\n",
    "    ch.setFormatter(fmt)\n",
    "    logger.addHandler(ch)\n",
    "\n",
    "    ts = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "    fh = logging.FileHandler(os.path.join(log_dir, f\"{name}_{ts}.log\"))\n",
    "    fh.setFormatter(fmt)\n",
    "    logger.addHandler(fh)\n",
    "\n",
    "    return logger\n",
    "\n",
    "\n",
    "class MetricLogger:\n",
    "    def __init__(self, run_name: str, results_dir: str = \"results\", use_tensorboard: bool = True):\n",
    "        Path(results_dir).mkdir(parents=True, exist_ok=True)\n",
    "        self.csv_path = os.path.join(results_dir, f\"{run_name}_metrics.csv\")\n",
    "        self._rows = []\n",
    "        self._fieldnames = None\n",
    "        self.tb = None\n",
    "        if use_tensorboard and _HAS_TB:\n",
    "            tb_dir = os.path.join(results_dir, \"tensorboard\", run_name)\n",
    "            Path(tb_dir).mkdir(parents=True, exist_ok=True)\n",
    "            self.tb = SummaryWriter(tb_dir)\n",
    "\n",
    "    def log(self, step: int, **metrics):\n",
    "        row = {\"step\": step, **metrics}\n",
    "        self._rows.append(row)\n",
    "        if self._fieldnames is None:\n",
    "            self._fieldnames = list(row.keys())\n",
    "        if self.tb is not None:\n",
    "            for k, v in metrics.items():\n",
    "                if isinstance(v, (int, float)):\n",
    "                    self.tb.add_scalar(k, v, step)\n",
    "\n",
    "    def flush_csv(self):\n",
    "        if not self._rows:\n",
    "            return\n",
    "        fieldnames = sorted({k for row in self._rows for k in row.keys()})\n",
    "        with open(self.csv_path, \"w\", newline=\"\") as f:\n",
    "            writer = csv.DictWriter(f, fieldnames=fieldnames)\n",
    "            writer.writeheader()\n",
    "            for row in self._rows:\n",
    "                writer.writerow(row)\n",
    "\n",
    "    def close(self):\n",
    "        self.flush_csv()\n",
    "        if self.tb is not None:\n",
    "            self.tb.close()\n"
   ]
  },
