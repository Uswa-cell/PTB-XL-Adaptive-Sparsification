    "# ---- from src/preprocessing/augmentation.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/preprocessing/augmentation.py\n",
    "------------------------------------\n",
    "ECG-specific augmentations, applied on-the-fly in the Dataset (training\n",
    "split only). Each technique below is drawn from published ECG deep-learning\n",
    "augmentation practice (again, this is standard ECG-ML literature, not the\n",
    "sparsification review, which does not discuss augmentation):\n",
    "\n",
    "  - Gaussian noise injection      : simulates electrode/amplifier noise.\n",
    "  - Amplitude scaling             : simulates inter-patient/device gain\n",
    "                                     variation.\n",
    "  - Time shifting (circular)      : simulates imperfect R-peak alignment.\n",
    "  - Random temporal masking       : analogous to SpecAugment's time-masking,\n",
    "                                     adapted to raw 1D ECG; encourages the\n",
    "                                     model not to rely on any single segment.\n",
    "  - Time warping                  : simulates natural heart-rate variability\n",
    "                                     by locally stretching/compressing time.\n",
    "  - Mixup (Zhang et al., 2018)    : convex combination of two ECGs and their\n",
    "                                     multi-hot labels; included because it\n",
    "                                     is a widely validated regularizer for\n",
    "                                     imbalanced multilabel classification\n",
    "                                     and composes naturally with BCE-style\n",
    "                                     losses.\n",
    "\n",
    "All operations are implemented directly on the (leads, time) numpy array\n",
    "that PTBXLDataset produces after preprocessing, so they compose cleanly\n",
    "with the preprocessing chain and require no extra dependencies.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def add_gaussian_noise(signal: np.ndarray, std: float, rng: np.random.Generator) -> np.ndarray:\n",
    "    return signal + rng.normal(0, std, size=signal.shape).astype(signal.dtype)\n",
    "\n",
    "\n",
    "def amplitude_scale(signal: np.ndarray, scale_range, rng: np.random.Generator) -> np.ndarray:\n",
    "    scale = rng.uniform(scale_range[0], scale_range[1])\n",
    "    return signal * scale\n",
    "\n",
    "\n",
    "def time_shift(signal: np.ndarray, max_fraction: float, rng: np.random.Generator) -> np.ndarray:\n",
    "    max_shift = int(signal.shape[-1] * max_fraction)\n",
    "    if max_shift == 0:\n",
    "        return signal\n",
    "    shift = rng.integers(-max_shift, max_shift + 1)\n",
    "    return np.roll(signal, shift, axis=-1)\n",
    "\n",
    "\n",
    "def random_mask(signal: np.ndarray, mask_fraction: float, rng: np.random.Generator) -> np.ndarray:\n",
    "    \"\"\"Zeroes out a contiguous random time window of `mask_fraction` of the\n",
    "    sequence length, applied identically across leads (so QRS geometry\n",
    "    across leads is not artificially decorrelated).\"\"\"\n",
    "    signal = signal.copy()\n",
    "    seq_len = signal.shape[-1]\n",
    "    mask_len = int(seq_len * mask_fraction)\n",
    "    if mask_len == 0:\n",
    "        return signal\n",
    "    start = rng.integers(0, seq_len - mask_len + 1)\n",
    "    signal[:, start:start + mask_len] = 0.0\n",
    "    return signal\n",
    "\n",
    "\n",
    "def time_warp(signal: np.ndarray, sigma: float, rng: np.random.Generator) -> np.ndarray:\n",
    "    \"\"\"Smoothly-varying nonlinear resampling of the time axis, implemented\n",
    "    via a random monotonic cumulative-sum warp field then linear\n",
    "    interpolation back onto the original `seq_len` grid.\"\"\"\n",
    "    n_leads, seq_len = signal.shape\n",
    "    knots = 4\n",
    "    warp_knots = rng.normal(1.0, sigma, size=knots + 2)\n",
    "    warp_knots[0] = warp_knots[-1] = 1.0\n",
    "    knot_positions = np.linspace(0, seq_len - 1, knots + 2)\n",
    "    dense_positions = np.arange(seq_len)\n",
    "    local_rate = np.interp(dense_positions, knot_positions, warp_knots)\n",
    "    warped_time = np.cumsum(local_rate)\n",
    "    warped_time = warped_time / warped_time[-1] * (seq_len - 1)\n",
    "\n",
    "    out = np.zeros_like(signal)\n",
    "    for lead in range(n_leads):\n",
    "        out[lead] = np.interp(dense_positions, warped_time, signal[lead])\n",
    "    return out.astype(signal.dtype)\n",
    "\n",
    "\n",
    "def mixup(signal_a: np.ndarray, label_a: np.ndarray, signal_b: np.ndarray, label_b: np.ndarray,\n",
    "          alpha: float, rng: np.random.Generator):\n",
    "    \"\"\"Standard mixup (Zhang et al. 2018) adapted to multilabel targets:\n",
    "    labels are combined with the same convex weight lambda, which is valid\n",
    "    because BCE loss is linear in the target for a fixed prediction.\"\"\"\n",
    "    lam = rng.beta(alpha, alpha) if alpha > 0 else 1.0\n",
    "    mixed_signal = lam * signal_a + (1 - lam) * signal_b\n",
    "    mixed_label = lam * label_a + (1 - lam) * label_b\n",
    "    return mixed_signal.astype(signal_a.dtype), mixed_label.astype(np.float32)\n",
    "\n",
    "\n",
    "def apply_augmentation_pipeline(signal: np.ndarray, cfg, rng: np.random.Generator) -> np.ndarray:\n",
    "    \"\"\"Applies the non-mixup augmentations in sequence, each independently\n",
    "    probabilistic-free (deterministic given rng) but composed randomly by\n",
    "    virtue of rng draws -- kept simple/inspectable rather than wrapping in\n",
    "    an extra probability-per-op layer, matching how config.yaml exposes a\n",
    "    single `enabled` switch plus per-op magnitude parameters.\"\"\"\n",
    "    if not cfg.enabled:\n",
    "        return signal\n",
    "    signal = add_gaussian_noise(signal, cfg.gaussian_noise_std, rng)\n",
    "    signal = amplitude_scale(signal, cfg.amplitude_scale_range, rng)\n",
    "    signal = time_shift(signal, cfg.time_shift_max_fraction, rng)\n",
    "    signal = random_mask(signal, cfg.random_mask_fraction, rng)\n",
    "    signal = time_warp(signal, cfg.time_warp_sigma, rng)\n",
    "    return signal\n"
   ]
  },
