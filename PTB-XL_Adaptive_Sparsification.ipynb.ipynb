    "# ---- from src/experiments/run_baseline.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/experiments/run_baseline.py\n",
    "------------------------------------\n",
    "Trains and evaluates the DENSE baseline (Phase 0 of the advancement plan).\n",
    "This is the reference point every later comparison (static-pruned,\n",
    "adaptive) is measured against.\n",
    "\n",
    "Usage (from the project root, after editing config/config.yaml's\n",
    "`paths.dataset_root` to point at your local PTB-XL download):\n",
    "\n",
    "    python -m src.experiments.run_baseline\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import os\n",
    "import torch\n",
    "\n",
    "import csv\n",
    "\n",
    "\n",
    "def get_layer_specs(cfg, seq_len_after_stem=None):\n",
    "    \"\"\"Analytic per-stage sequence lengths, needed for FLOPs/energy\n",
    "    accounting. Each MaskableStage ends with a MaxPool1d(2), so sequence\n",
    "    length halves after every stage.\"\"\"\n",
    "    seq_len = cfg.task.signal_length\n",
    "    channels = [cfg.model.stem_channels] + list(cfg.model.block_channels)\n",
    "    specs = []\n",
    "    for i in range(len(cfg.model.block_channels)):\n",
    "        seq_len_out = seq_len // 2\n",
    "        specs.append(LayerSpec(channels[i], channels[i + 1], kernel_size=5, seq_len_out=seq_len_out))\n",
    "        seq_len = seq_len_out\n",
    "    return specs\n",
    "\n",
    "\n",
    "def run_baseline(config_path: str | None = None):\n",
    "    cfg = load_config(config_path)\n",
    "    set_seed(cfg.training.seed)\n",
    "    logger = get_logger(\"run_baseline\", cfg.paths.logs_dir)\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    logger.info(\"Using device: %s\", device)\n",
    "\n",
    "    db_csv = os.path.join(cfg.paths.dataset_root, cfg.paths.database_csv)\n",
    "    scp_csv = os.path.join(cfg.paths.dataset_root, cfg.paths.scp_csv)\n",
    "    df, report = load_and_clean_metadata(db_csv, scp_csv, cfg.task.superclasses, cfg.task.min_diagnostic_likelihood)\n",
    "    logger.info(\"Data cleaning report: %s\", report)\n",
    "\n",
    "    train_df, val_df, test_df = split_by_official_fold(df, cfg.split.val_fold, cfg.split.test_fold)\n",
    "    logger.info(\"Train/Val/Test sizes: %d/%d/%d\", len(train_df), len(val_df), len(test_df))\n",
    "\n",
    "    train_ds, val_ds, test_ds = build_datasets(\n",
    "        train_df, val_df, test_df, cfg.paths.dataset_root, cfg.task.superclasses,\n",
    "        cfg.task.sampling_rate_hz, cfg.preprocessing, cfg.augmentation, cfg.training.seed)\n",
    "    train_loader, val_loader, test_loader = build_dataloaders(\n",
    "        train_ds, val_ds, test_ds, cfg.dataloader.batch_size, cfg.dataloader.num_workers)\n",
    "\n",
    "    class_counts = torch.tensor(train_ds.class_counts(), dtype=torch.float32)\n",
    "    loss_fn = build_loss(cfg.loss, class_counts, len(train_ds))\n",
    "\n",
    "    model = ECGBackbone(\n",
    "        num_classes=cfg.task.num_classes, in_leads=cfg.task.num_leads,\n",
    "        stem_channels=cfg.model.stem_channels, block_channels=cfg.model.block_channels,\n",
    "        block_depth=cfg.model.block_depth, se_reduction=cfg.model.se_reduction, dropout=cfg.model.dropout,\n",
    "    )\n",
    "    param_info = count_params(model)\n",
    "    layer_specs = get_layer_specs(cfg)\n",
    "    dense_flops = backbone_flops(layer_specs)\n",
    "    logger.info(\"Dense model: %s params, %.2fM MACs\", f\"{param_info['total_params']:,}\", dense_flops / 1e6)\n",
    "\n",
    "    if cfg.optimizer.type == \"adamw\":\n",
    "        optimizer = torch.optim.AdamW(model.parameters(), lr=cfg.optimizer.lr, weight_decay=cfg.optimizer.weight_decay)\n",
    "    elif cfg.optimizer.type == \"adam\":\n",
    "        optimizer = torch.optim.Adam(model.parameters(), lr=cfg.optimizer.lr, weight_decay=cfg.optimizer.weight_decay)\n",
    "    elif cfg.optimizer.type == \"sgd\":\n",
    "        optimizer = torch.optim.SGD(model.parameters(), lr=cfg.optimizer.lr, momentum=cfg.optimizer.momentum,\n",
    "                                     weight_decay=cfg.optimizer.weight_decay)\n",
    "    else:\n",
    "        raise ValueError(f\"Unsupported optimizer: {cfg.optimizer.type}\")\n",
    "\n",
    "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "        optimizer, mode=\"min\", factor=cfg.scheduler.factor, patience=cfg.scheduler.patience,\n",
    "        min_lr=cfg.scheduler.min_lr)\n",
    "\n",
    "    trainer = Trainer(model, optimizer, scheduler, loss_fn, device, cfg.task.superclasses,\n",
    "                       run_name=\"dense_baseline\", results_dir=cfg.paths.results_dir,\n",
    "                       weights_dir=cfg.paths.weights_dir, grad_clip_norm=cfg.training.grad_clip_norm,\n",
    "                       mixed_precision=cfg.training.mixed_precision, energy_aware=False)\n",
    "\n",
    "    trainer.fit(train_loader, val_loader, cfg.training.epochs, cfg.training.early_stopping_patience,\n",
