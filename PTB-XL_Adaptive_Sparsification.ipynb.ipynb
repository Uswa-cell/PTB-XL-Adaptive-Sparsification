    "sample_x, sample_y = next(iter(test_loader))\n",
    "x0 = sample_x[0:1].to(device, non_blocking=True)  # INFRASTRUCTURE CHANGE: non_blocking transfer\n",
    "true_class = int(sample_y[0].argmax().item())\n",
    "\n",
    "cam_tool = GradCAM1D(dense_model)\n",
    "saliency = cam_tool.compute(x0, class_idx=true_class)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 3))\n",
    "ax.plot(x0[0, 0].cpu().numpy(), label=\"Lead I signal\")\n",
    "ax.plot(saliency, label=\"Grad-CAM saliency\", alpha=0.7)\n",
    "ax.set_title(f\"Grad-CAM — true class index {true_class}\")\n",
    "ax.legend()\n",
    "plt.show()\n"
   ]
