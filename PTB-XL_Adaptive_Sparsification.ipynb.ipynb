   "source": [
    "# ---- from src/utils/metrics.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/utils/metrics.py\n",
    "---------------------\n",
    "Full multilabel evaluation-metric suite for the PTB-XL superclass task.\n",
    "\n",
    "Covers every metric requested: accuracy (subset + per-label), precision,\n",
    "recall, F1 (micro/macro/weighted), specificity, sensitivity, AUROC, AUPRC,\n",
    "Matthews Correlation Coefficient, Cohen's Kappa, and Hamming loss.\n",
    "\n",
    "All functions take:\n",
    "    y_true : (N, C) binary array\n",
    "    y_prob : (N, C) float array in [0,1] (sigmoid outputs)\n",
    "    y_pred : (N, C) binary array (thresholded, default 0.5) -- derived\n",
    "             internally if not supplied.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import numpy as np\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    roc_auc_score, average_precision_score, matthews_corrcoef,\n",
    "    cohen_kappa_score, hamming_loss, confusion_matrix,\n",
    ")\n",
    "\n",
    "\n",
    "def _binarize(y_prob, threshold=0.5):\n",
    "    return (y_prob >= threshold).astype(int)\n",
    "\n",
    "\n",
    "def per_class_specificity_sensitivity(y_true, y_pred):\n",
    "    \"\"\"Returns (specificity, sensitivity) arrays, one value per class,\n",
    "    computed from each class's own binary one-vs-rest confusion matrix.\"\"\"\n",
    "    n_classes = y_true.shape[1]\n",
    "    spec = np.zeros(n_classes)\n",
    "    sens = np.zeros(n_classes)\n",
    "    for c in range(n_classes):\n",
    "        tn, fp, fn, tp = confusion_matrix(\n",
    "            y_true[:, c], y_pred[:, c], labels=[0, 1]\n",
    "        ).ravel()\n",
    "        spec[c] = tn / (tn + fp) if (tn + fp) > 0 else 0.0\n",
    "        sens[c] = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
    "    return spec, sens\n",
    "\n",
    "\n",
    "def compute_full_metric_suite(y_true: np.ndarray, y_prob: np.ndarray,\n",
    "                               class_names: list[str], threshold: float = 0.5) -> dict:\n",
    "    \"\"\"Returns a nested dict: {\"summary\": {...scalar averages...},\n",
    "    \"per_class\": {class_name: {...}}}.\"\"\"\n",
    "    y_pred = _binarize(y_prob, threshold)\n",
    "    n_classes = y_true.shape[1]\n",
    "\n",
    "    # ---- overall / averaged metrics ----\n",
    "    summary = {}\n",
    "    summary[\"subset_accuracy\"] = accuracy_score(y_true, y_pred)  # exact-match ratio\n",
    "    summary[\"hamming_loss\"] = hamming_loss(y_true, y_pred)\n",
    "\n",
    "    for avg in (\"micro\", \"macro\", \"weighted\"):\n",
    "        summary[f\"precision_{avg}\"] = precision_score(y_true, y_pred, average=avg, zero_division=0)\n",
    "        summary[f\"recall_{avg}\"] = recall_score(y_true, y_pred, average=avg, zero_division=0)\n",
    "        summary[f\"f1_{avg}\"] = f1_score(y_true, y_pred, average=avg, zero_division=0)\n",
    "\n",
    "    # AUROC / AUPRC: only defined for classes with both positive and negative\n",
    "    # examples in y_true -- guard against degenerate single-class columns\n",
    "    # (common in small synthetic smoke tests; PTB-XL itself will not hit this).\n",
    "    valid_cols = [c for c in range(n_classes) if len(np.unique(y_true[:, c])) > 1]\n",
    "    if valid_cols:\n",
    "        summary[\"auroc_macro\"] = roc_auc_score(y_true[:, valid_cols], y_prob[:, valid_cols], average=\"macro\")\n",
    "        summary[\"auroc_micro\"] = roc_auc_score(y_true[:, valid_cols], y_prob[:, valid_cols], average=\"micro\")\n",
    "        summary[\"auprc_macro\"] = average_precision_score(y_true[:, valid_cols], y_prob[:, valid_cols], average=\"macro\")\n",
    "        summary[\"auprc_micro\"] = average_precision_score(y_true[:, valid_cols], y_prob[:, valid_cols], average=\"micro\")\n",
    "    else:\n",
    "        summary[\"auroc_macro\"] = summary[\"auroc_micro\"] = float(\"nan\")\n",
    "        summary[\"auprc_macro\"] = summary[\"auprc_micro\"] = float(\"nan\")\n",
    "\n",
    "    spec, sens = per_class_specificity_sensitivity(y_true, y_pred)\n",
    "    summary[\"specificity_macro\"] = spec.mean()\n",
    "    summary[\"sensitivity_macro\"] = sens.mean()\n",
    "\n",
    "    mccs = [matthews_corrcoef(y_true[:, c], y_pred[:, c]) if len(np.unique(y_true[:, c])) > 1 else 0.0\n",
    "            for c in range(n_classes)]\n",
    "    kappas = [cohen_kappa_score(y_true[:, c], y_pred[:, c]) if len(np.unique(y_true[:, c])) > 1 else 0.0\n",
    "              for c in range(n_classes)]\n",
    "    summary[\"mcc_macro\"] = float(np.mean(mccs))\n",
    "    summary[\"cohen_kappa_macro\"] = float(np.mean(kappas))\n",
    "\n",
    "    # ---- per-class breakdown ----\n",
    "    per_class = {}\n",
    "    for c, name in enumerate(class_names):\n",
    "        entry = {\n",
    "            \"precision\": precision_score(y_true[:, c], y_pred[:, c], zero_division=0),\n",
    "            \"recall_sensitivity\": sens[c],\n",
    "            \"specificity\": spec[c],\n",
    "            \"f1\": f1_score(y_true[:, c], y_pred[:, c], zero_division=0),\n",
    "            \"mcc\": mccs[c],\n",
    "            \"cohen_kappa\": kappas[c],\n",
    "        }\n",
    "        if c in valid_cols:\n",
    "            entry[\"auroc\"] = roc_auc_score(y_true[:, c], y_prob[:, c])\n",
    "            entry[\"auprc\"] = average_precision_score(y_true[:, c], y_prob[:, c])\n",
    "        else:\n",
    "            entry[\"auroc\"] = entry[\"auprc\"] = float(\"nan\")\n",
    "        per_class[name] = entry\n",
    "\n",
    "    return {\"summary\": summary, \"per_class\": per_class}\n"
   ]
  },
