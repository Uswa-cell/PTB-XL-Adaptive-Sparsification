    "# =============================================================================\n",
    "# SECTION: Dataset Validation\n",
    "# INFRASTRUCTURE CHANGE: replaces ad hoc os.path.exists()/os.listdir() prints\n",
    "# against a hardcoded Modal path with a structured check for every file/\n",
