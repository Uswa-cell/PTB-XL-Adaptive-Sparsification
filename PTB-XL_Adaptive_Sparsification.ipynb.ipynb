    "\n",
    "    return {\"model\": model, \"test_metrics\": test_metrics, \"param_info\": param_info,\n",
    "            \"flops\": dense_flops, \"test_loader\": test_loader, \"test_ds\": test_ds, \"cfg\": cfg}\n"
   ]
