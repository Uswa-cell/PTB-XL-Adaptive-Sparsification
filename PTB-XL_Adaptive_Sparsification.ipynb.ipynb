   "source": [
    "## Models — SE-ResNet1D backbone, structured pruning, difficulty estimator, adaptive gate/model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "ba0cf3c3",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "# ---- from src/models/backbone.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/models/backbone.py\n",
    "------------------------\n",
    "Backbone architecture choice and justification\n",
    "-------------------------------------------------\n",
    "The sparsification literature review does not prescribe an ECG backbone (it\n",
    "is a compression-methods review). For the backbone itself we follow the\n",
    "best-performing, most reproducible architecture family identified in the\n",
    "PTB-XL benchmark literature: Strodthoff et al. (2021) found ResNet-style 1D\n",
    "CNNs (their `xresnet1d` family) to be consistently among the top performers\n",
    "on the PTB-XL superclass task, and squeeze-and-excitation (SE) blocks (Hu et\n",
    "al., 2018) are a well-established, cheap (<1% parameter overhead) accuracy\n",
    "improvement for exactly this kind of channel-recalibration-sensitive signal.\n",
    "We therefore use a compact SE-ResNet1D: residual blocks for stable deep\n",
    "training, SE gating for channel-wise recalibration, at a depth appropriate\n",
    "for a single-GPU, one-year MS thesis compute budget (this is the \"hybrid\n",
    "CNN + attention-like channel gating\" option from the requirements, without\n",
    "adding a full Transformer stage that Section VII-B of the literature review\n",
    "explicitly flags as too computationally expensive to differentiate a thesis\n",
    "contribution from the crowded transformer-sparsification literature).\n",
    "\n",
    "Structured-sparsification compatibility\n",
    "-------------------------------------------\n",
    "The stage mask argument is retained for backward compatibility and diagnostic\n",
    "experiments, but the FINAL thesis static/adaptive efficiency experiments do\n",
    "not claim computational savings from post-convolution zero masks. Instead,\n",
    "src/models/pruning.py physically constructs narrower ECGBackbone experts so\n",
    "the pruned Conv1d operations are genuinely absent from execution.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "\n",
    "class SEBlock1D(nn.Module):\n",
    "    def __init__(self, channels: int, reduction: int = 8):\n",
    "        super().__init__()\n",
    "        hidden = max(4, channels // reduction)\n",
    "        self.pool = nn.AdaptiveAvgPool1d(1)\n",
    "        self.fc = nn.Sequential(\n",
    "            nn.Linear(channels, hidden), nn.ReLU(inplace=True),\n",
    "            nn.Linear(hidden, channels), nn.Sigmoid(),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        b, c, _ = x.shape\n",
    "        s = self.pool(x).view(b, c)\n",
    "        s = self.fc(s).view(b, c, 1)\n",
    "        return x * s\n",
    "\n",
    "\n",
    "class ResidualSEBlock1D(nn.Module):\n",
    "    def __init__(self, c_in: int, c_out: int, kernel_size: int, stride: int = 1, se_reduction: int = 8):\n",
    "        super().__init__()\n",
    "        pad = kernel_size // 2\n",
    "        self.conv1 = nn.Conv1d(c_in, c_out, kernel_size, stride=stride, padding=pad, bias=False)\n",
    "        self.bn1 = nn.BatchNorm1d(c_out)\n",
    "        self.conv2 = nn.Conv1d(c_out, c_out, kernel_size, stride=1, padding=pad, bias=False)\n",
    "        self.bn2 = nn.BatchNorm1d(c_out)\n",
    "        self.se = SEBlock1D(c_out, se_reduction)\n",
    "        self.act = nn.ReLU(inplace=True)\n",
    "\n",
    "        self.shortcut = None\n",
    "        if stride != 1 or c_in != c_out:\n",
    "            self.shortcut = nn.Sequential(\n",
    "                nn.Conv1d(c_in, c_out, 1, stride=stride, bias=False),\n",
    "                nn.BatchNorm1d(c_out),\n",
    "            )\n",
    "\n",
    "    def forward(self, x):\n",
    "        identity = x if self.shortcut is None else self.shortcut(x)\n",
    "        out = self.act(self.bn1(self.conv1(x)))\n",
    "        out = self.bn2(self.conv2(out))\n",
    "        out = self.se(out)\n",
    "        out = self.act(out + identity)\n",
    "        return out\n",
    "\n",
    "\n",
    "class MaskableStage(nn.Module):\n",
    "    \"\"\"One \"stage\" = `depth` ResidualSEBlocks, all sharing `c_out` channels.\n",
    "    The stage's final output channels can be scaled by an external mask\n",
    "    (binary for static pruning, soft/mixture for the adaptive gate).\"\"\"\n",
    "    def __init__(self, c_in, c_out, depth, kernel_size, stride, se_reduction):\n",
    "        super().__init__()\n",
    "        blocks = [ResidualSEBlock1D(c_in, c_out, kernel_size, stride, se_reduction)]\n",
    "        for _ in range(depth - 1):\n",
    "            blocks.append(ResidualSEBlock1D(c_out, c_out, kernel_size, 1, se_reduction))\n",
    "        self.blocks = nn.ModuleList(blocks)\n",
    "        self.pool = nn.MaxPool1d(2)\n",
    "        self.c_out = c_out\n",
    "\n",
    "    def forward(self, x, channel_mask=None):\n",
    "        for blk in self.blocks:\n",
    "            x = blk(x)\n",
    "        if channel_mask is not None:\n",
    "            x = x * channel_mask.view(*([1, -1] + [1] * (x.dim() - 2)))\n",
    "        x = self.pool(x)\n",
    "        return x\n",
    "\n",
    "\n",
    "class ECGBackbone(nn.Module):\n",
    "    \"\"\"SE-ResNet1D backbone. Stages expose maskable channel outputs for\n",
    "    structured sparsification, matching src/models/pruning.py and\n",
    "    src/models/adaptive_gate.py.\"\"\"\n",
    "\n",
    "    def __init__(self, num_classes: int, in_leads: int = 12, stem_channels: int = 32,\n",
    "                 block_channels=(32, 64, 128, 256), block_depth: int = 2, se_reduction: int = 8,\n",
    "                 dropout: float = 0.5, multilabel: bool = True):\n",
    "        super().__init__()\n",
    "        self.stem = nn.Sequential(\n",
    "            nn.Conv1d(in_leads, stem_channels, kernel_size=15, padding=7, bias=False),\n",
    "            nn.BatchNorm1d(stem_channels),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "        c_in = stem_channels\n",
    "        self.stages = nn.ModuleList()\n",
    "        for c_out in block_channels:\n",
    "            self.stages.append(MaskableStage(c_in, c_out, block_depth, kernel_size=5, stride=1,\n",
    "                                              se_reduction=se_reduction))\n",
    "            c_in = c_out\n",
    "\n",
    "        self.gap = nn.AdaptiveAvgPool1d(1)\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(block_channels[-1], 128),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(dropout),\n",
    "            nn.Linear(128, num_classes),\n",
    "        )\n",
    "        self.block_channels = list(block_channels)\n",
    "        self.multilabel = multilabel  # informational; loss/activation handled outside the model\n",
    "\n",
    "    def forward(self, x, masks: list | None = None):\n",
    "        m = masks or [None] * len(self.stages)\n",
    "        x = self.stem(x)\n",
    "        for stage, mask in zip(self.stages, m):\n",
    "            x = stage(x, mask)\n",
    "        x = self.gap(x)\n",
    "        return self.classifier(x)\n"
   ]
