   "source": [
    "def calibrate_routing_thresholds(\n",
    "    adaptive_model,\n",
    "    val_loader,\n",
    "    device\n",
    "):\n",
    "    adaptive_model.eval()\n",
    "\n",
    "    all_difficulty = []\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for signals, _ in val_loader:\n",
    "\n",
    "            signals = signals.to(\n",
    "                device,\n",
    "                non_blocking=True\n",
    "            )\n",
    "\n",
    "            difficulty = adaptive_model.difficulty(\n",
    "                signals\n",
    "            )\n",
    "\n",
    "            all_difficulty.append(\n",
    "                difficulty.detach().cpu()\n",
    "            )\n",
    "\n",
    "    all_difficulty = torch.cat(\n",
    "        all_difficulty,\n",
    "        dim=0\n",
    "    )\n",
    "\n",
    "    quantiles = torch.arange(\n",
    "        1,\n",
    "        adaptive_model.n_levels,\n",
    "        dtype=torch.float32\n",
    "    ) / adaptive_model.n_levels\n",
    "\n",
    "    thresholds = torch.quantile(\n",
    "        all_difficulty,\n",
    "        quantiles\n",
    "    )\n",
    "\n",
    "    adaptive_model.set_routing_thresholds(\n",
    "        thresholds.to(device)\n",
    "    )\n",
    "\n",
    "    print(\"\\nCalibrated routing thresholds:\")\n",
    "    print(thresholds.tolist())\n",
    "\n",
    "    print(\n",
    "        \"Difficulty range:\",\n",
    "        all_difficulty.min().item(),\n",
    "        \"to\",\n",
    "        all_difficulty.max().item()\n",
    "    )\n",
    "\n",
    "    return thresholds"
   ]
  },
