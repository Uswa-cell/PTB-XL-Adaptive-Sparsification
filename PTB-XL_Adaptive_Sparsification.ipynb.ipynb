    "# ============================================================\n",
    "# ANTI-COLLAPSE FIX VALIDATION (single-seed diagnostic)\n",
    "# ============================================================\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def diagnose_adaptive_routing(adaptive_model, loader, device):\n",
    "    \"\"\"\n",
    "    Single-seed sanity check for the anti-collapse fix. This is deliberately\n",
    "    lighter-weight than the full Phase-4 diagnostic suite (that comes later,\n",
    "    once this passes) — it only checks the two things that directly falsify\n",
    "    or support the fix:\n",
    "\n",
    "      1. Spearman(difficulty, per-sample proxy loss): should be positive and\n",
    "         non-trivial if `difficulty` now reflects real per-sample hardness.\n",
    "      2. Largest single-expert share under hard routing: should no longer\n",
    "         sit near 100%.\n",
    "    \"\"\"\n",
    "    adaptive_model.eval()\n",
    "\n",
    "    difficulties, proxy_losses, selections, gate_probs_all = [], [], [], []\n",
    "\n",
    "    for signals, labels in loader:\n",
    "        signals = signals.to(device, non_blocking=True)\n",
    "        labels = labels.to(device, non_blocking=True)\n",
    "\n",
    "        hard_out = adaptive_model(signals, hard=True)\n",
    "        per_sample_loss = F.binary_cross_entropy_with_logits(\n",
    "            hard_out[\"logits\"].float(), labels.float(), reduction=\"none\"\n",
    "        ).mean(dim=1)\n",
    "\n",
    "        difficulties.append(hard_out[\"difficulty\"].detach().cpu())\n",
    "        proxy_losses.append(per_sample_loss.detach().cpu())\n",
    "        selections.append(hard_out[\"selected_expert\"].detach().cpu())\n",
    "\n",
    "        soft_out = adaptive_model(signals, hard=False)\n",
    "        gate_probs_all.append(soft_out[\"gate_probs\"].detach().cpu())\n",
    "\n",
    "    difficulty = torch.cat(difficulties).numpy()\n",
    "    proxy_loss = torch.cat(proxy_losses).numpy()\n",
    "    selected = torch.cat(selections).numpy()\n",
    "    gate_probs = torch.cat(gate_probs_all).numpy()\n",
    "\n",
    "    rho, p_value = spearmanr(difficulty, proxy_loss)\n",
    "\n",
    "    mean_probs = gate_probs.mean(axis=0)\n",
    "    entropy = float(-(mean_probs * np.log(mean_probs + 1e-12)).sum())\n",
    "    max_entropy = float(np.log(gate_probs.shape[1]))\n",
    "\n",
    "    n_experts = gate_probs.shape[1]\n",
    "    counts = np.bincount(selected, minlength=n_experts)\n",
    "    max_share = 100.0 * counts.max() / max(len(selected), 1)\n",
    "    n_used = int((counts > 0).sum())\n",
    "\n",
    "    print(f\"Spearman(difficulty, per-sample proxy loss) = {rho:.3f} (p={p_value:.2e})\")\n",
    "    print(f\"Routing entropy: {entropy:.3f} / max {max_entropy:.3f} \"\n",
    "          f\"({100 * entropy / max_entropy:.1f}% of max)\")\n",
    "    print(f\"Experts actually used under hard routing: {n_used} / {n_experts}\")\n",
    "    print(f\"Largest single-expert share: {max_share:.1f}%\")\n",
    "    print(\"Per-expert share:\",\n",
    "          {i: f\"{100 * c / max(len(selected), 1):.1f}%\" for i, c in enumerate(counts)})\n",
    "\n",
    "    if max_share > 90.0:\n",
    "        print(\n",
    "            \"\\nSTILL COLLAPSED: one expert still absorbs >90% of samples. \"\n",
    "            \"Increase consistency_lambda and/or balance_lambda (start by \"\n",
    "            \"roughly doubling both) and retrain this single seed again \"\n",
    "            \"before moving on.\"\n",
    "        )\n",
    "    elif rho < 0.2:\n",
    "        print(\n",
    "            \"\\nWARNING: routing is now spread across experts, but difficulty \"\n",
    "            \"is not yet meaningfully correlated with actual per-sample \"\n",
    "            \"hardness (rho < 0.2). The gate may be routing on noise rather \"\n",
    "            \"than genuine difficulty — inspect DifficultyEstimator features \"\n",
    "            \"before trusting this run.\"\n",
    "        )\n",
    "    else:\n",
    "        print(\n",
    "            \"\\nRouting is spread across multiple experts AND correlated with \"\n",
    "            \"per-sample difficulty. Safe to proceed to the ablation (Phase 6) \"\n",
    "            \"and the full five-seed experiment (Phase 7) on this basis.\"\n",
    "        )\n",
    "\n",
    "    return {\n",
    "        \"difficulty\": difficulty,\n",
    "        \"proxy_loss\": proxy_loss,\n",
    "        \"selected_expert\": selected,\n",
    "        \"gate_probs\": gate_probs,\n",
    "        \"spearman_rho\": float(rho),\n",
    "        \"spearman_p\": float(p_value),\n",
    "        \"routing_entropy\": entropy,\n",
    "        \"max_routing_entropy\": max_entropy,\n",
    "        \"max_expert_share_pct\": float(max_share),\n",
    "    }\n",
    "\n",
    "\n",
    "routing_diagnostic = diagnose_adaptive_routing(adaptive_model, test_loader, device)\n"
   ]
  },
