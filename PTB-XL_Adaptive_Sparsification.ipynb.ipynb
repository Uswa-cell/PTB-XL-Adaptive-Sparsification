    "# ============================================================\n",
    "# DIFFICULTY vs EXECUTED COMPUTATION\n",
    "# ============================================================\n",
    "\n",
    "adaptive_model_eval.eval()\n",
    "all_difficulty = []\n",
    "all_selected = []\n",
    "all_true = []\n",
    "all_prob = []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for signals, labels in test_loader:\n",
    "        signals = signals.to(device, non_blocking=True)\n",
    "        output = adaptive_model_eval(signals, hard=True)\n",
    "        all_difficulty.append(output[\"difficulty\"].detach().cpu())\n",
    "        all_selected.append(output[\"selected_expert\"].detach().cpu())\n",
    "        all_true.append(labels.cpu())\n",
    "        all_prob.append(torch.sigmoid(output[\"logits\"]).detach().cpu())\n",
    "\n",
    "difficulty = torch.cat(all_difficulty).numpy()\n",
    "selected_expert = torch.cat(all_selected).numpy().astype(int)\n",
    "difficulty_y_true = torch.cat(all_true).numpy()\n",
    "difficulty_y_prob = torch.cat(all_prob).numpy()\n",
    "\n",
    "expert_macs_np = np.asarray(adaptive_result[\"expert_macs\"], dtype=np.float64)\n",
    "expert_sparsity_np = np.asarray(adaptive_result[\"sparsity_levels\"], dtype=np.float64)\n",
    "sample_macs = expert_macs_np[selected_expert]\n",
    "sample_sparsity = expert_sparsity_np[selected_expert]\n",
    "\n",
    "q1, q2 = np.quantile(difficulty, [1 / 3, 2 / 3])\n",
    "difficulty_bucket = np.where(\n",
    "    difficulty <= q1,\n",
    "    \"Easy\",\n",
    "    np.where(difficulty <= q2, \"Medium\", \"Hard\"),\n",
    ")\n",
    "\n",
    "difficulty_rows = []\n",
    "for bucket_name in [\"Easy\", \"Medium\", \"Hard\"]:\n",
    "    mask = difficulty_bucket == bucket_name\n",
    "    bucket_metrics = compute_full_metric_suite(\n",
    "        difficulty_y_true[mask],\n",
    "        difficulty_y_prob[mask],\n",
    "        cfg.task.superclasses,\n",
    "    )[\"summary\"]\n",
    "\n",
    "    difficulty_rows.append({\n",
    "        \"Difficulty\": bucket_name,\n",
    "        \"N\": int(mask.sum()),\n",
    "        \"Mean difficulty\": float(difficulty[mask].mean()),\n",
    "        \"Mean selected sparsity\": float(sample_sparsity[mask].mean()),\n",
    "        \"Mean MACs\": float(sample_macs[mask].mean()),\n",
    "        \"MACs (% dense)\": float(\n",
    "            100.0 * sample_macs[mask].mean() / max(adaptive_result[\"dense_macs\"], 1.0)\n",
    "        ),\n",
    "        \"Macro-F1\": float(bucket_metrics[\"f1_macro\"]),\n",
    "        \"Macro-AUROC\": float(bucket_metrics.get(\"auroc_macro\", np.nan)),\n",
