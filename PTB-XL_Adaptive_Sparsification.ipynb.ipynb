    "\"\"\"\n",
    "src/evaluation/visualization.py\n",
    "-----------------------------------\n",
    "Publication-ready figures: training/validation curves, per-class ROC and\n",
    "Precision-Recall curves, confusion matrices, and misclassified-example\n",
    "plots. Every function saves a PNG at 300 DPI (publication print quality)\n",
    "into `figures_dir` and also returns the Matplotlib Figure for inline\n",
    "notebook display.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import os\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import roc_curve, precision_recall_curve, confusion_matrix, auc\n",
    "\n",
    "\n",
    "def _save(fig, figures_dir, name):\n",
    "    Path(figures_dir).mkdir(parents=True, exist_ok=True)\n",
    "    fig.savefig(os.path.join(figures_dir, f\"{name}.png\"), dpi=300, bbox_inches=\"tight\")\n",
    "\n",
    "\n",
    "def plot_training_curves(metrics_csv_rows: list[dict], figures_dir: str, run_name: str):\n",
    "    steps = [r[\"step\"] for r in metrics_csv_rows]\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 4.5))\n",
    "\n",
    "    axes[0].plot(steps, [r.get(\"train_loss\", np.nan) for r in metrics_csv_rows], label=\"Train Loss\")\n",
    "    axes[0].plot(steps, [r.get(\"val_loss\", np.nan) for r in metrics_csv_rows], label=\"Val Loss\")\n",
    "    axes[0].set_xlabel(\"Epoch\"); axes[0].set_ylabel(\"Loss\"); axes[0].set_title(\"Loss Curves\")\n",
    "    axes[0].legend(); axes[0].grid(alpha=0.3)\n",
    "\n",
    "    axes[1].plot(steps, [r.get(\"auroc_macro\", np.nan) for r in metrics_csv_rows], label=\"Val Macro-AUROC\")\n",
    "    axes[1].plot(steps, [r.get(\"f1_macro\", np.nan) for r in metrics_csv_rows], label=\"Val Macro-F1\")\n",
    "    axes[1].set_xlabel(\"Epoch\"); axes[1].set_ylabel(\"Score\"); axes[1].set_title(\"Validation Metrics\")\n",
    "    axes[1].legend(); axes[1].grid(alpha=0.3)\n",
    "\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, f\"{run_name}_training_curves\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_roc_curves(y_true, y_prob, class_names, figures_dir, run_name):\n",
    "    fig, ax = plt.subplots(figsize=(6, 6))\n",
    "    for c, name in enumerate(class_names):\n",
    "        if len(np.unique(y_true[:, c])) < 2:\n",
    "            continue\n",
    "        fpr, tpr, _ = roc_curve(y_true[:, c], y_prob[:, c])\n",
    "        ax.plot(fpr, tpr, label=f\"{name} (AUC={auc(fpr, tpr):.3f})\")\n",
    "    ax.plot([0, 1], [0, 1], \"k--\", alpha=0.4)\n",
    "    ax.set_xlabel(\"False Positive Rate\"); ax.set_ylabel(\"True Positive Rate\")\n",
    "    ax.set_title(\"Per-Class ROC Curves\"); ax.legend(loc=\"lower right\")\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, f\"{run_name}_roc_curves\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_pr_curves(y_true, y_prob, class_names, figures_dir, run_name):\n",
    "    fig, ax = plt.subplots(figsize=(6, 6))\n",
    "    for c, name in enumerate(class_names):\n",
    "        if len(np.unique(y_true[:, c])) < 2:\n",
    "            continue\n",
    "        precision, recall, _ = precision_recall_curve(y_true[:, c], y_prob[:, c])\n",
    "        ax.plot(recall, precision, label=name)\n",
    "    ax.set_xlabel(\"Recall\"); ax.set_ylabel(\"Precision\")\n",
    "    ax.set_title(\"Per-Class Precision-Recall Curves\"); ax.legend(loc=\"lower left\")\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, f\"{run_name}_pr_curves\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_confusion_matrices(y_true, y_pred, class_names, figures_dir, run_name):\n",
    "    \"\"\"One-vs-rest confusion matrix per class (standard for multilabel).\"\"\"\n",
    "    n = len(class_names)\n",
    "    fig, axes = plt.subplots(1, n, figsize=(3.2 * n, 3.2))\n",
    "    for c, name in enumerate(class_names):\n",
    "        cm = confusion_matrix(y_true[:, c], y_pred[:, c], labels=[0, 1])\n",
    "        ax = axes[c]\n",
    "        im = ax.imshow(cm, cmap=\"Blues\")\n",
    "        ax.set_title(name)\n",
    "        ax.set_xticks([0, 1]); ax.set_yticks([0, 1])\n",
    "        ax.set_xticklabels([\"Neg\", \"Pos\"]); ax.set_yticklabels([\"Neg\", \"Pos\"])\n",
    "        for i in range(2):\n",
    "            for j in range(2):\n",
    "                ax.text(j, i, cm[i, j], ha=\"center\", va=\"center\",\n",
    "                        color=\"white\" if cm[i, j] > cm.max() / 2 else \"black\")\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, f\"{run_name}_confusion_matrices\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_misclassification_examples(signals, y_true, y_pred, class_names, figures_dir, run_name, n_examples=4):\n",
    "    \"\"\"signals: (N, leads, T) numpy. Plots lead-I of the first `n_examples`\n",
    "    misclassified (any-label-wrong) samples with true/pred labels.\"\"\"\n",
    "    wrong_mask = (y_true != y_pred).any(axis=1)\n",
    "    wrong_idx = np.where(wrong_mask)[0][:n_examples]\n",
    "    if len(wrong_idx) == 0:\n",
    "        return None\n",
    "    fig, axes = plt.subplots(len(wrong_idx), 1, figsize=(12, 2.5 * len(wrong_idx)), squeeze=False)\n",
    "    for row, idx in enumerate(wrong_idx):\n",
    "        ax = axes[row, 0]\n",
    "        ax.plot(signals[idx, 0])\n",
    "        true_lbls = [class_names[c] for c in range(len(class_names)) if y_true[idx, c] == 1]\n",
    "        pred_lbls = [class_names[c] for c in range(len(class_names)) if y_pred[idx, c] == 1]\n",
    "        ax.set_title(f\"True: {true_lbls} | Pred: {pred_lbls}\")\n",
    "        ax.grid(alpha=0.3)\n",
    "    fig.tight_layout()\n",
    "    _save(fig, figures_dir, f\"{run_name}_misclassification_examples\")\n",
    "    return fig\n"
   ]
  },
