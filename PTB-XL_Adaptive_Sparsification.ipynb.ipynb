    "# ---- FINAL adaptive model: physical expert routing + learned hard gate ----\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "\n",
    "class AdaptiveECGClassifier(nn.Module):\n",
    "    \"\"\"\n",
    "    Input-adaptive structured-sparsification classifier.\n",
    "\n",
    "    Each routing level is represented by a physically instantiated ECGBackbone\n",
    "    with a different channel width.\n",
    "\n",
    "    Training:\n",
    "        Soft differentiable routing is used.\n",
    "\n",
    "    Hard inference:\n",
    "        The learned adaptive gate selects the expert.\n",
    "\n",
    "    Expected expert order:\n",
    "        index 0 -> 90% sparse\n",
    "        index 1 -> 60% sparse\n",
    "        index 2 -> 30% sparse\n",
    "        index 3 -> dense / 0% sparse\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        experts: list[nn.Module],\n",
    "        sparsity_levels: list[float],\n",
    "        num_classes: int,\n",
    "        in_leads: int = 12,\n",
    "        gate_temperature: float = 1.0,\n",
    "        use_heuristic_gate: bool = False,\n",
    "    ):\n",
    "        super().__init__()\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Validation\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        if len(experts) != len(sparsity_levels):\n",
    "            raise ValueError(\n",
    "                \"experts and sparsity_levels must have the same length\"\n",
    "            )\n",
    "\n",
    "        if len(experts) < 2:\n",
    "            raise ValueError(\n",
    "                \"adaptive routing requires at least two experts\"\n",
    "            )\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Store experts / metadata\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        self.experts = nn.ModuleList(\n",
    "            experts\n",
    "        )\n",
    "\n",
    "        self.sparsity_levels = list(\n",
    "            sparsity_levels\n",
    "        )\n",
    "\n",
    "        self.n_levels = len(\n",
    "            experts\n",
    "        )\n",
    "\n",
    "        self.num_classes = int(\n",
    "            num_classes\n",
    "        )\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Difficulty estimator\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        if use_heuristic_gate:\n",
    "\n",
    "            self.difficulty = HeuristicDifficultyGate()\n",
    "\n",
    "        else:\n",
    "\n",
    "            self.difficulty = DifficultyEstimator(\n",
    "                in_leads=in_leads\n",
    "            )\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Learned adaptive gate\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        self.gate = AdaptiveGate(\n",
    "            n_levels=self.n_levels,\n",
    "            temperature=gate_temperature,\n",
    "        )\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Optional routing-threshold buffer\n",
    "        #\n",
    "        # Kept ONLY for backward compatibility with previously modified\n",
    "        # checkpoints / analysis cells.\n",
    "        #\n",
    "        # IMPORTANT:\n",
    "        # The FINAL forward() below does NOT use these thresholds.\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        if self.n_levels == 4:\n",
    "\n",
    "            default_thresholds = torch.tensor(\n",
    "                [0.25, 0.50, 0.75],\n",
    "                dtype=torch.float32\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "            default_thresholds = torch.linspace(\n",
    "                0.0,\n",
    "                1.0,\n",
    "                steps=self.n_levels + 1\n",
    "            )[1:-1]\n",
    "\n",
    "        self.register_buffer(\n",
    "            \"routing_thresholds\",\n",
    "            default_thresholds\n",
    "        )\n",
    "\n",
    "    # =================================================================\n",
    "    # OPTIONAL THRESHOLD HELPERS\n",
    "    #\n",
    "    # These remain only so old calibration-analysis cells do not break.\n",
    "    # They are NOT used by final learned hard routing.\n",
    "    # =================================================================\n",
    "\n",
    "    def set_routing_thresholds(\n",
    "        self,\n",
    "        thresholds\n",
    "    ):\n",
    "        thresholds = torch.as_tensor(\n",
    "            thresholds,\n",
    "            dtype=torch.float32,\n",
    "            device=self.routing_thresholds.device\n",
    "        )\n",
    "\n",
    "        expected = self.n_levels - 1\n",
    "\n",
    "        if thresholds.numel() != expected:\n",
    "            raise ValueError(\n",
    "                f\"Expected {expected} routing thresholds, \"\n",
    "                f\"but received {thresholds.numel()}.\"\n",
    "            )\n",
    "\n",
    "        thresholds = torch.sort(\n",
    "            thresholds.flatten()\n",
    "        ).values\n",
    "\n",
    "        self.routing_thresholds.copy_(\n",
    "            thresholds\n",
    "        )\n",
    "\n",
    "    def get_routing_thresholds(\n",
    "        self\n",
    "    ) -> torch.Tensor:\n",
    "\n",
    "        return (\n",
    "            self.routing_thresholds\n",
    "            .detach()\n",
    "            .clone()\n",
    "        )\n",
    "\n",
    "    def route_by_difficulty(\n",
    "        self,\n",
    "        difficulty: torch.Tensor\n",
    "    ) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Optional analysis-only threshold routing.\n",
    "\n",
    "        NOT used by final forward() hard inference.\n",
    "        \"\"\"\n",
    "\n",
    "        difficulty = difficulty.clamp(\n",
    "            0.0,\n",
    "            1.0\n",
    "        )\n",
    "\n",
    "        selected_expert = torch.zeros_like(\n",
    "            difficulty,\n",
    "            dtype=torch.long\n",
    "        )\n",
    "\n",
    "        for expert_idx, threshold in enumerate(\n",
    "            self.routing_thresholds,\n",
    "            start=1\n",
    "        ):\n",
    "\n",
    "            selected_expert[\n",
    "                difficulty >= threshold\n",
    "            ] = expert_idx\n",
    "\n",
    "        return selected_expert\n",
    "\n",
    "    # =================================================================\n",
    "    # FORWARD\n",
    "    # =================================================================\n",
    "\n",
    "    def forward(\n",
    "        self,\n",
    "        x: torch.Tensor,\n",
    "        hard: bool = False\n",
    "    ):\n",
    "        \"\"\"\n",
    "        Parameters\n",
    "        ----------\n",
    "        x:\n",
    "            ECG tensor of shape (B, leads, T)\n",
    "\n",
    "        hard=False:\n",
    "            Soft differentiable routing used during training.\n",
    "\n",
    "        hard=True:\n",
    "            Learned discrete routing used during deployment/testing.\n",
    "        \"\"\"\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Difficulty estimation\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        difficulty = self.difficulty(\n",
    "            x\n",
    "        )\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Learned gate\n",
    "        #\n",
    "        # hard=False:\n",
    "        #     soft probabilities for differentiable training\n",
    "        #\n",
    "        # hard=True:\n",
    "        #     hard / one-hot learned routing\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        gate_probs = self.gate(\n",
    "            difficulty,\n",
    "            hard=hard\n",
    "        )\n",
    "\n",
    "        # =============================================================\n",
    "        # SOFT TRAINING\n",
    "        # =============================================================\n",
    "\n",
    "        if not hard:\n",
    "\n",
    "            expert_logits = []\n",
    "\n",
    "            for expert in self.experts:\n",
    "\n",
    "                expert_output = expert(\n",
    "                    x\n",
    "                )\n",
    "\n",
    "                expert_logits.append(\n",
    "                    expert_output\n",
    "                )\n",
    "\n",
    "            # Shape:\n",
    "            # (B, n_experts, n_classes)\n",
    "            stacked_logits = torch.stack(\n",
    "                expert_logits,\n",
    "                dim=1\n",
    "            )\n",
    "\n",
    "            # Differentiable mixture of experts\n",
    "            logits = (\n",
    "                stacked_logits\n",
    "                * gate_probs.unsqueeze(-1)\n",
    "            ).sum(\n",
    "                dim=1\n",
    "            )\n",
    "\n",
    "            # Diagnostic only\n",
    "            selected_expert = gate_probs.argmax(\n",
    "                dim=1\n",
    "            )\n",
    "\n",
    "        # =============================================================\n",
    "        # HARD LEARNED ROUTING\n",
    "        # =============================================================\n",
    "\n",
    "        else:\n",
    "\n",
    "            # ---------------------------------------------------------\n",
    "            # IMPORTANT:\n",
    "            # Use LEARNED gate decision.\n",
    "            #\n",
    "            # Do NOT use route_by_difficulty() here.\n",
    "            # The forced calibrated 25/25/25/25 routing caused a large\n",
    "            # performance drop.\n",
    "            # ---------------------------------------------------------\n",
    "\n",
    "            selected_expert = gate_probs.argmax(\n",
    "                dim=1\n",
    "            )\n",
    "\n",
    "            # Allocate output tensor\n",
    "            logits = x.new_empty(\n",
    "                (\n",
    "                    x.size(0),\n",
    "                    self.num_classes\n",
    "                )\n",
    "            )\n",
    "\n",
    "            # ---------------------------------------------------------\n",
    "            # True conditional execution\n",
    "            #\n",
    "            # Only the experts selected by samples are actually executed.\n",
    "            # ---------------------------------------------------------\n",
    "\n",
    "            for expert_idx, expert in enumerate(\n",
    "                self.experts\n",
    "            ):\n",
    "\n",
    "                sample_idx = (\n",
    "                    selected_expert\n",
    "                    == expert_idx\n",
    "                ).nonzero(\n",
    "                    as_tuple=True\n",
    "                )[0]\n",
    "\n",
    "                if sample_idx.numel() == 0:\n",
    "                    continue\n",
    "\n",
    "                expert_input = x.index_select(\n",
    "                    0,\n",
    "                    sample_idx\n",
    "                )\n",
    "\n",
    "                expert_output = expert(\n",
    "                    expert_input\n",
    "                )\n",
    "\n",
    "                logits.index_copy_(\n",
    "                    0,\n",
    "                    sample_idx,\n",
    "                    expert_output\n",
    "                )\n",
    "\n",
    "        # -------------------------------------------------------------\n",
    "        # Return outputs and routing diagnostics\n",
    "        # -------------------------------------------------------------\n",
    "\n",
    "        return {\n",
    "            \"logits\": logits,\n",
    "            \"difficulty\": difficulty,\n",
    "            \"gate_probs\": gate_probs,\n",
    "            \"selected_expert\": selected_expert,\n",
    "        }\n",
    "\n",
    "    # =================================================================\n",
    "    # ENERGY\n",
    "    # =================================================================\n",
    "\n",
    "    def expected_energy_per_sample(\n",
    "        self,\n",
    "        gate_probs: torch.Tensor,\n",
    "        energy_per_level: torch.Tensor,\n",
    "    ) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Differentiable expected energy used during soft training.\n",
    "        \"\"\"\n",
    "\n",
    "        return (\n",
    "            gate_probs\n",
    "            @ energy_per_level\n",
    "        )\n",
    "\n",
    "    def hard_energy_per_sample(\n",
    "        self,\n",
    "        selected_expert: torch.Tensor,\n",
    "        energy_per_level: torch.Tensor,\n",
    "    ) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Analytical energy of the actually selected hard expert.\n",
    "        \"\"\"\n",
    "\n",
    "        energy_per_level = energy_per_level.to(\n",
    "            selected_expert.device\n",
    "        )\n",
    "\n",
    "        return energy_per_level[\n",
    "            selected_expert\n",
    "        ]\n",
    "\n",
    "    # =================================================================\n",
    "    # SPARSITY\n",
    "    # =================================================================\n",
    "\n",
    "    def expected_sparsity_per_sample(\n",
    "        self,\n",
    "        gate_probs: torch.Tensor\n",
    "    ) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Differentiable expected sparsity during soft training.\n",
    "        \"\"\"\n",
    "\n",
    "        levels = torch.tensor(\n",
    "            self.sparsity_levels,\n",
    "            device=gate_probs.device,\n",
    "            dtype=gate_probs.dtype,\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            gate_probs\n",
    "            @ levels\n",
    "        )\n",
    "\n",
    "    def hard_sparsity_per_sample(\n",
    "        self,\n",
    "        selected_expert: torch.Tensor\n",
    "    ) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Actual sparsity selected during hard routing.\n",
    "        \"\"\"\n",
    "\n",
    "        levels = torch.tensor(\n",
    "            self.sparsity_levels,\n",
    "            device=selected_expert.device,\n",
    "            dtype=torch.float32\n",
    "        )\n",
    "\n",
    "        return levels[\n",
    "            selected_expert\n",
    "        ]"
   ]
  },
