    "# ============================================================\n",
    "# PHYSICAL STATIC STRUCTURED PRUNING\n",
    "# Seed-safe independent checkpoints\n",
    "# ============================================================\n",
    "\n",
    "from __future__ import annotations\n",
    "import os\n",
    "import csv\n",
    "import numpy as np\n",
    "import torch\n",
    "\n",
    "\n",
    "def finetune_at_sparsity(\n",
    "    dense_model,\n",
    "    sparsity,\n",
    "    train_loader,\n",
    "    val_loader,\n",
    "    test_loader,\n",
    "    cfg,\n",
    "    class_counts,\n",
    "    device,\n",
    "    logger,\n",
    "    seed: int,\n",
    "    reuse_checkpoint: bool = False,\n",
    "):\n",
    "    \"\"\"Build and fine-tune one physically smaller seed-specific model.\"\"\"\n",
    "    set_seed(seed)\n",
    "\n",
    "    model = build_pruned_expert_from_dense(\n",
    "        dense_model,\n",
    "        sparsity=sparsity,\n",
    "        se_reduction=cfg.model.se_reduction,\n",
    "    ).to(device)\n",
    "\n",
    "    loss_fn_local = build_loss(\n",
    "        cfg.loss,\n",
    "        class_counts,\n",
    "        len(train_loader.dataset),\n",
    "    ).to(device)\n",
    "\n",
    "    optimizer = torch.optim.AdamW(\n",
    "        model.parameters(),\n",
    "        lr=cfg.optimizer.lr * 0.3,\n",
    "        weight_decay=cfg.optimizer.weight_decay,\n",
    "    )\n",
    "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "        optimizer,\n",
    "        mode=\"min\",\n",
    "        factor=0.5,\n",
    "        patience=2,\n",
    "    )\n",
    "\n",
    "    run_name = f\"static_physical_s{int(round(float(sparsity) * 100))}_seed{seed}\"\n",
    "    trainer = Trainer(\n",
    "        model,\n",
    "        optimizer,\n",
    "        scheduler,\n",
    "        loss_fn_local,\n",
    "        device,\n",
    "        cfg.task.superclasses,\n",
    "        run_name=run_name,\n",
    "        results_dir=cfg.paths.results_dir,\n",
    "        weights_dir=cfg.paths.weights_dir,\n",
    "        mixed_precision=cfg.training.mixed_precision,\n",
    "        energy_aware=False,\n",
    "    )\n",
    "\n",
    "    finetune_epochs = max(5, cfg.training.epochs // 6)\n",
    "    best_path = os.path.join(cfg.paths.weights_dir, f\"{run_name}_best.pt\")\n",
    "\n",
    "    if reuse_checkpoint and os.path.exists(best_path):\n",
    "        load_checkpoint(best_path, model, optimizer, scheduler)\n",
    "        logger.info(\"Loaded static checkpoint: %s\", best_path)\n",
    "    else:\n",
    "        trainer.fit(\n",
    "            train_loader,\n",
    "            val_loader,\n",
    "            finetune_epochs,\n",
    "            early_stopping_patience=min(4, finetune_epochs),\n",
    "        )\n",
    "        # Trainer.fit already restores the best checkpoint. This extra guard\n",
    "        # keeps behaviour safe if Trainer implementation changes later.\n",
    "        if os.path.exists(best_path):\n",
    "            load_checkpoint(best_path, model, optimizer, scheduler)\n",
    "\n",
    "    test_metrics = trainer.evaluate(test_loader, split=\"test\")\n",
    "    return model, test_metrics\n",
    "\n",
    "\n",
    "def run_static_pruning(\n",
    "    dense_model,\n",
    "    train_loader,\n",
    "    val_loader,\n",
    "    test_loader,\n",
    "    class_counts,\n",
    "    cfg,\n",
    "    seed=None,\n",
    "    reuse_checkpoint=False,\n",
    "    sparsity_levels=None,\n",
    "    config_path=None,\n",
    "):\n",
    "    if cfg is None:\n",
    "        cfg = load_config(config_path)\n",
    "\n",
    "    if seed is None:\n",
    "        seed = int(cfg.training.seed)\n",
    "    seed = int(seed)\n",
    "    set_seed(seed)\n",
    "\n",
    "    logger = get_logger(f\"run_static_pruning_seed{seed}\", cfg.paths.logs_dir)\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    dense_model = dense_model.to(device)\n",
    "\n",
    "    if sparsity_levels is None:\n",
    "        sparsity_levels = [\n",
    "            float(s) for s in cfg.sparsification.static_sparsity_levels\n",
    "        ]\n",
    "    else:\n",
    "        sparsity_levels = [float(s) for s in sparsity_levels]\n",
    "\n",
    "    dense_macs = count_real_conv1d_macs(\n",
    "        dense_model,\n",
    "        input_shape=(1, cfg.task.num_leads, cfg.task.signal_length),\n",
    "        device=device,\n",
    "    )\n",
    "\n",
    "    layer_specs = get_layer_specs(cfg)\n",
    "    energy_model = EnergyProxyModel(**cfg.energy_model)\n",
    "    dense_energy = float(energy_model.estimate_nj(layer_specs))\n",
    "\n",
    "    results = {}\n",
    "    for sparsity in sparsity_levels:\n",
    "        model, test_metrics = finetune_at_sparsity(\n",
    "            dense_model=dense_model,\n",
    "            sparsity=sparsity,\n",
    "            train_loader=train_loader,\n",
    "            val_loader=val_loader,\n",
    "            test_loader=test_loader,\n",
    "            cfg=cfg,\n",
    "            class_counts=class_counts,\n",
    "            device=device,\n",
    "            logger=logger,\n",
    "            seed=seed,\n",
    "            reuse_checkpoint=reuse_checkpoint,\n",
    "        )\n",
    "\n",
    "        achieved = float(actual_channel_sparsity(model, dense_model))\n",
    "        macs = int(count_real_conv1d_macs(\n",
    "            model,\n",
    "            input_shape=(1, cfg.task.num_leads, cfg.task.signal_length),\n",
    "            device=device,\n",
    "        ))\n",
    "        macs_pct = 100.0 * macs / max(float(dense_macs), 1.0)\n",
    "\n",
    "        estimated_energy = dense_energy * macs / max(float(dense_macs), 1.0)\n",
    "        energy_pct = 100.0 * estimated_energy / max(dense_energy, 1e-12)\n",
    "\n",
    "        results[float(sparsity)] = {\n",
    "            \"seed\": seed,\n",
    "            \"achieved_sparsity\": achieved,\n",
    "            \"flops\": macs,       # backward-compatible key\n",
    "            \"macs\": macs,\n",
    "            \"flops_pct_of_dense\": float(macs_pct),\n",
    "            \"energy_nj\": float(estimated_energy),\n",
    "            \"energy_pct_of_dense\": float(energy_pct),\n",
    "            \"test_metrics\": test_metrics[\"summary\"],\n",
    "            \"full_test_metrics\": test_metrics,\n",
    "            \"model\": model,\n",
    "        }\n",
    "\n",
    "    output_path = os.path.join(\n",
    "        cfg.paths.results_dir,\n",
    "        f\"static_pruning_summary_seed{seed}.csv\",\n",
    "    )\n",
    "    with open(output_path, \"w\", newline=\"\") as f:\n",
    "        writer = csv.writer(f)\n",
    "        writer.writerow([\n",
    "            \"seed\",\n",
    "            \"target_channel_sparsity\",\n",
    "            \"achieved_channel_sparsity\",\n",
    "            \"macs\",\n",
    "            \"macs_pct_of_dense\",\n",
    "            \"estimated_energy_nj\",\n",
    "            \"energy_pct_of_dense\",\n",
    "            \"test_macro_f1\",\n",
    "            \"test_auroc_macro\",\n",
    "        ])\n",
    "        for sparsity, result in results.items():\n",
    "            writer.writerow([\n",
    "                seed,\n",
    "                sparsity,\n",
    "                result[\"achieved_sparsity\"],\n",
    "                result[\"macs\"],\n",
    "                result[\"flops_pct_of_dense\"],\n",
    "                result[\"energy_nj\"],\n",
    "                result[\"energy_pct_of_dense\"],\n",
    "                result[\"test_metrics\"][\"f1_macro\"],\n",
    "                result[\"test_metrics\"].get(\"auroc_macro\", np.nan),\n",
    "            ])\n",
    "\n",
    "    logger.info(\"Static pruning summary written to %s\", output_path)\n",
    "    return results\n"
   ]
