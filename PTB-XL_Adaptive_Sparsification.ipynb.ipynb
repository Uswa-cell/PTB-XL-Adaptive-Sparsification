   "outputs": [],
   "source": [
    "# ---- from src/training/losses.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/training/losses.py\n",
    "--------------------------\n",
    "Loss function selection, per config.yaml `loss.type`. All options operate\n",
    "on multilabel logits (BCEWithLogits family), consistent with the multilabel\n",
    "task defined in src/preprocessing/labels.py.\n",
    "\n",
    "Choice rationale (standard imbalanced-multilabel ECG literature, not the\n",
    "sparsification review):\n",
    "  - `bce`            : plain BCEWithLogits, baseline reference.\n",
    "  - `weighted_bce`    : per-class pos_weight = n_negative/n_positive, the\n",
    "                        standard fix for label-frequency imbalance (used in\n",
    "                        Hannun et al. 2019-style arrhythmia classifiers).\n",
    "  - `focal`           : Focal Loss (Lin et al., 2017), down-weights\n",
    "                        easy/majority examples; chosen as the CONFIG DEFAULT\n",
    "                        because PTB-XL's HYP and CD classes are markedly\n",
    "                        rarer than NORM (Table in EDA module), and focal\n",
    "                        loss is the most consistently reported winner for\n",
    "                        this degree of imbalance in the ECG classification\n",
    "                        literature.\n",
    "  - `label_smoothing_bce`: soft targets (eps=config value) as a regulariser\n",
    "                        against label noise in SCP-code-derived weak labels.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "\n",
    "\n",
    "class FocalLossMultilabel(nn.Module):\n",
    "    def __init__(self, gamma: float = 2.0, alpha: float = 0.25, pos_weight: torch.Tensor | None = None):\n",
    "        super().__init__()\n",
    "        self.gamma = gamma\n",
    "        self.alpha = alpha\n",
    "        self.register_buffer(\"pos_weight\", pos_weight.float() if pos_weight is not None else None)\n",
    "\n",
    "    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n",
    "        bce = F.binary_cross_entropy_with_logits(\n",
    "            logits, targets, pos_weight=self.pos_weight, reduction=\"none\")\n",
    "        p = torch.sigmoid(logits)\n",
    "        p_t = p * targets + (1 - p) * (1 - targets)\n",
    "        modulating = (1 - p_t).clamp(min=1e-6) ** self.gamma\n",
    "        alpha_t = self.alpha * targets + (1 - self.alpha) * (1 - targets)\n",
    "        loss = alpha_t * modulating * bce\n",
    "        return loss.mean()\n",
    "\n",
    "\n",
    "class LabelSmoothingBCE(nn.Module):\n",
    "    def __init__(self, smoothing: float = 0.05, pos_weight: torch.Tensor | None = None):\n",
    "        super().__init__()\n",
    "        self.smoothing = smoothing\n",
    "        self.register_buffer(\"pos_weight\", pos_weight)\n",
    "\n",
    "    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n",
    "        smoothed = targets * (1 - self.smoothing) + 0.5 * self.smoothing\n",
    "        return F.binary_cross_entropy_with_logits(logits, smoothed, pos_weight=self.pos_weight)\n",
    "\n",
    "\n",
    "def compute_pos_weight(class_counts: torch.Tensor, n_samples: int) -> torch.Tensor:\n",
    "    \"\"\"pos_weight_c = n_negative_c / n_positive_c, clamped to avoid\n",
    "    exploding weights for extremely rare classes.\"\"\"\n",
    "    pos = class_counts.clamp(min=1)\n",
    "    neg = (n_samples - class_counts).clamp(min=1)\n",
    "    return (neg / pos).clamp(max=50.0)\n",
    "\n",
    "\n",
    "def build_loss(cfg, class_counts: torch.Tensor | None = None, n_samples: int | None = None) -> nn.Module:\n",
    "    pos_weight = None\n",
    "    if cfg.type in (\"weighted_bce\", \"focal\", \"label_smoothing_bce\") and class_counts is not None:\n",
    "        pos_weight = compute_pos_weight(class_counts, n_samples)\n",
    "        if torch.cuda.is_available():\n",
    "            pos_weight = pos_weight.cuda()\n",
    "\n",
    "    if cfg.type == \"bce\":\n",
    "        return nn.BCEWithLogitsLoss()\n",
    "    if cfg.type == \"weighted_bce\":\n",
    "        return nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n",
    "    if cfg.type == \"focal\":\n",
    "        return FocalLossMultilabel(gamma=cfg.focal_gamma, alpha=cfg.focal_alpha, pos_weight=pos_weight)\n",
    "    if cfg.type == \"label_smoothing_bce\":\n",
    "        return LabelSmoothingBCE(smoothing=cfg.label_smoothing, pos_weight=pos_weight)\n",
    "    raise ValueError(f\"Unknown loss type: {cfg.type}\")\n"
   ]
  },
