   "source": [
    "# ============================================================\n",
    "# DATASET AUTO-DETECTION / EXTRACTION\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import zipfile\n",
    "from pathlib import Path\n",
    "\n",
    "PTBXL_ZIP_NAME = (\n",
    "    \"ptb-xl-a-large-publicly-available-electrocardiography-dataset-1.0.3.zip\"\n",
    ")\n",
    "\n",
    "\n",
    "def find_dataset_root(search_dir: Path):\n",
    "    \"\"\"Return the folder containing ptbxl_database.csv, or None.\"\"\"\n",
    "    search_dir = Path(search_dir).expanduser()\n",
    "    if not search_dir.exists():\n",
    "        return None\n",
    "\n",
    "    direct = search_dir / \"ptbxl_database.csv\"\n",
    "    if direct.exists():\n",
    "        return search_dir.resolve()\n",
    "\n",
    "    # Search only inside plausible dataset directories to avoid recursively\n",
    "    # scanning an entire drive.\n",
    "    likely_children = [\n",
    "        search_dir / \"PTBXL\",\n",
    "        search_dir / \"ptbxl\",\n",
    "        search_dir / \"ptb-xl-a-large-publicly-available-electrocardiography-dataset-1.0.3\",\n",
    "    ]\n",
    "    for child in likely_children:\n",
    "        if child.exists():\n",
    "            direct_child = child / \"ptbxl_database.csv\"\n",
    "            if direct_child.exists():\n",
    "                return child.resolve()\n",
    "            matches = list(child.rglob(\"ptbxl_database.csv\"))\n",
    "            if matches:\n",
    "                return matches[0].parent.resolve()\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def _candidate_base_dirs():\n",
    "    home = Path.home()\n",
    "    bases = [\n",
    "        Path.cwd(),\n",
    "        home / \"Downloads\",\n",
    "        home / \"Documents\",\n",
    "        home / \"Desktop\",\n",
    "        home,\n",
    "    ]\n",
    "    # Preserve order while removing duplicates.\n",
    "    seen = set()\n",
    "    unique = []\n",
    "    for p in bases:\n",
    "        key = str(p.expanduser().resolve()) if p.exists() else str(p.expanduser())\n",
    "        if key not in seen:\n",
    "            seen.add(key)\n",
    "            unique.append(p)\n",
    "    return unique\n",
    "\n",
    "\n",
    "def locate_existing_dataset():\n",
    "    env_root = os.environ.get(\"PTBXL_ROOT\")\n",
    "    if env_root:\n",
    "        root = find_dataset_root(Path(env_root))\n",
    "        if root is None:\n",
    "            raise FileNotFoundError(\n",
    "                f\"PTBXL_ROOT is set to '{env_root}', but ptbxl_database.csv \"\n",
    "                \"could not be found there.\"\n",
    "            )\n",
    "        return root\n",
    "\n",
    "    for base in _candidate_base_dirs():\n",
    "        root = find_dataset_root(base)\n",
    "        if root is not None:\n",
    "            return root\n",
    "    return None\n",
    "\n",
    "\n",
    "def locate_dataset_zip():\n",
    "    env_zip = os.environ.get(\"PTBXL_ZIP\")\n",
    "    if env_zip:\n",
    "        p = Path(env_zip).expanduser()\n",
    "        if not p.exists():\n",
    "            raise FileNotFoundError(f\"PTBXL_ZIP points to a missing file: {p}\")\n",
    "        return p.resolve()\n",
    "\n",
    "    for base in _candidate_base_dirs():\n",
    "        p = base / PTBXL_ZIP_NAME\n",
    "        if p.exists():\n",
    "            return p.resolve()\n",
    "    return None\n",
    "\n",
    "\n",
    "def extract_dataset_if_needed(zip_path: Path, extract_dir: Path) -> Path:\n",
    "    existing = find_dataset_root(extract_dir)\n",
    "    if existing is not None:\n",
    "        print(\"Dataset already extracted:\", existing)\n",
    "        return existing\n",
    "\n",
    "    if zip_path is None or not Path(zip_path).exists():\n",
    "        raise FileNotFoundError(\n",
    "            \"PTB-XL was not found automatically. Put the extracted dataset in \"\n",
    "            \"~/Downloads/PTBXL, or set PTBXL_ROOT to the extracted dataset root, \"\n",
    "            \"or set PTBXL_ZIP to the official PTB-XL v1.0.3 zip file.\"\n",
    "        )\n",
    "\n",
    "    extract_dir = Path(extract_dir).expanduser()\n",
    "    extract_dir.mkdir(parents=True, exist_ok=True)\n",
    "    print(f\"Extracting {Path(zip_path).name} -> {extract_dir}\")\n",
    "\n",
    "    try:\n",
    "        with zipfile.ZipFile(zip_path, \"r\") as zf:\n",
    "            zf.extractall(extract_dir)\n",
    "    except zipfile.BadZipFile as exc:\n",
    "        raise zipfile.BadZipFile(\n",
    "            f\"The PTB-XL zip appears corrupted or incomplete: {zip_path}\"\n",
    "        ) from exc\n",
    "\n",
    "    root = find_dataset_root(extract_dir)\n",
    "    if root is None:\n",
    "        matches = list(extract_dir.rglob(\"ptbxl_database.csv\"))\n",
    "        if matches:\n",
    "            root = matches[0].parent.resolve()\n",
    "\n",
    "    if root is None:\n",
    "        raise FileNotFoundError(\n",
    "            \"Extraction completed, but ptbxl_database.csv was not found in the archive.\"\n",
    "        )\n",
    "    return root\n",
    "\n",
    "\n",
    "_existing_root = locate_existing_dataset()\n",
    "DATASET_ZIP = locate_dataset_zip()\n",
    "\n",
    "if _existing_root is not None:\n",
    "    dataset_root = _existing_root\n",
    "    DATASET_DIR = dataset_root.parent\n",
    "    print(\"Using existing PTB-XL dataset:\", dataset_root)\n",
    "else:\n",
    "    # Prefer Downloads/PTBXL as the extraction target when a zip is found.\n",
    "    DATASET_DIR = Path.home() / \"Downloads\" / \"PTBXL\"\n",
    "    dataset_root = extract_dataset_if_needed(DATASET_ZIP, DATASET_DIR)\n",
    "    print(\"Resolved dataset root:\", dataset_root)\n",
    "\n",
    "print(\"Dataset zip:\", DATASET_ZIP if DATASET_ZIP is not None else \"not needed\")\n"
   ]
