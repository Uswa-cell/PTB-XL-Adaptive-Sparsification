    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "\n",
    "def ecg_difficulty_features(signal: torch.Tensor) -> torch.Tensor:\n",
    "    \"\"\"\n",
    "    signal: (B, leads, T) raw ECG tensor.\n",
    "    Returns (B, 3*leads) with:\n",
    "      1) amplitude standard deviation,\n",
    "      2) mean absolute sample-to-sample change,\n",
    "      3) peak-to-peak amplitude.\n",
    "    \"\"\"\n",
    "    std = signal.std(dim=-1)\n",
    "    diff = signal[..., 1:] - signal[..., :-1]\n",
    "    mad = diff.abs().mean(dim=-1)\n",
    "    ptp = signal.amax(dim=-1) - signal.amin(dim=-1)\n",
    "    return torch.cat([std, mad, ptp], dim=-1)\n",
    "\n",
    "\n",
    "class HeuristicDifficultyGate(nn.Module):\n",
    "    \"\"\"\n",
    "    Zero-parameter ablation difficulty estimator.\n",
    "    Every ECG is scored independently; no batch min/max normalization.\n",
    "    \"\"\"\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "    def forward(self, signal: torch.Tensor) -> torch.Tensor:\n",
    "        feats = ecg_difficulty_features(signal)\n",
    "        raw = feats.mean(dim=-1)\n",
    "        difficulty = raw / (raw + 1.0)\n",
    "        return torch.clamp(difficulty, 0.0, 1.0)\n",
    "\n",
    "\n",
    "class DifficultyEstimator(nn.Module):\n",
    "    \"\"\"\n",
    "    Learned sample-independent ECG difficulty estimator.\n",
    "    Output: one difficulty score in [0, 1] for every ECG.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, in_leads: int = 12, hidden: int = 32):\n",
    "        super().__init__()\n",
    "        in_features = 3 * in_leads\n",
    "        self.norm = nn.LayerNorm(in_features)\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(in_features, hidden),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Linear(hidden, hidden // 2),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Linear(hidden // 2, 1),\n",
    "        )\n",
    "\n",
    "    def forward(self, signal: torch.Tensor) -> torch.Tensor:\n",
    "        feats = ecg_difficulty_features(signal)\n",
    "        feats = self.norm(feats)\n",
    "        raw = self.net(feats).squeeze(-1)\n",
    "        return torch.sigmoid(raw)\n",
    "\n",
    "    def param_fraction_of(self, backbone: nn.Module) -> float:\n",
    "        own = sum(p.numel() for p in self.parameters())\n",
    "        other = sum(p.numel() for p in backbone.parameters())\n",
    "        return own / max(other, 1)\n"
   ]
  },
