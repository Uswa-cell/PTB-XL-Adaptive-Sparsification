   "source": [
    "# ---- from src/data/pipeline.py ----\n",
    "\n",
    "\"\"\"\n",
    "src/data/pipeline.py\n",
    "------------------------\n",
    "End-to-end data preparation: load metadata, clean it, build multilabel\n",
    "targets, split by PTB-XL's official `strat_fold` column (a patient-\n",
    "stratified 10-fold split shipped with the dataset -- this is the standard,\n",
    "reproducible split used throughout the PTB-XL benchmark literature, and is\n",
    "preferred over re-deriving an ad hoc patient split because it makes results\n",
    "directly comparable to published PTB-XL baselines), and construct\n",
    "Dataset/DataLoader objects (with the balanced sampler on the training\n",
    "split only).\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from torch.utils.data import DataLoader\n",
    "\n",
    "\n",
    "\n",
    "def load_and_clean_metadata(database_csv: str, scp_csv: str, superclasses: list[str],\n",
    "                             min_likelihood: float = 0) -> tuple[pd.DataFrame, dict]:\n",
    "    df = pd.read_csv(database_csv, index_col=\"ecg_id\")\n",
    "    scp_df = pd.read_csv(scp_csv, index_col=0)\n",
    "\n",
    "    # --- missing-value handling ---\n",
    "    # `age`/`height`/`weight` occasionally missing -- impute age with the\n",
    "    # cohort median (a defensible, literature-standard choice for a\n",
    "    # demographic covariate that is NOT used as a model input, only for EDA)\n",
    "    if \"age\" in df.columns:\n",
    "        df[\"age\"] = df[\"age\"].fillna(df[\"age\"].median())\n",
    "\n",
    "    # drop rows with a missing/invalid waveform filename (corrupted metadata row)\n",
    "    df = df.dropna(subset=[\"filename_hr\", \"filename_lr\"])\n",
    "\n",
    "    # drop exact duplicate rows\n",
    "    before = len(df)\n",
    "    df = df.drop_duplicates()\n",
    "    n_dupes = before - len(df)\n",
    "\n",
    "    diagnostic_mapping = build_diagnostic_mapping(scp_df)\n",
    "    df = add_multilabel_columns(df, diagnostic_mapping, superclasses, min_likelihood)\n",
    "\n",
    "    report = {\n",
    "        \"n_records_after_cleaning\": len(df),\n",
    "        \"n_duplicates_removed\": n_dupes,\n",
    "        \"n_missing_diagnostic_dropped\": before - n_dupes - len(df),\n",
    "    }\n",
    "    return df, report\n",
    "\n",
    "\n",
    "def split_by_official_fold(df: pd.DataFrame, val_fold: int = 9, test_fold: int = 10):\n",
    "    train_df = df[~df[\"strat_fold\"].isin([val_fold, test_fold])].copy()\n",
    "    val_df = df[df[\"strat_fold\"] == val_fold].copy()\n",
    "    test_df = df[df[\"strat_fold\"] == test_fold].copy()\n",
    "    return train_df, val_df, test_df\n",
    "\n",
    "\n",
    "def build_datasets(train_df, val_df, test_df, root_path, superclasses, sampling_rate_hz,\n",
    "                    preprocessing_cfg, augmentation_cfg, seed=42):\n",
    "    train_ds = PTBXLDataset(train_df, root_path, superclasses, sampling_rate_hz,\n",
    "                             preprocessing_cfg, augmentation_cfg, train=True, seed=seed)\n",
    "    val_ds = PTBXLDataset(val_df, root_path, superclasses, sampling_rate_hz,\n",
    "                           preprocessing_cfg, augmentation_cfg=None, train=False, seed=seed)\n",
    "    test_ds = PTBXLDataset(test_df, root_path, superclasses, sampling_rate_hz,\n",
    "                            preprocessing_cfg, augmentation_cfg=None, train=False, seed=seed)\n",
    "    return train_ds, val_ds, test_ds\n",
    "\n",
    "\n",
    "def build_dataloaders(train_ds, val_ds, test_ds, batch_size, num_workers, use_balanced_sampler=True):\n",
    "    # INFRASTRUCTURE CHANGE: pin_memory=True + persistent_workers=True for the\n",
    "    # local RTX 5080 machine. Pinned host memory makes the host->GPU copy\n",
    "    # (used with non_blocking=True in the Trainer) faster; persistent_workers\n",
    "    # avoids re-spawning worker processes every epoch. persistent_workers is\n",
    "    # only valid when num_workers > 0, hence the guard below.\n",
    "    persistent = num_workers > 0\n",
    "    if use_balanced_sampler:\n",
    "        label_matrix = np.stack(train_ds.df[\"label_vector\"].values)\n",
    "        sampler = build_balanced_sampler(label_matrix)\n",
    "        train_loader = DataLoader(train_ds, batch_size=batch_size, sampler=sampler,\n",
    "                                   num_workers=num_workers, pin_memory=True,\n",
    "                                   persistent_workers=persistent)\n",
    "    else:\n",
    "        train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True,\n",
    "                                   num_workers=num_workers, pin_memory=True,\n",
    "                                   persistent_workers=persistent)\n",
    "\n",
    "    val_loader = DataLoader(val_ds, batch_size=batch_size, shuffle=False,\n",
    "                             num_workers=num_workers, pin_memory=True,\n",
    "                             persistent_workers=persistent)\n",
    "    test_loader = DataLoader(test_ds, batch_size=batch_size, shuffle=False,\n",
    "                              num_workers=num_workers, pin_memory=True,\n",
    "                              persistent_workers=persistent)\n",
    "    return train_loader, val_loader, test_loader\n"
   ]
